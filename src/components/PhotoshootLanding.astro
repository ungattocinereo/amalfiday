---
import BaseLayout from '../layouts/BaseLayout.astro'
import PhotoshootCard from './PhotoshootCard.astro'
import PhotoshootPricing from './PhotoshootPricing.astro'
import PhotoRequestDialog from './PhotoRequestDialog.astro'
import { site } from '../data/site'
import { photography, photographerSchema, photographyPackages, describePhotographyPackage } from '../data/photographer'
import {
  businessId,
  getLandingPage,
  landingCard,
  landingGroups,
  landingHero,
  landingPath,
  landingUrl,
  travelNote,
  travelZones,
  type LandingSlug,
} from '../data/photoshoot-landings'

interface Props { slug: LandingSlug }

const page = getLandingPage(Astro.props.slug)
const url = landingUrl(page.slug)
const hero = landingHero(page)
const cards = page.shoots.slugs.map(landingCard)
const columns = page.shoots.columns || 3
const pricingPackages = page.pricing ? Object.values(photographyPackages).filter(pkg => pkg.session === page.pricing) : []
const related = page.related.map(getLandingPage)
const whatsappHref = 'https://wa.me/393270972329'
const requestHref = '/contact/?service=Photoshooting'
const h1 = `${page.hero.lead} ${page.hero.accent}`

const jsonLd = [
  photographerSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#service`,
    name: page.service.name,
    serviceType: page.service.serviceType,
    description: page.answer.paragraphs.join(' '),
    url,
    image: new URL(hero.src, site.url).toString(),
    provider: { '@id': businessId },
    brand: { '@type': 'Brand', name: 'Amalfi.Day', url: site.url },
    areaServed: page.service.areaServed.map(name => ({ '@type': 'Place', name, containedInPlace: { '@type': 'Place', name: 'Amalfi Coast, Italy' } })),
    isRelatedTo: { '@id': photography.serviceId },
    ...(page.service.packages.length ? {
      offers: page.service.packages.map(key => {
        const pkg = photographyPackages[key]
        return {
          '@type': 'Offer',
          name: pkg.name,
          description: `${describePhotographyPackage(pkg)} ${page.service.priceNote}`,
          price: pkg.price,
          priceCurrency: 'EUR',
          url: `${photography.url}#${pkg.id}`,
        }
      }),
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: page.faqs.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    name: page.title,
    description: page.description,
    url,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${url}#service` },
    primaryImageOfPage: new URL(hero.src, site.url).toString(),
    mainEntity: {
      '@type': 'ItemList',
      name: `${page.shoots.title} ${page.shoots.accent}`,
      itemListElement: cards.map((card, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(card.href, site.url).toString(),
        name: card.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Photoshoots', item: photography.url },
      { '@type': 'ListItem', position: 3, name: h1, item: url },
    ],
  },
]
---

<BaseLayout title={page.title} description={page.description} url={url} image={hero.src} imageAlt={hero.alt} jsonLd={jsonLd}>
  <section class="lp-hero hero--dark" style={`--hero-focal:${hero.focal};--hero-mobile-focal:${hero.mobileFocal}`}>
    <img class="lp-hero__image" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" loading="eager" />
    <div class="lp-hero__vignette hero-shade" aria-hidden="true"></div>
    <div class="lp-hero__content hero-content">
      <div class="container hero-container">
        <span class="lp-hero__eyebrow">{page.hero.eyebrow}</span>
        <h1 class="lp-hero__title">{page.hero.lead}<br /><span class="lp-hero__title-accent">{page.hero.accent}</span></h1>
        <p class="lp-hero__lead">{page.hero.intro}</p>
        <div class="lp-hero__actions">
          <a class="lp-btn lp-btn--primary" href={requestHref} data-request aria-haspopup="dialog" aria-controls="gs-request">Request a photoshoot</a>
          <a class="lp-btn lp-btn--ghost" href="#stories">See the stories</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section lp-answer" aria-labelledby="lp-answer-title">
    <div class="container">
      <nav class="lp-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/photoshootings/">Photoshoots</a></li>
          <li aria-current="page">{h1}</li>
        </ol>
      </nav>
      <div class="lp-answer__grid">
        <div class="lp-answer__copy">
          <span class="pricing__eyebrow">The short answer</span>
          <h2 id="lp-answer-title">{page.answer.title}</h2>
          {page.answer.paragraphs.map(text => <p>{text}</p>)}
        </div>
        <aside class="lp-facts" aria-label="At a glance">
          <h3><i class="ph ph-camera" aria-hidden="true"></i> At a glance</h3>
          <dl>
            {page.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  {page.sections.map((section, index) => (
    <section class:list={['section', 'lp-section', { 'lp-section--alt': index % 2 === 0 }]} id={section.id} aria-labelledby={`lp-section-${index}`}>
      <div class="container">
        <div class="cat-header">
          <span class="pricing__eyebrow">{section.eyebrow}</span>
          <h2 id={`lp-section-${index}`}>{section.title} <span class="accent-italic">{section.accent}</span></h2>
        </div>
        {section.paragraphs && <div class="lp-prose">{section.paragraphs.map(html => <p set:html={html} />)}</div>}
        {section.cards && (
          <div class="lp-cards">
            {section.cards.map(card => (
              <article class="included-card">
                <div class="included-card__icon"><i class={`ph ${card.icon}`} aria-hidden="true"></i></div>
                <h3 class="included-card__name">{card.title}</h3>
                <p class="included-card__desc">{card.text}</p>
              </article>
            ))}
          </div>
        )}
        {section.steps && (
          <ol class="lp-steps">
            {section.steps.map((step, stepIndex) => (
              <li class="lp-step">
                <span class="lp-step__number" aria-hidden="true">0{stepIndex + 1}</span>
                <div><h3>{step.title}</h3><p>{step.text}</p></div>
              </li>
            ))}
          </ol>
        )}
        {section.list && <ul class="lp-list">{section.list.map(html => <li set:html={html} />)}</ul>}
      </div>
    </section>
  ))}

  <section class="section lp-stories" id="stories" aria-labelledby="lp-stories-title">
    <div class="container">
      <div class="cat-header">
        <span class="pricing__eyebrow">{page.shoots.eyebrow}</span>
        <h2 id="lp-stories-title">{page.shoots.title} <span class="accent-italic">{page.shoots.accent}</span></h2>
        <p class="cat-header__desc">{page.shoots.desc}</p>
      </div>
      <div class={`shoot-grid shoot-grid--${columns}`}>
        {cards.map(item => <PhotoshootCard item={item} wide={columns < 4} />)}
      </div>
    </div>
  </section>

  {page.pricing && (
    <section class="section pricing pricing--alt" id="pricing" aria-labelledby="lp-pricing-title">
      <div class="container">
        <div class="cat-header cat-header--center">
          <span class="pricing__eyebrow">Transparent pricing</span>
          <h2 id="lp-pricing-title">{page.pricing === 'solo' ? 'Solo' : 'Couple'} <span class="accent-italic">packages</span></h2>
          {page.pricingNote && <p class="cat-header__desc">{page.pricingNote}</p>}
        </div>
        <PhotoshootPricing packages={pricingPackages} />
      </div>
    </section>
  )}

  <section class="section lp-travel" id="travel-fees" aria-labelledby="lp-travel-title">
    <div class="container">
      <div class="cat-header">
        <span class="pricing__eyebrow">Travel zones</span>
        <h2 id="lp-travel-title">Travel <span class="accent-italic">fees</span></h2>
        <p class="cat-header__desc">Base zone (Atrani &amp; Amalfi) is included in every package. For sessions in other towns, a small travel fee applies. Full prices, add-ons and policies are on the <a href="/photoshootings/#pricing">photoshoots page</a>.</p>
      </div>
      <div class="travel-table-wrap">
        <table class="travel-table">
          <thead><tr><th>Zone</th><th>Towns</th><th>Travel fee</th></tr></thead>
          <tbody>
            {travelZones.map(zone => (
              <tr>
                <td><span class={`travel-zone travel-zone--${zone.level}`}>{zone.zone}</span></td>
                <td>{zone.towns}</td>
                <td class="travel-fee">{zone.fee}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lp-travel__note">{travelNote}</p>
    </div>
  </section>

  <section class="section photography-faq lp-faq" id="faq" aria-labelledby="lp-faq-title">
    <div class="container photography-faq__inner">
      <div class="cat-header">
        <span class="pricing__eyebrow">Questions people ask</span>
        <h2 id="lp-faq-title">Frequently asked <span class="accent-italic">questions</span></h2>
      </div>
      {page.faqs.map(faq => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section lp-related" aria-labelledby="lp-related-title">
    <div class="container">
      <div class="cat-header">
        <span class="pricing__eyebrow">Keep planning</span>
        <h2 id="lp-related-title">More ways to <span class="accent-italic">find your shoot</span></h2>
      </div>
      <div class="lp-links">
        {related.map(item => (
          <a class="lp-link" href={landingPath(item.slug)}>
            <span class="lp-link__icon"><i class={`ph ${item.nav.icon}`} aria-hidden="true"></i></span>
            <span class="lp-link__body"><span class="lp-link__group">{item.group === 'location' ? 'By location' : 'By occasion'}</span><span class="lp-link__name">{item.nav.label}</span><span class="lp-link__desc">{item.nav.desc}</span></span>
            <i class="ph ph-arrow-right lp-link__arrow" aria-hidden="true"></i>
          </a>
        ))}
        <a class="lp-link lp-link--hub" href="/photoshootings/">
          <span class="lp-link__icon"><i class="ph ph-camera" aria-hidden="true"></i></span>
          <span class="lp-link__body"><span class="lp-link__group">Everything</span><span class="lp-link__name">All photoshoots</span><span class="lp-link__desc">Every story, package and policy</span></span>
          <i class="ph ph-arrow-right lp-link__arrow" aria-hidden="true"></i>
        </a>
      </div>
      <p class="lp-related__all">
        {landingGroups.map(group => <>
          <span class="lp-related__label">{group.label}:</span>
          {group.pages.map((item, index) => <>{index > 0 && ' · '}{item.slug === page.slug ? <span aria-current="page">{item.nav.label}</span> : <a href={landingPath(item.slug)}>{item.nav.label}</a>}</>)}
          {' '}
        </>)}
      </p>
    </div>
  </section>

  <section class="section pricing-cta">
    <div class="container">
      <div class="pricing-cta__inner">
        <span class="pricing-cta__tag">Ready to book?</span>
        <h2 class="pricing-cta__title">Tell me your dates and what you imagine.<br />I’ll take care of the light and the places.</h2>
        <p class="pricing-cta__lead">A personal reply, no commitment or payment.<br />Languages: English, Italian, Russian.</p>
        <div class="pricing-cta__actions">
          <a class="gs-button gs-request-trigger" href={requestHref} data-request aria-haspopup="dialog" aria-controls="gs-request"><span class="gs-request-trigger__label">Request a photoshoot</span><span class="gs-request-trigger__icon" aria-hidden="true"><i class="ph ph-arrow-right" aria-hidden="true"></i><i class="ph ph-camera" aria-hidden="true"></i></span></a>
          <a class="lp-btn lp-btn--whatsapp" href={whatsappHref} target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i> WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <PhotoRequestDialog />
</BaseLayout>

<style>
  /* Hero: the hub's cinematic hero with a single still photograph. */
  .lp-hero {
    position: relative;
    min-height: 82vh;
    min-height: 82svh;
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-space) + 1.5rem);
    overflow: hidden;
    background: #0a0a0a;
    color: #ffffff;
  }

  .lp-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-focal);
  }

  .lp-hero__vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.5) 25%, rgba(0, 0, 0, 0.15) 50%, transparent 70%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 18%);
    pointer-events: none;
  }

  .lp-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: max(clamp(1.5rem, 4vh, 3rem), env(safe-area-inset-bottom));
  }

  .lp-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1rem;
  }

  .lp-hero__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
  }

  .lp-hero__title-accent {
    font-style: italic;
    color: #ffc300;
  }

  .lp-hero__lead {
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
    margin-top: 1.2rem;
  }

  .lp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .lp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .lp-btn:hover { text-decoration: none; transform: translateY(-1px); }
  .lp-btn--primary { background: #ff5900; color: #ffffff; }
  .lp-btn--primary:hover { background: #ff7a33; color: #ffffff; box-shadow: 0 8px 30px rgba(255, 89, 0, 0.35); }
  .lp-btn--ghost { background: rgba(255, 255, 255, 0.14); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25); }
  .lp-btn--ghost:hover { background: rgba(255, 255, 255, 0.22); border-color: rgba(255, 255, 255, 0.45); color: #ffffff; }
  .lp-btn--whatsapp { background: rgba(37, 211, 102, 0.15); color: #25d366; border: 1px solid rgba(37, 211, 102, 0.3); }
  .lp-btn--whatsapp:hover { background: rgba(37, 211, 102, 0.25); border-color: rgba(37, 211, 102, 0.5); color: #25d366; }

  .lp-btn:focus-visible,
  .lp-link:focus-visible,
  .lp-faq summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  /* Shared hub vocabulary */
  .pricing__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .cat-header { margin-bottom: 2.5rem; }
  .cat-header h2 { font-size: clamp(2rem, 4vw, 3.2rem); margin-bottom: 0.8rem; }
  .cat-header__desc { max-width: 640px; font-size: 1.05rem; line-height: 1.75; color: var(--color-text-muted); }
  .cat-header__desc a { text-decoration: underline; text-underline-offset: 3px; }
  .cat-header--center { text-align: center; }
  .cat-header--center .cat-header__desc { margin-inline: auto; }

  .pricing--alt,
  .lp-section--alt,
  .lp-travel,
  .pricing-cta { background: var(--color-surface); }

  section[id] { scroll-margin-top: 6rem; }

  /* Short answer */
  .lp-answer { padding-top: 2.5rem; }

  .lp-breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .lp-breadcrumb li + li::before { content: '/'; margin-right: 0.4rem; opacity: 0.5; }
  .lp-breadcrumb a { color: inherit; }
  .lp-breadcrumb [aria-current] { color: var(--color-text); }

  .lp-answer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .lp-answer h2 { font-size: clamp(1.8rem, 3.2vw, 2.6rem); line-height: 1.2; margin: 0 0 1.25rem; }
  .lp-answer__copy p { font-size: 1.08rem; line-height: 1.8; color: var(--color-text-muted); }
  .lp-answer__copy p:first-of-type { color: var(--color-text); }

  .lp-facts {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.6rem;
  }

  .lp-facts h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  .lp-facts h3 i { color: var(--color-accent); }
  .lp-facts dl { margin: 0; display: grid; gap: 0; }
  .lp-facts dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-top: 1px solid var(--color-border); }
  .lp-facts dt { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); padding-top: 0.15rem; }
  .lp-facts dd { margin: 0; font-size: 0.9rem; font-weight: 600; text-align: right; color: var(--color-text); }

  /* Content sections */
  .lp-prose { max-width: 760px; }
  .lp-prose p { font-size: 1.02rem; line-height: 1.8; color: var(--color-text-muted); }
  .lp-prose p :global(strong) { color: var(--color-text); }
  .lp-prose + .lp-list { margin-top: 1.5rem; }

  .lp-prose :global(a),
  .lp-list :global(a),
  .lp-related__all a { text-decoration: underline; text-underline-offset: 3px; }

  .lp-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .included-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.8rem 1.5rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .included-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }

  .included-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: rgba(255, 89, 0, 0.08);
    color: var(--color-accent);
    font-size: 1.3rem;
  }

  .included-card__name { font-family: var(--font-display); font-size: 1rem; color: var(--color-text); margin: 0 0 0.5rem; }
  .included-card__desc { font-size: 0.88rem; color: var(--color-text-muted); margin: 0; line-height: 1.65; }

  .lp-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    max-width: 860px;
  }

  .lp-step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.3rem 1.5rem;
  }

  .lp-step__number { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.15em; color: var(--color-accent); padding-top: 0.2rem; }
  .lp-step h3 { font-family: var(--font-display); font-size: 1rem; margin: 0 0 0.35rem; }
  .lp-step p { margin: 0; font-size: 0.92rem; line-height: 1.7; color: var(--color-text-muted); }

  .lp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
    max-width: 860px;
  }

  .lp-list li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .lp-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .lp-list li :global(strong) { color: var(--color-text); }

  /* Story grid (same rhythm as the hub) */
  .shoot-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .shoot-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shoot-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  @media (max-width: 1024px) {
    .shoot-grid,
    .shoot-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .shoot-grid,
