---
// Mobile menu (below 1100px): the previous menu moved as is, reading the new
// navigation data. To be replaced by the mobile redesign.
import { navCta, navigation, navSections, site, socialLinks, type NavigationItem } from '../../data/site'

interface Props {
  currentPath: string
}
const { currentPath } = Astro.props
const headerSocials = socialLinks.filter((item) => ['Instagram', 'Facebook'].includes(item.label))
const normalize = (href?: string) => (href ? href.split('#')[0].replace(/\/$/, '') || '/' : href)
const isCurrent = (href?: string) => Boolean(href) && !href!.includes('#') && normalize(href) === currentPath
const isWithin = (href?: string) => {
  const path = normalize(href)
  return Boolean(path) && path !== '/' && (currentPath === path || currentPath.startsWith(`${path}/`))
}
const isActive = (item: NavigationItem) =>
  isWithin(item.href) || navSections(item).some((section) => section.items.some((link) => isWithin(link.href)))
---

<button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
  <span class="menu-toggle__label" aria-hidden="true">MENU</span>
</button>

<dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation">
  <div class="mobile-menu__bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
      <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
    </a>
    <button class="menu-close" type="button" aria-label="Close menu" autofocus>CLOSE</button>
    <button class="theme-switch" type="button" role="switch" data-theme-toggle aria-label="Dark mode" aria-checked="false" title="Switch to dark theme">
      <span class="theme-switch__track" aria-hidden="true">
        <span class="theme-switch__thumb"></span>
        <i class="ph ph-sun theme-switch__sun" aria-hidden="true"></i>
        <i class="ph ph-moon theme-switch__moon" aria-hidden="true"></i>
      </span>
    </button>
  </div>
  <div class="mobile-menu__body">
    <div class="mobile-menu__intro"><span class="eyebrow">Amalfi coast, your way</span><span class="mobile-menu__title">A little closer to paradise.</span></div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a class="mobile-nav__link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="nav-number" aria-hidden="true">01</span><span>Home</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      {navigation.map((item, index) => item.panel ? (
        <details class="mobile-disclosure">
          <summary class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}{item.badge && <span class="mobile-badge">{item.badge}</span>}</span><i class="ph ph-plus" aria-hidden="true"></i></summary>
          <div class="mobile-subnav">
            <a class="overview" href={item.href}><span>Discover all {item.label.toLowerCase()}</span> <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            {navSections(item).map((section) => (
              <div class="nav-section">
                <span class="eyebrow">{section.heading}</span>
                {section.items.map((link) => <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><i class={`ph ${link.icon ?? 'ph-dot-outline'}`} aria-hidden="true"></i><span>{link.label}</span></a>)}
              </div>
            ))}
          </div>
        </details>
      ) : (
        <a class="mobile-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      ))}
    </nav>
    <div class="mobile-connect">
      <a class="mobile-contact" href={navCta.href}><span>Let’s plan your day</span><span>{navCta.label} <i class={`ph-fill ${navCta.icon}`} aria-hidden="true"></i></span></a>
      <div class="mobile-socials">
        {headerSocials.map((item) => <a href={item.href} target="_blank" rel="noreferrer"><i class={`ph-light ph-${item.label.toLowerCase()}-logo`} aria-hidden="true"></i>{item.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
      </div>
    </div>
  </div>
</dialog>

<script>
  import { initMobileNav } from '../../scripts/nav/mobile-nav.mjs'
  const header = document.getElementById('header')
  if (header) initMobileNav(header)
</script>

<style>
  .mobile-menu {
    --glass-solid: #ffffff;
    --glass-line: rgba(20, 20, 20, 0.12);
    --glass-ink: #141414;
    --glass-muted: #626262;
    --glass-hover: rgba(255, 89, 0, 0.09);
    --glass-accent: #FF5900;
    --day-logo: block;
    --night-logo: none;
  }
  :global([data-theme='night']) .mobile-menu {
    --glass-solid: #111417;
    --glass-line: rgba(255, 255, 255, 0.15);
    --glass-ink: #ffffff;
    --glass-muted: #b8b8b8;
    --glass-hover: rgba(255, 89, 0, 0.13);
    --day-logo: none;
    --night-logo: block;
  }
  .mobile-menu a:hover { text-decoration: none; }
  .mobile-menu :is(a, button, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 3px; }
  .brand { position: relative; display: inline-flex; align-items: center; justify-self: start; width: 112px; min-width: 0; height: 44px; max-width: 100%; color: var(--glass-ink); }
  .brand img { width: 100%; height: auto; }
  .brand__day { display: var(--day-logo); }
  .brand__night { display: var(--night-logo); }
  .eyebrow { display: block; font-family: var(--font-mono); font-size: 10px; line-height: 1.6; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--glass-muted); }
  .overview { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--glass-ink); font-size: 13px; font-weight: 500; }
  .overview > span { text-decoration: underline; text-decoration-color: var(--glass-accent); text-underline-offset: 6px; }
  .overview:hover { color: var(--glass-ink); }
  .overview i { font-size: 10px; color: var(--glass-accent); }
  .nav-section + .nav-section { margin-top: 16px; }
  .nav-section > .eyebrow { padding: 0 10px 5px; }
  .sub-link { display: flex; align-items: center; gap: 12px; min-height: 46px; padding: 10px; color: var(--glass-ink); font-size: 14px; line-height: 1.4; border-radius: 3px; transition: background 160ms ease; }
  .sub-link i { width: 18px; flex-shrink: 0; color: var(--glass-muted); text-align: center; font-size: 14px; }
  .sub-link:hover, .sub-link[aria-current='page'] { background: var(--glass-hover); color: var(--glass-ink); }
  .sub-link:hover i, .sub-link[aria-current='page'] i { color: var(--glass-accent); }
  .mobile-badge { margin-left: 10px; padding: 3px 7px; border-radius: 999px; background: var(--glass-accent); color: #fff; font: 600 11px/1 var(--font-mono); vertical-align: middle; }

  .menu-toggle, .menu-close { display: flex; align-items: center; justify-content: center; justify-self: center; position: relative; height: 44px; padding: 0 10px; background: transparent; border: 0; border-radius: 24px; font: 500 11px/1 var(--font-body); letter-spacing: 0.16em; cursor: pointer; transition: background 180ms ease, color 180ms ease, transform 180ms ease; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .menu-toggle { display: none; width: 64px; color: var(--bar-ink); }
  .menu-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .menu-close { width: 84px; font-size: 10px; color: var(--glass-ink); }
  .menu-toggle__label { display: block; padding-left: 0.16em; white-space: nowrap; }
  .menu-toggle::after { content: ''; position: absolute; bottom: 10px; inset-inline: 15px; height: 1px; background: currentColor; opacity: 0; transform: scaleX(0.5); transition: opacity 180ms ease, transform 180ms ease; }
  .menu-toggle:active, .menu-close:active { transform: scale(0.96); background: color-mix(in srgb, currentColor 8%, transparent); }

  .theme-switch { position: relative; display: inline-flex; align-items: center; justify-content: center; justify-self: end; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 999px; background: transparent; color: var(--glass-ink); cursor: pointer; }
  .theme-switch__track { flex-shrink: 0; position: relative; display: block; width: 44px; height: 24px; border-radius: 999px; background: color-mix(in srgb, currentColor 6%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 22%, transparent); transition: background 240ms ease, box-shadow 240ms ease; }
  .theme-switch__thumb { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: color-mix(in srgb, currentColor 88%, transparent); transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), background 240ms ease; }
  .theme-switch__track > i { position: absolute; top: 2px; display: grid; place-items: center; width: 20px; height: 20px; font-size: 14px; transition: color 240ms ease, opacity 240ms ease; }
  .theme-switch__sun { left: 2px; color: var(--glass-solid); }
  .theme-switch__moon { right: 2px; opacity: 0.55; }
  :global([data-theme='night']) .theme-switch__thumb { transform: translateX(20px); }
  :global([data-theme='night']) .theme-switch__sun { color: inherit; opacity: 0.55; }
  :global([data-theme='night']) .theme-switch__moon { color: var(--glass-solid); opacity: 1; }
  .theme-switch:active .theme-switch__thumb { scale: 0.9; }

  .mobile-menu { position: fixed; inset: 0; width: 100%; max-width: 640px; height: 100%; height: 100dvh; max-height: none; margin: 0 auto; padding: 0; border: 0; border-radius: 28px; color: var(--glass-ink); background: color-mix(in srgb, var(--glass-solid) 94%, transparent); -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px); overflow: clip; opacity: 0; transform: translateY(-20px) scale(0.985); transform-origin: 50% 0; transition: opacity 260ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1), border-radius 420ms ease, background 240ms ease, color 240ms ease; }
  .mobile-menu[open] { display: flex; flex-direction: column; }
  .mobile-menu.is-visible { opacity: 1; transform: none; border-radius: 0; }
  .mobile-menu.is-closing { transition-duration: 240ms; }
  .mobile-menu::backdrop { background: rgba(12, 20, 25, 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); transition: background 300ms ease, backdrop-filter 360ms ease, -webkit-backdrop-filter 360ms ease; }
  .mobile-menu.is-visible::backdrop { background: rgba(12, 20, 25, 0.34); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .mobile-menu.is-closing::backdrop { transition-duration: 240ms; }
  .mobile-menu__bar { position: sticky; top: 0; z-index: 1; background: transparent; flex-shrink: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: center; min-height: 72px; padding: 14px max(24px, env(safe-area-inset-right)) 14px max(24px, env(safe-area-inset-left)); padding-top: max(14px, env(safe-area-inset-top)); transition: background 240ms ease, color 240ms ease; }
  .mobile-menu__body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 28px max(24px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left)); display: flex; flex-direction: column; flex: 1; }
  .mobile-menu__body > * { flex-shrink: 0; }
  .mobile-menu__intro, .mobile-menu .mobile-nav > *, .mobile-connect { opacity: 0; transform: translateY(14px); transition: opacity 280ms ease, transform 380ms cubic-bezier(0.22, 1, 0.36, 1), background 160ms ease; }
  .mobile-menu.is-visible :is(.mobile-menu__intro, .mobile-nav > *, .mobile-connect) { opacity: 1; transform: none; }
  .mobile-menu.is-visible .mobile-menu__intro { transition-delay: 70ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(1) { transition-delay: 100ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(2) { transition-delay: 130ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(3) { transition-delay: 160ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(4) { transition-delay: 190ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(5) { transition-delay: 210ms; }
  .mobile-menu.is-visible .mobile-nav > :nth-child(6) { transition-delay: 230ms; }
  .mobile-menu.is-visible .mobile-connect { transition-delay: 250ms; }
  .mobile-menu.is-closing :is(.mobile-menu__intro, .mobile-nav > *, .mobile-connect) { transition-duration: 160ms; transition-delay: 0ms; }
  .mobile-menu__intro { margin-bottom: 24px; }
  .mobile-menu__title { display: block; margin-top: 9px; font-family: var(--font-display); font-style: italic; font-size: 17px; line-height: 1.6; }
  .mobile-nav { border-top: 1px solid var(--glass-line); }
  .mobile-nav > * { border-bottom: 1px solid var(--glass-line); }
  .mobile-nav__link { display: grid; grid-template-columns: 24px 1fr 20px; align-items: center; gap: 12px; min-height: 72px; color: var(--glass-ink); font-family: var(--font-display); font-size: 23px; cursor: pointer; transition: background 160ms ease; }
  .mobile-nav__link.is-active, .mobile-nav__link[aria-current='page'] { box-shadow: inset 2px 0 var(--glass-accent); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-number { padding-left: 5px; font: 10px var(--font-mono); color: var(--glass-muted); }
  .mobile-nav__link > i { justify-self: end; font-size: 13px; transition: transform 180ms ease; }
  .mobile-disclosure[open] > summary > i { transform: rotate(45deg); color: var(--glass-accent); }
  .mobile-subnav { padding: 0 0 20px 26px; }
  .mobile-subnav > .overview { margin: 0 10px 14px; }
  .mobile-connect { margin-top: auto; padding-top: 30px; }
  .mobile-contact { display: flex; flex-direction: column; gap: 8px; padding: 20px 0; border: 0; background: transparent; color: var(--glass-ink); transition: color 180ms ease; }
  .mobile-contact > span:first-child { font: 10px var(--font-mono); }
  .mobile-contact > span:last-child { display: flex; justify-content: space-between; align-items: center; font-size: 18px; font-weight: 500; }
  .mobile-contact i { font-size: 22px; }
  .mobile-contact:hover { color: var(--glass-accent); }
  .mobile-socials { display: flex; justify-content: center; gap: 28px; margin-top: 14px; }
  .mobile-socials a { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; color: var(--glass-ink); font-size: 12px; }
  .mobile-socials i { font-size: 18px; }
  @media (hover: hover) {
    .menu-toggle:hover, .menu-close:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
    .menu-toggle:hover::after { opacity: 0.55; transform: scaleX(1); }
    .mobile-nav__link:hover { background: var(--glass-hover); color: var(--glass-ink); }
    .mobile-socials a:hover { text-decoration: underline; text-decoration-color: var(--glass-accent); text-underline-offset: 5px; }
    .theme-switch:hover .theme-switch__track { background: color-mix(in srgb, currentColor 12%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 38%, transparent); }
  }
  @media (max-width: 1099px) {
    .menu-toggle { display: flex; }
  }
  @media (max-width: 380px) {
    .mobile-menu__bar { gap: 8px; }
    .mobile-menu__body { padding-inline: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu *, .mobile-menu::backdrop, .menu-toggle { transition: none !important; animation: none !important; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .mobile-menu { background: var(--glass-solid); -webkit-backdrop-filter: none; backdrop-filter: none; }
    .mobile-menu.is-visible::backdrop { -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
