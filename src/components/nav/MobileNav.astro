---
// Mobile menu (below 1100px): bar buttons (−10% pill + MENU) and a full-screen glass sheet.
// Top: three photo cards that open in place. Then Coast guide as chips, News, and a
// sticky thumb-zone dock. Behaviour lives in src/scripts/nav/mobile-nav.mjs.
import { navCta, navigation, site, type NavigationItem, type NavRow } from '../../data/site'

interface Props {
  currentPath: string
}
const { currentPath } = Astro.props

const normalize = (href?: string) => (href ? href.split('#')[0].replace(/\/$/, '') || '/' : '')
const pageAttr = (href?: string) => (href && !href.includes('#') && normalize(href) === currentPath ? 'page' : undefined)
const isWithin = (href?: string) => {
  const path = normalize(href)
  return Boolean(path) && path !== '/' && (currentPath === path || currentPath.startsWith(`${path}/`))
}

const cardItems = navigation.filter((item) => item.panel && item.panel.layout !== 'guide')
const guide = navigation.find((item) => item.panel?.layout === 'guide')
const plain = navigation.filter((item) => !item.panel)
const apartments = navigation.find((item) => item.badge)

// Rows and links of a card, in reading order, each with its stagger index.
type Part =
  | { kind: 'lead'; i: number; href: string; label: string; icon: string; tag?: string }
  | { kind: 'rows'; i: number; heading?: string; rows: (NavRow & { i: number })[]; more?: { label: string; href: string; i: number } }
  | { kind: 'links'; i: number; heading: string; links: { label: string; href: string; i: number }[]; note?: { label: string; href: string; icon: string; i: number } }
const buildParts = (item: NavigationItem) => {
  const parts: Part[] = []
  let n = 0
  for (const block of item.panel!.blocks) {
    if (block.kind === 'featured') {
      if (block.href !== item.href) parts.push({ kind: 'lead', i: n++, href: block.href, label: block.cta, icon: block.ctaIcon, tag: block.sticker?.value })
    } else if (block.kind === 'rows') {
      const i = n++
      const rows = block.items.map((row) => ({ ...row, i: n++ }))
      parts.push({ kind: 'rows', i, heading: block.heading, rows, more: block.more && block.more.href !== item.href ? { ...block.more, i: n++ } : undefined })
    } else if (block.kind === 'cards') {
      const i = n++
      const rows = block.items.map((card) => ({ label: card.title, note: card.text, href: card.href, image: card.image, i: n++ }))
      parts.push({ kind: 'rows', i, rows, more: block.more && block.more.href !== item.href ? { ...block.more, i: n++ } : undefined })
    } else if (block.kind === 'links') {
      const i = n++
      const links = block.items.map((link) => ({ ...link, i: n++ }))
      parts.push({ kind: 'links', i, heading: block.heading, links, note: block.note ? { ...block.note, i: n++ } : undefined })
    }
  }
  return { parts, seeAll: n }
}
const cards = cardItems.map((item, index) => {
  const featured = item.panel!.blocks.find((block) => block.kind === 'featured')
  const tours = item.panel!.blocks.find((block) => block.kind === 'cards')
  const image = featured?.kind === 'featured' ? featured.image : tours?.kind === 'cards' ? tours.items[0]?.image : undefined
  const subtitle = featured?.kind === 'featured' ? featured.eyebrow : tours?.kind === 'cards' ? [...tours.items.slice(0, 2).map((card) => card.title), ...(tours.items.length > 2 ? [`+${tours.items.length - 2}`] : [])].join(' · ') : ''
  return { item, index, image, subtitle, ...buildParts(item), current: isWithin(item.href) }
})

// Coast guide as chips: the six that matter most, with short names.
const chipOrder: [string, string][] = [
  ['/ferry-timetables/', 'Ferries'],
  ['/timetables/', 'Buses'],
  ['/parking/', 'Parking'],
  ['/how-to-get/', 'How to get here'],
  ['/beaches/', 'Beaches'],
  ['/moto/', 'Moto'],
]
const guideLinks = (guide?.panel?.blocks ?? []).flatMap((block) =>
  block.kind === 'rows' || block.kind === 'links' ? block.items.map((link) => ({ href: link.href, icon: 'icon' in link ? link.icon : undefined })) : [])
const chips = chipOrder
  .map(([href, label]) => ({ href, label, icon: guideLinks.find((link) => link.href === href)?.icon }))
  .filter((chip) => guideLinks.some((link) => link.href === chip.href))

const guideStart = cards.length
const newsStart = guideStart + 1 + chips.length

// WhatsApp number: PUBLIC_WHATSAPP_PHONE, falling back to the number the contact page uses.
const whatsappDigits = String(import.meta.env.PUBLIC_WHATSAPP_PHONE || '393270972329').replace(/\D/g, '')
const whatsappHref = whatsappDigits.length >= 6 ? `https://wa.me/${whatsappDigits}` : undefined
---

<div class="m-bar">
  {apartments?.badge && (
    <a class="m-pill" href="/apartments/#direct" aria-label={`Book direct and save ${apartments.badge.replace('−', '')}`}>{apartments.badge}</a>
  )}
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
    <span class="menu-toggle__label" aria-hidden="true">MENU</span>
  </button>
</div>

<dialog class="mm" id="mobile-menu" aria-label="Main navigation">
  <div class="mm__top" data-grab>
    <span class="mm__handle" aria-hidden="true"></span>
    <div class="mm__bar">
      <a class="mm__brand" href="/" aria-label={`${site.name} home`}>
        <img class="mm__logo mm__logo--day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
        <img class="mm__logo mm__logo--night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
      </a>
      <button class="mm__close" type="button" aria-label="Close menu" autofocus>
        <span>CLOSE</span>
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div class="mm__body" data-body>
    <nav class="mm__cards" aria-label="Main sections">
      {cards.map(({ item, index, image, subtitle, parts, seeAll, current }) => (
        <article class="mc" data-card={item.panel!.id} style={`--i:${index}`} data-i>
          <button
            class="mc__head"
            type="button"
            aria-expanded="false"
            aria-controls={`${item.panel!.id}-m`}
            data-current={current ? '' : undefined}
          >
            {image && <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src={image} alt="" decoding="async" />}
            <span class="mc__text">
              <span class="mc__sub">{subtitle}</span>
              <span class="mc__title">{item.label}{item.badge && <span class="mc__badge">{item.badge}</span>}</span>
            </span>
            <span class="mc__plus" aria-hidden="true"><i class="ph ph-plus"></i></span>
          </button>
          <div class="mc__body" id={`${item.panel!.id}-m`} inert>
            <div class="mc__inner">
              {parts.map((part) => {
                if (part.kind === 'lead') return (
                  <a class="lead" href={part.href} style={`--i:${part.i}`} data-r>
                    <i class={`ph-fill ${part.icon}`} aria-hidden="true"></i>
                    <span class="lead__label">{part.label}</span>
                    {part.tag && <span class="lead__tag">{part.tag}</span>}
                  </a>
                )
                if (part.kind === 'rows') return (
                  <div class="group">
                    {part.heading && <span class="eyebrow" style={`--i:${part.i}`} data-r>{part.heading}</span>}
                    {part.rows.map((row) => (
                      <a class:list={['row', { 'row--icon': !row.image }]} href={row.href} style={`--i:${row.i}`} data-r aria-current={pageAttr(row.href)}>
                        {row.image
                          ? <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src={row.image} alt="" decoding="async" />
                          : <span class="row__icon"><i class={`ph ${row.icon ?? 'ph-dot-outline'}`} aria-hidden="true"></i></span>}
                        <span class="row__text"><b>{row.label}</b><small>{row.note}</small></span>
                      </a>
                    ))}
                    {part.more && (
                      <a class="more" href={part.more.href} style={`--i:${part.more.i}`} data-r><span>{part.more.label}</span> <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                    )}
                  </div>
                )
                return (
                  <div class="group">
                    <span class="eyebrow" style={`--i:${part.i}`} data-r>{part.heading}</span>
                    <div class="tags">
                      {part.links.map((link) => <a class="tag" href={link.href} style={`--i:${link.i}`} data-r aria-current={pageAttr(link.href)}>{link.label}</a>)}
                    </div>
                    {part.note && (
                      <a class="note" href={part.note.href} style={`--i:${part.note.i}`} data-r><i class={`ph ${part.note.icon}`} aria-hidden="true"></i> <span>{part.note.label}</span></a>
                    )}
                  </div>
                )
              })}
              <a class="see-all" href={item.href} style={`--i:${seeAll}`} data-r aria-current={pageAttr(item.href)}>
                <span>See all {item.label.toLowerCase()}</span> <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </article>
      ))}
    </nav>

    {guide && (
      <section class="mm__guide" aria-label={guide.label}>
        <div class="mm__guide-head" style={`--i:${guideStart}`} data-i>
          <span class="eyebrow">{guide.label}</span>
          <a class="mm__guide-all" href={guide.href} aria-current={pageAttr(guide.href)}><span>All</span> <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <ul class="chips">
          {chips.map((chip, j) => (
            <li style={`--i:${guideStart + 1 + j}`} data-i>
              <a class="chip" href={chip.href} aria-current={pageAttr(chip.href)}>
                {chip.icon && <i class={`ph ${chip.icon}`} aria-hidden="true"></i>}<span>{chip.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {plain.map((item, j) => (
      <a class="news" href={item.href} style={`--i:${newsStart + j}`} data-i aria-current={pageAttr(item.href)}>
        <span>{item.label}</span>
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    ))}
  </div>

  <div class="mm__dock" style={`--i:${newsStart + plain.length}`} data-i>
    <a class="dock-cta" href={navCta.href} aria-current={pageAttr(navCta.href)}>
      <i class={`ph-fill ${navCta.icon}`} aria-hidden="true"></i><span>{navCta.label}</span>
    </a>
    {whatsappHref && (
      <a class="dock-btn" href={whatsappHref} target="_blank" rel="noreferrer" aria-label="Chat on WhatsApp" title="WhatsApp">
        <i class="ph ph-whatsapp-logo" aria-hidden="true"></i>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
    <button class="dock-btn dock-theme" type="button" role="switch" data-theme-toggle aria-label="Dark mode" aria-checked="false" title="Switch to dark theme">
      <i class="ph ph-sun dock-theme__sun" aria-hidden="true"></i>
      <i class="ph ph-moon dock-theme__moon" aria-hidden="true"></i>
    </button>
  </div>
</dialog>

<script>
  import { initMobileNav } from '../../scripts/nav/mobile-nav.mjs'
  const header = document.getElementById('header')
  if (header) initMobileNav(header)
</script>

<style>
  /* ---- Bar buttons (visible below 1100px) ---- */
  .m-bar { display: none; align-items: center; justify-self: end; gap: 2px; }
  .m-pill {
    position: relative; display: inline-flex; align-items: center; height: 26px; padding: 0 9px; border-radius: 999px;
    background: var(--accent, #FF5900); color: #fff; font: 600 12px/1 var(--font-mono); letter-spacing: 0.01em; white-space: nowrap;
    transition: transform 0.18s, background 0.18s; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .m-pill::after { content: ''; position: absolute; inset: -9px -4px; }
  .m-pill:hover { color: #fff; text-decoration: none; background: color-mix(in srgb, var(--accent, #FF5900) 90%, #000); }
  .m-pill:active { transform: scale(0.95); }
  .m-pill:focus-visible, .menu-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .menu-toggle {
    position: relative; display: flex; align-items: center; justify-content: center; width: 64px; height: 44px; padding: 0 10px;
    background: transparent; border: 0; border-radius: 24px; color: var(--bar-ink); font: 500 11px/1 var(--font-body); letter-spacing: 0.16em;
    cursor: pointer; transition: background 180ms ease, transform 180ms ease; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .menu-toggle__label { display: block; padding-left: 0.16em; white-space: nowrap; }
  .menu-toggle:active { transform: scale(0.96); background: color-mix(in srgb, currentColor 8%, transparent); }
  @media (hover: hover) { .menu-toggle:hover { background: color-mix(in srgb, currentColor 7%, transparent); } }
  @media (max-width: 1099px) { .m-bar { display: flex; } }
  @media (max-width: 360px) { .menu-toggle { width: 56px; padding: 0 6px; } }

  /* ---- Sheet ---- */
  .mm {
    --sheet-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --sheet-ms: 420ms;
    --gutter: max(18px, env(safe-area-inset-left));
    position: fixed; inset: 0; box-sizing: border-box; width: 100%; max-width: 640px; height: 100%; height: 100dvh; max-height: none;
    margin: 0 auto; padding: 0; border: 0; overflow: clip; overscroll-behavior: contain;
    color: var(--pop-ink, #141414);
    background: color-mix(in srgb, var(--pop-solid, #fff) 90%, transparent);
    -webkit-backdrop-filter: blur(28px) saturate(160%); backdrop-filter: blur(28px) saturate(160%);
    opacity: 0; transform: translateY(24px); transform-origin: 50% 100%;
    transition: opacity 200ms ease, transform 220ms ease;
  }
  .mm[open] { display: flex; flex-direction: column; }
  .mm.is-visible { opacity: 1; transform: none; transition: opacity 260ms ease, transform var(--sheet-ms) var(--sheet-ease); }
  .mm.is-dragging { transition: none; }
  .mm.is-swiping { transition: transform 240ms cubic-bezier(0.4, 0, 1, 1), opacity 240ms ease; opacity: 0; }
  .mm::backdrop { background: rgba(12, 20, 25, 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); transition: background 300ms ease, backdrop-filter 360ms ease, -webkit-backdrop-filter 360ms ease; }
  .mm.is-visible::backdrop { background: rgba(12, 20, 25, 0.38); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  @media (min-width: 641px) { .mm { border-inline: 1px solid var(--pop-line, rgba(20, 20, 20, 0.1)); } }
  .mm :is(a, button):focus-visible { outline: 2px solid var(--accent, #FF5900); outline-offset: 2px; }
  .mm a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .mm a:hover { text-decoration: none; }
  .mm button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .mc img, .row img { background: color-mix(in srgb, var(--pop-ink, #141414) 8%, transparent); }

  /* Rows come in one after another: 33ms step, 8px rise, blur 4px → 0. */
  .mm [data-i], .mc.is-open [data-r] { animation-fill-mode: both; }
  .mm.is-visible [data-i] { animation: mm-in 300ms cubic-bezier(0.215, 0.61, 0.355, 1) both; animation-delay: calc(var(--i, 0) * 33ms + 40ms); }
  .mc.is-open [data-r] { animation: mm-in 300ms cubic-bezier(0.215, 0.61, 0.355, 1) both; animation-delay: calc(var(--i, 0) * 33ms + 60ms); }
  @keyframes mm-in { from { opacity: 0; transform: translateY(8px); filter: blur(4px); } }
  @keyframes mm-fade { from { opacity: 0; } }

  .eyebrow { display: block; font: 500 10px/1.6 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--pop-muted, #6b6b6b); }

  /* Top: grab area (handle + bar). Swipe down from here closes the sheet. */
  .mm__top { flex-shrink: 0; touch-action: none; cursor: grab; padding-top: env(safe-area-inset-top); user-select: none; -webkit-user-select: none; }
  .mm__handle { display: block; width: 40px; height: 5px; margin: 8px auto 0; border-radius: 3px; background: color-mix(in srgb, var(--pop-ink, #141414) 22%, transparent); }
  .mm__bar { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 4px var(--gutter) 4px max(18px, env(safe-area-inset-left)); }
  .mm__brand { display: inline-flex; align-items: center; width: 112px; height: 44px; }
  .mm__logo { width: 100%; height: auto; }
  .mm__logo--night { display: none; }
  :global([data-theme='night']) .mm__logo--day { display: none; }
  :global([data-theme='night']) .mm__logo--night { display: block; }
  .mm__close {
    display: inline-flex; align-items: center; gap: 8px; min-width: 44px; height: 44px; padding: 0 12px; border: 0; border-radius: 999px;
    background: color-mix(in srgb, var(--pop-ink, #141414) 7%, transparent); color: inherit; font: 500 10px/1 var(--font-body); letter-spacing: 0.16em; cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }
  .mm__close i { font-size: 14px; }
  .mm__close:active { transform: scale(0.96); }

  .mm__body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: 8px var(--gutter) 22px; display: flex; flex-direction: column; gap: 22px; }
  .mm__body > * { flex-shrink: 0; }

  /* Photo cards */
  .mm__cards { display: flex; flex-direction: column; gap: 10px; }
  .mc { border-radius: 18px; overflow: hidden; background: color-mix(in srgb, var(--pop-ink, #141414) 4%, transparent); scroll-margin-top: 8px; scroll-margin-bottom: 12px; }
  .mc__head {
    position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; width: 100%; min-height: 96px; padding: 14px 16px; border: 0;
    border-radius: inherit; overflow: hidden; background: #1a1d21; color: #fff; text-align: left; font: inherit; cursor: pointer;
  }
  .mc__head img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  .mc__head::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 10%, rgba(0, 0, 0, 0.7)); pointer-events: none; }
  .mc.is-open .mc__head img { transform: scale(1.04); }
  .mc__text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .mc__sub { font: 500 10px/1.5 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.82); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mc__title { display: flex; align-items: center; gap: 10px; font: 400 25px/1.15 var(--font-display); }
  .mc__badge { padding: 4px 8px; border-radius: 999px; background: var(--accent, #FF5900); color: #fff; font: 600 12px/1 var(--font-mono); }
  .mc__plus { position: relative; z-index: 1; flex-shrink: 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); font-size: 16px; color: #fff; }
  .mc__plus i { transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1); }
  .mc.is-open .mc__plus i { transform: rotate(45deg); }
  .mc__head[data-current]::before { content: ''; position: absolute; z-index: 2; inset: 0 auto 0 0; width: 3px; background: var(--accent, #FF5900); }
  .mc__body { height: 0; overflow: hidden; visibility: hidden; }
  .mc.is-open .mc__body { height: auto; visibility: visible; }
  .mc__inner { display: flex; flex-direction: column; gap: 4px; padding: 10px 8px 6px; }
  .group { display: flex; flex-direction: column; }
  .group + .group { margin-top: 8px; }
  .group > .eyebrow { padding: 8px 10px 6px; }

  .lead { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 10px; border-radius: 12px; font-size: 14.5px; font-weight: 500; background: color-mix(in srgb, var(--accent, #FF5900) 10%, transparent); }
  .lead i { color: var(--accent, #FF5900); font-size: 20px; }
  .lead__label { flex: 1; }
  .lead__tag { padding: 4px 8px; border-radius: 999px; background: var(--accent, #FF5900); color: #fff; font: 600 11px/1 var(--font-mono); }
  .row { display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 7px 10px; border-radius: 12px; }
  .row img, .row__icon { flex-shrink: 0; width: 46px; height: 46px; border-radius: 10px; object-fit: cover; }
  .row__icon { display: grid; place-items: center; background: color-mix(in srgb, var(--accent, #FF5900) 12%, transparent); color: var(--accent, #FF5900); font-size: 20px; }
  .row__text { min-width: 0; }
  .row b { display: block; font-size: 14.5px; font-weight: 500; }
  .row small { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.4; color: var(--pop-muted, #6b6b6b); }
  .row:active, .row[aria-current='page'], .tag[aria-current='page'], .tag:active { background: var(--pop-hover, rgba(20, 20, 20, 0.06)); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 2px 10px 4px; }
  .tag { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--pop-line, rgba(20, 20, 20, 0.1)); font-size: 14px; }
  .note { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 10px; border-radius: 10px; font-size: 13px; color: var(--pop-muted, #6b6b6b); }
  .note i { color: var(--accent, #FF5900); font-size: 16px; }
  .more, .see-all { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 48px; padding: 0 10px; font-size: 14px; font-weight: 500; }
  .more > span, .see-all > span { text-decoration: underline; text-decoration-color: var(--accent, #FF5900); text-underline-offset: 6px; }
  .more i, .see-all i { color: var(--accent, #FF5900); font-size: 12px; text-decoration: none; }
  .see-all { margin-top: 2px; }

  /* Coast guide chips */
  .mm__guide-head { display: flex; align-items: center; justify-content: space-between; min-height: 32px; }
  .mm__guide-all { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-right: -4px; padding: 0 4px; font-size: 13px; font-weight: 500; }
  .mm__guide-all > span { text-decoration: underline; text-decoration-color: var(--accent, #FF5900); text-underline-offset: 5px; }
  .mm__guide-all i { color: var(--accent, #FF5900); font-size: 11px; }
  .chips {
    display: flex; gap: 8px; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 2px; list-style: none; overflow-x: auto; overscroll-behavior-x: contain;
