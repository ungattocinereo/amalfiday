---
// Desktop navigation (≥1100px). Without JS every trigger is a link to its hub page;
// src/scripts/nav/desktop-nav.mjs turns panel triggers into disclosure buttons.
import { navigation, type NavBlock, type NavigationItem } from '../../data/site'

interface Props {
  currentPath: string
}
const { currentPath } = Astro.props

const normalize = (href: string) => href.split('#')[0].replace(/\/$/, '') || '/'
const isWithin = (href: string) => {
  const path = normalize(href)
  return path !== '/' && !href.startsWith('http') && (currentPath === path || currentPath.startsWith(`${path}/`))
}
const blockHrefs = (block: NavBlock): string[] => {
  switch (block.kind) {
    case 'featured':
    case 'mini':
      return [block.href]
    case 'rows':
    case 'cards':
      return [...block.items.map((item) => item.href), ...(block.more ? [block.more.href] : [])]
    case 'links':
      return [...block.items.map((item) => item.href), ...(block.note ? [block.note.href] : [])]
  }
}
const isCurrentSection = (item: NavigationItem) =>
  isWithin(item.href) || Boolean(item.panel?.blocks.some((block) => blockHrefs(block).some(isWithin)))
const pageAttr = (href: string) => (normalize(href) === currentPath && !href.includes('#') ? 'page' : undefined)

// Stagger order on first open: the photo card first, then each column top to bottom.
const staggered = (blocks: NavBlock[]) => {
  const base = blocks.some((block) => block.kind === 'featured') ? 1 : 0
  let last = 0
  return blocks.map((block) => {
    let start = base
    if (block.kind === 'featured') start = 0
    if (block.kind === 'cards') start = 0
    if (block.kind === 'mini') start = last + 1
    const count = block.kind === 'rows' || block.kind === 'links'
      ? 1 + block.items.length + (('more' in block && block.more) || ('note' in block && block.note) ? 1 : 0)
      : block.kind === 'cards'
        ? block.items.length + (block.more ? 1 : 0)
        : 1
    last = Math.max(last, start + count - 1)
    return { block, start }
  })
}

// Photos load on first hover or focus (see desktop-nav.mjs).
const blank = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
---

<nav class="nm" aria-label="Main navigation" data-nm>
  <div class="nm-track" data-nm-track>
    <span class="nm-hl" aria-hidden="true"></span>
    <ul class="nm-list">
      {navigation.map((item) => (
        <li>
          <a
            class="nm-trigger"
            href={item.href}
            data-panel={item.panel?.id}
            data-link-trigger={item.linkTrigger ? '' : undefined}
            aria-haspopup={item.linkTrigger && item.panel ? 'true' : undefined}
            aria-controls={item.linkTrigger && item.panel ? item.panel.id : undefined}
            data-current={isCurrentSection(item) ? '' : undefined}
            aria-current={pageAttr(item.href)}
          >
            <span>{item.label}</span>
            {item.badge && <span class="nm-pill">{item.badge}</span>}
            {item.panel && <i class="ph ph-caret-down" aria-hidden="true"></i>}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="nm-popup" data-popup>
    <div class="nm-viewport">
      {navigation.filter((item) => item.panel).map((item) => (
        <section class={`nm-panel nm-panel--${item.panel!.layout}`} id={item.panel!.id} aria-label={item.label}>
          {staggered(item.panel!.blocks).map(({ block, start }) => {
            if (block.kind === 'featured') return (
              <a class:list={['feat', { 'feat--tall': block.tall }]} href={block.href} style={`--i:${start}`} data-i aria-current={pageAttr(block.href)}>
                <img src={blank} data-src={block.image} alt="" decoding="async" />
                {block.sticker && <span class="sticker">{block.sticker.label}<br /><b>{block.sticker.value}</b></span>}
                <span class="feat__body">
                  <span class="eyebrow">{block.eyebrow}</span>
                  <span class="feat__title">{block.title} {block.titleAccent && <em>{block.titleAccent}</em>}</span>
                  <span class="feat__cta"><span>{block.cta}</span> <i class={`ph ${block.ctaIcon}`} aria-hidden="true"></i></span>
                </span>
              </a>
            )
            if (block.kind === 'rows') return (
              <div class="col">
                <span class="eyebrow" style={`--i:${start}`} data-i>{block.heading}</span>
                {block.items.map((row, j) => (
                  <a class:list={['row', { 'row--icon': row.icon }]} href={row.href} style={`--i:${start + 1 + j}`} data-i aria-current={pageAttr(row.href)}>
                    {row.image
                      ? <img src={blank} data-src={row.image} alt="" decoding="async" />
                      : <span class="row__icon"><i class={`ph ${row.icon}`} aria-hidden="true"></i></span>}
                    <span><b>{row.label}</b><small>{row.note}</small></span>
                  </a>
                ))}
                {block.more && (
                  <a class="more" href={block.more.href} style={`--i:${start + 1 + block.items.length}`} data-i aria-current={pageAttr(block.more.href)}>
                    <span>{block.more.label}</span> <i class="ph ph-arrow-right" aria-hidden="true"></i>
                  </a>
                )}
              </div>
            )
            if (block.kind === 'links') return (
              <div class="col col--narrow">
                <span class="eyebrow" style={`--i:${start}`} data-i>{block.heading}</span>
                {block.items.map((link, j) => (
                  <a class="link" href={link.href} style={`--i:${start + 1 + j}`} data-i aria-current={pageAttr(link.href)}>{link.label}</a>
                ))}
                {block.note && (
                  <a class="note" href={block.note.href} style={`--i:${start + 1 + block.items.length}`} data-i>
                    <i class={`ph ${block.note.icon}`} aria-hidden="true"></i> <span>{block.note.label}</span>
                  </a>
                )}
              </div>
            )
            if (block.kind === 'cards') return (
              <>
                {block.items.map((card, j) => (
                  <a class="card" href={card.href} style={`--i:${start + j}`} data-i>
                    <img src={blank} data-src={card.image} alt="" decoding="async" />
                    <span class="card__body">
                      <span class="eyebrow">{card.eyebrow}</span>
                      <b>{card.title}</b>
                      <small>{card.text}</small>
                    </span>
                  </a>
                ))}
                {block.more && (
                  <a class="more more--wide" href={block.more.href} style={`--i:${start + block.items.length}`} data-i aria-current={pageAttr(block.more.href)}>
                    <span>{block.more.label}</span> <i class="ph ph-arrow-right" aria-hidden="true"></i>
                  </a>
                )}
              </>
            )
            if (block.kind === 'mini') return (
              <a class="mini" href={block.href} style={`--i:${start}`} data-i>
                <img src={blank} data-src={block.image} alt="" decoding="async" />
                <span><span class="mini__label">{block.label}</span> <i class={`ph ${block.icon}`} aria-hidden="true"></i></span>
              </a>
            )
          })}
        </section>
      ))}
    </div>
  </div>
</nav>

<script>
  import { initDesktopNav } from '../../scripts/nav/desktop-nav.mjs'
  document.querySelectorAll<HTMLElement>('[data-nm]').forEach((nav) => initDesktopNav(nav))
</script>

<style>
  .nm { position: relative; flex-shrink: 0; }
  .nm-track { position: relative; isolation: isolate; }
  .nm-list { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .nm-hl {
    position: absolute; z-index: -1; top: 0; left: 0; height: 40px; width: 0; border-radius: 999px;
    background: var(--bar-hover); opacity: 0; pointer-events: none;
    transition: transform var(--hl-ms, 300ms) var(--hl-ease, ease), width var(--hl-ms, 300ms) var(--hl-ease, ease), opacity 200ms ease;
  }
  .nm-hl.is-on { opacity: 1; }
  .nm-trigger {
    position: relative; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 15px;
    border: 0; border-radius: 999px; background: transparent; color: var(--bar-ink);
    font: 500 14.5px/1 var(--font-body); text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: color 200ms ease;
  }
  .nm:not(.is-enhanced) .nm-trigger:hover { background: var(--bar-hover); }
  .nm-trigger:hover { text-decoration: none; color: var(--bar-ink); }
  .nm-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nm-trigger i { font-size: 11px; opacity: .6; transition: transform .2s; }
  .nm-trigger[aria-expanded='true'] i { transform: rotate(180deg); }
  /* The section you are in. */
  .nm-trigger[data-current]::after {
    content: ''; position: absolute; left: 50%; bottom: 3px; width: 4px; height: 4px; margin-left: -2px;
    border-radius: 50%; background: var(--accent);
  }
  .nm-pill { padding: 3px 6px; border-radius: 999px; background: var(--accent); color: #fff; font: 600 10px/1 var(--font-mono); }

  .nm-popup {
    position: absolute; top: calc(100% + 18px); left: var(--x, 0);
    width: var(--w, 600px); height: var(--h, 300px);
    transform: scale(.9); transform-origin: var(--ox, 50%) 0;
    opacity: 0; visibility: hidden; pointer-events: none;
    border-radius: 22px; border: 1px solid var(--pop-line); overflow: hidden;
    background: var(--pop-bg); color: var(--pop-ink);
    box-shadow: 0 24px 60px rgba(10,20,30,.18), 0 2px 8px rgba(10,20,30,.06);
    -webkit-backdrop-filter: blur(28px) saturate(160%); backdrop-filter: blur(28px) saturate(160%);
    transition:
      opacity 220ms cubic-bezier(.215,.61,.355,1),
      transform 220ms cubic-bezier(.215,.61,.355,1),
      visibility 0s 220ms,
      left var(--pop-ms) var(--pop-ease),
      width var(--pop-ms) var(--pop-ease), height var(--pop-ms) var(--pop-ease);
  }
  .nm:not(.is-enhanced) .nm-popup { display: none; }
  .nm-popup.is-open {
    opacity: 1; visibility: visible; pointer-events: auto; transform: none;
    transition:
      opacity 220ms cubic-bezier(.215,.61,.355,1),
      transform 220ms cubic-bezier(.215,.61,.355,1),
      left var(--pop-ms) var(--pop-ease),
      width var(--pop-ms) var(--pop-ease), height var(--pop-ms) var(--pop-ease);
  }
  .nm-popup.no-move { transition: opacity 220ms cubic-bezier(.215,.61,.355,1), transform 220ms cubic-bezier(.215,.61,.355,1); }
  /* Bridge so the pointer can cross the gap between the bar and the panel. */
  .nm-popup::before { content: ''; position: absolute; inset: -20px 0 auto; height: 20px; }
  .nm-viewport { position: relative; width: 100%; height: 100%; }

  .nm-panel {
    position: absolute; top: 0; left: 0; box-sizing: border-box; padding: 14px;
    visibility: hidden; opacity: 0; transform: translateX(calc(var(--dir, 0) * 24px));
    transition: opacity 260ms ease, transform var(--in-ms) var(--in-ease), visibility 0s 260ms;
  }
  .nm-panel.is-entering { transition: none; }
  .nm-panel.is-active { visibility: visible; opacity: 1; transform: none; transition: opacity 260ms ease, transform var(--in-ms) var(--in-ease); }
  .nm-panel.is-leaving { visibility: visible; opacity: 0; transform: translateX(calc(var(--dir, 0) * 24px)); transition: opacity 220ms ease, transform 220ms ease; pointer-events: none; }
  /* Stagger on first open. */
  .nm-panel [data-i] { transition: opacity .3s cubic-bezier(.215,.61,.355,1), transform .3s cubic-bezier(.215,.61,.355,1), filter .3s, background .16s; }
  .nm-panel.is-stagger [data-i] { animation: nm-row .3s cubic-bezier(.215,.61,.355,1) both; animation-delay: calc(var(--i) * 33ms); }
  @keyframes nm-row { from { opacity: 0; transform: translateX(8px); filter: blur(4px); } }

  .nm-panel--photo { width: 760px; display: grid; grid-template-columns: 260px 1fr 190px; gap: 6px; }
  .nm-panel--stay { width: 640px; display: grid; grid-template-columns: 290px 1fr; gap: 6px; }
  .nm-panel--tours { width: 720px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .nm-panel--guide { width: 620px; display: grid; grid-template-columns: 1fr 170px; grid-template-rows: auto auto; gap: 6px; }

  .nm-panel img { background: color-mix(in srgb, var(--pop-ink) 8%, transparent); }
  .nm-panel .eyebrow { display: block; padding: 8px 10px 6px; font: 500 10px/1.6 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--pop-muted); }
  .nm-panel a { color: var(--pop-ink); text-decoration: none; }
  .nm-panel a:hover { text-decoration: none; color: var(--pop-ink); }
  .nm-panel a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .col { display: flex; flex-direction: column; padding: 4px; }
  .col--narrow { border-left: 1px solid var(--pop-line); padding-left: 10px; }

  .feat { position: relative; display: block; min-height: 300px; border-radius: 14px; overflow: hidden; }
  .nm-panel .feat, .nm-panel .feat:hover, .nm-panel .mini, .nm-panel .mini:hover { color: #fff; }
  .feat--tall { min-height: 380px; }
  .feat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .feat:hover img { transform: scale(1.05); }
  .feat::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(0,0,0,.72)); }
  .feat__body { position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 16px; display: flex; flex-direction: column; gap: 4px; }
  .nm-panel .feat .eyebrow { padding: 0; color: rgba(255,255,255,.75); }
  .feat__title { font: 400 24px/1.2 var(--font-display); }
  .feat__title em { color: var(--accent); }
  .feat__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 13px; font-weight: 500; }
  .feat:hover .feat__cta > span { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }
  .sticker { position: absolute; z-index: 1; top: 14px; right: 14px; display: grid; place-items: center; width: 74px; height: 74px; border-radius: 50%; background: var(--accent); color: #fff; text-align: center; font: 500 10px/1.15 var(--font-body); transform: rotate(-10deg); box-shadow: 0 6px 18px rgba(0,0,0,.25); }
  .sticker b { font: 700 20px/1 var(--font-body); }

  .row { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 12px; }
  .row:hover, .row[aria-current='page'] { background: var(--pop-hover); }
  .row img, .row__icon { flex-shrink: 0; width: 46px; height: 46px; border-radius: 10px; object-fit: cover; }
  .row__icon { display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-size: 20px; transition: background .16s, color .16s; }
  .row b { display: block; font-size: 14.5px; font-weight: 500; }
  .row small { display: block; margin-top: 2px; font-size: 12.5px; color: var(--pop-muted); }
  .row:hover .row__icon { background: var(--accent); color: #fff; }

  .link { padding: 9px 10px; border-radius: 10px; font-size: 14px; }
  .link:hover, .link[aria-current='page'] { background: var(--pop-hover); }
  .nm-panel .note { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 12px 10px; border-radius: 10px; font-size: 12.5px; color: var(--pop-muted); }
  .note i { color: var(--accent); }
  .nm-panel .note:hover { background: var(--pop-hover); color: var(--pop-ink); }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding: 12px 10px; font-size: 13px; font-weight: 500; }
  .more span { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 6px; }
  .more i { color: var(--accent); }
  .more--wide { grid-column: 1 / -1; justify-self: start; margin-top: 0; padding-top: 4px; }

  .card { display: flex; flex-direction: column; border-radius: 14px; overflow: hidden; background: color-mix(in srgb, var(--pop-ink) 4%, transparent); }
  .card img { width: 100%; height: 150px; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .card:hover img { transform: scale(1.05); }
  .card__body { position: relative; display: flex; flex-direction: column; gap: 4px; padding: 4px 6px 14px; background: inherit; }
  .nm-panel .card__body .eyebrow { padding: 8px 6px 0; }
  .card b { padding: 0 6px; font: 400 17px/1.3 var(--font-display); }
  .card small { padding: 0 6px; font-size: 12.5px; line-height: 1.45; color: var(--pop-muted); }

  .mini { grid-column: 1 / -1; position: relative; display: flex; align-items: flex-end; height: 92px; border-radius: 14px; overflow: hidden; }
  .mini img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .mini::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.6), transparent 70%); }
  .mini > span { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; padding: 14px 16px; font-size: 14px; font-weight: 500; }
  .mini:hover .mini__label { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }

  @media (prefers-reduced-motion: reduce) {
    .nm-hl, .nm-popup, .nm-panel, .nm-panel * { transition: opacity .15s ease !important; animation: none !important; transform: none !important; }
    .nm-popup:not(.is-open) { transition: opacity .15s ease, visibility 0s .15s !important; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .nm-popup { background: var(--pop-solid); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (max-width: 1099px) {
    .nm { display: none; }
  }
</style>
