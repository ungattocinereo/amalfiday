---
import { getCityIcon } from '../data/city-icons'

interface Props { name: string }
const { name } = Astro.props
const cities = name.split(/\s+&\s+/)
---
<span class="city-label">
  {cities.map((city, index) => <>
    {index > 0 && <span class="city-label__separator">&amp;</span>}
    <span class="city-label__place"><i class={`fa-solid ${getCityIcon(city)}`} aria-hidden="true"></i> {city}</span>
  </>)}
</span>

<style>
  .city-label { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35em; }
  .city-label__place { display: inline; }
  .city-label__place i { margin-inline-end: 0.15em; }
</style>
