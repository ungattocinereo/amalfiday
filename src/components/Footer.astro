---
import { footerLinks, socialLinks } from '../data/site'
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__logo-wrap" role="img" aria-label="Amalfi Day logo">
        <img
          class="footer__logo footer__logo--light"
          src="/brand/logo-color-black.svg"
          alt=""
          aria-hidden="true"
          loading="lazy" width="300" height="88"
        />
        <img
          class="footer__logo footer__logo--dark"
          src="/brand/logo-color-white.svg"
          alt=""
          aria-hidden="true"
          loading="lazy" width="300" height="88"
        />
      </div>
      <div class="footer__social">
        {socialLinks
          .filter((item) => ['Instagram', 'Facebook', 'Twitter'].includes(item.label))
          .map((item) => (
            <a
              class={`footer__social-link ${
                item.label === 'Instagram'
                  ? 'footer__social-link--instagram'
                  : item.label === 'Facebook'
                    ? 'footer__social-link--facebook'
                    : 'footer__social-link--twitter'
              }`}
              href={item.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${item.label} (opens in a new tab)`}
            >
              {item.label === 'Instagram' && <i class="ph ph-instagram-logo" aria-hidden="true"></i>}
              {item.label === 'Facebook' && <i class="ph ph-facebook-logo" aria-hidden="true"></i>}
              {item.label === 'Twitter' && <i class="ph ph-x-logo" aria-hidden="true"></i>}
            </a>
          ))}
      </div>
    </div>

    <div class="footer__column">
      {footerLinks.transport.map((item) => (
        <a
          class={`footer__link ${item.label === "Greg's guide" ? 'footer__link--nowrap' : ''}`}
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
        >
          {item.label === 'Ferry timetables' && (
            <i class="ph ph-waves footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Bus timetables' && (
            <i class="ph ph-bus footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Book Airport Shuttle' && (
            <i class="ph ph-ticket footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Naples to Amalfi' && (
            <i class="ph ph-path footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'All public transport' && (
            <i class="ph ph-map-trifold footer__icon" aria-hidden="true"></i>
          )}
          <span class="footer__label">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="footer__column">
      {footerLinks.apartments.map((item) => (
        <a
          class="footer__link"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
        >
          {item.label === 'Booking.com' && (
            <i class="ph ph-bed footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'AirBnb.com' && (
            <i class="ph ph-house footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Apartment overview' && (
            <i class="ph ph-house footer__icon" aria-hidden="true"></i>
          )}
          {item.label === "Greg's guide" && (
            <i class="ph ph-signpost footer__icon" aria-hidden="true"></i>
          )}
          <span class="footer__label">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="footer__column">
      {footerLinks.info.map((item) => (
        <a class="footer__link" href={item.href}>
          {item.label === 'What to do' && (
            <i class="ph ph-star footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Parking tips' && (
            <i class="ph ph-park footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Beach reviews' && (
            <i class="ph ph-umbrella footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Moto roads' && (
            <i class="ph ph-map-trifold footer__icon" aria-hidden="true"></i>
          )}
          <span class="footer__label">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="footer__column">
      {footerLinks.blog.map((item) => (
        <a class="footer__link" href={item.href}>
          {item.label === 'Amalfi News' && (
            <i class="ph ph-newspaper footer__icon" aria-hidden="true"></i>
          )}
          {item.label === 'Contact us' && (
            <i class="ph ph-envelope footer__icon" aria-hidden="true"></i>
          )}
          <span class="footer__label">{item.label}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__legal">
        © 2014-{new Date().getFullYear()} CristallPont S.R.L. · P.IVA / C.F.: 05863730650
        <br />
        <span class="footer__registry">Sede legale: Traversa Dragone, 2 · Cap. Soc. €10.000</span>
      </p>
      <nav class="footer__meta" aria-label="Legal links">
        <a class="footer__policy" href="/privacy">
          <i class="ph ph-shield-check footer__meta-icon" aria-hidden="true"></i>
          <span class="footer__label">Privacy Policy</span>
        </a>
        <a class="footer__policy" href="/cookie-policy">
          <i class="ph ph-cookie footer__meta-icon" aria-hidden="true"></i>
          <span class="footer__label">Cookie Policy</span>
        </a>
        <a class="footer__policy" href="/terms">
          <i class="ph ph-file-text footer__meta-icon" aria-hidden="true"></i>
          <span class="footer__label">Terms & Conditions</span>
        </a>
        <button class="footer__cookie-settings" type="button" id="open-cookie-banner">
          <i class="ph ph-sliders-horizontal footer__meta-icon" aria-hidden="true"></i>
          <span class="footer__label">Cookie settings</span>
        </button>
      </nav>
    </div>
  </div>
  <div class="footer__credit-bar">
    <div class="container">
      <span class="footer__credit">
        Design & Development Gregory '<a
          class="footer__credit-link"
          href="https://cinereo.it"
          target="_blank"
          rel="noreferrer"
        >Cinereo</a>' Day
      </span>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('open-cookie-banner')?.addEventListener('click', function () {
    var banner = document.getElementById('cookie-banner')
    if (banner) banner.classList.add('is-visible')
  })
</script>

<style>
  .footer {
    --footer-legal-bg: color-mix(in srgb, var(--color-bg) 92%, #000);
    --footer-credit-bg: #5d6168;
    padding: 5rem 0 0;
    background: color-mix(in srgb, var(--color-bg) 96%, #000);
  }

  :global([data-theme='night']) .footer {
    --footer-legal-bg: color-mix(in srgb, var(--color-bg) 75%, #000);
    --footer-credit-bg: #05070a;
  }

  .footer__inner {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1.2fr repeat(4, 1fr);
    align-items: start;
  }

  .footer__logo-wrap {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.5rem;
    max-width: 100%;
  }

  .footer__logo {
    display: block;
    height: 56px;
    width: auto;
    max-width: min(240px, 70vw);
    object-fit: contain;
  }

  .footer__logo--dark {
    display: none;
  }

  :global([data-theme='night']) .footer__logo--light {
    display: none;
  }

  :global([data-theme='night']) .footer__logo--dark {
    display: block;
  }

  .footer__social {
    display: flex;
    gap: 0.8rem;
  }

  .footer__social-link {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: var(--color-text);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .footer__social-link:hover,
  .footer__social-link:focus-visible {
    color: #ffffff;
    border-color: transparent;
    transform: translateY(-1px);
  }

  .footer__social-link--instagram:hover,
  .footer__social-link--instagram:focus-visible {
    background: #e1306c;
  }

  .footer__social-link--facebook:hover,
  .footer__social-link--facebook:focus-visible {
    background: #1877f2;
  }

  .footer__social-link--twitter:hover,
  .footer__social-link--twitter:focus-visible {
    background: #1d9bf0;
  }

  .footer__column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__link,
  .footer__link:hover,
  .footer__link:focus-visible,
  .footer__social-link,
  .footer__social-link:hover,
  .footer__social-link:focus-visible,
  .footer__policy,
  .footer__policy:hover,
  .footer__policy:focus-visible,
  .footer__cookie-settings,
  .footer__cookie-settings:hover,
  .footer__cookie-settings:focus-visible {
    text-decoration: none;
  }

  .footer__link {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    min-height: 36px;
    padding-block: 0.25rem;
  }

  .footer__icon {
    flex-shrink: 0;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .footer__label {
    position: relative;
    display: inline-block;
    width: fit-content;
  }

  .footer__label::before,
  .footer__label::after {
    content: '';
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    height: 1px;
    background: currentColor;
    pointer-events: none;
  }

  /* Slide and swap adapted from VengeanceUI's Line Hover Link. */
  .footer__link .footer__label::before {
    transform: scale3d(0, 1, 1);
    transform-origin: 100% 50%;
    transition: transform 0.3s ease;
  }

  .footer__link:is(:hover, :focus-visible) .footer__label::before {
    transform: scale3d(1, 1, 1);
    transform-origin: 0% 50%;
  }

  .footer__link .footer__label::after {
    content: none;
  }

  .footer__meta .footer__label::before {
    transform: scale3d(0, 1, 1);
    transform-origin: 0% 50%;
    transition: transform 0.3s ease;
  }

  .footer__meta .footer__label::after {
    top: calc(100% + 4px);
    transform-origin: 100% 50%;
    transition: transform 0.3s ease;
  }

  :is(.footer__policy, .footer__cookie-settings):is(:hover, :focus-visible) .footer__label::before {
    transform: scale3d(1, 1, 1);
  }

  :is(.footer__policy, .footer__cookie-settings):is(:hover, :focus-visible) .footer__label::after {
    transform: scale3d(0, 1, 1);
  }

  .footer__bottom {
    margin-top: 3.5rem;
    padding: 1.5rem 0;
    background: var(--footer-legal-bg);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .footer__legal {
    margin: 0;
    line-height: 1.6;
  }

  .footer__registry {
    font-size: 0.75rem;
  }

  .footer__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .footer__policy,
  .footer__cookie-settings {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    color: inherit;
    transition: color 0.2s ease;
  }

  .footer__policy:hover,
  .footer__policy:focus-visible,
  .footer__cookie-settings:hover,
  .footer__cookie-settings:focus-visible {
    color: var(--color-accent);
  }

  .footer__meta-icon {
    flex-shrink: 0;
    font-size: 1rem;
  }

  .footer__cookie-settings {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    cursor: pointer;
  }

  .footer__credit-bar {
    background: var(--footer-credit-bg);
    padding: 0.9rem 0;
    text-align: center;
  }

  .footer__credit {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    font-size: 0.75rem;
    color: #f5f5f5;
  }

  .footer__credit-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__credit-link:hover,
  .footer__credit-link:focus-visible {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__label::before,
    .footer__label::after {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 1100px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2rem;
      text-align: center;
    }

    .footer__brand,
    .footer__column,
    .footer__bottom-inner,
    .footer__meta {
      align-items: center;
      text-align: center;
    }

    .footer__social,
    .footer__link {
      justify-content: center;
    }

    .footer__logo {
      height: 75px;
      max-width: min(360px, 96vw);
    }

    .footer__link {
      font-size: 1.425rem;
      min-height: 44px;
    }

    .footer__link--nowrap {
      white-space: nowrap;
    }

    .footer__icon {
      font-size: 1.275rem;
    }

    .footer__bottom {
      font-size: 0.82rem;
    }

    .footer__meta {
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
    }

    .footer__policy,
    .footer__cookie-settings {
      min-height: 44px;
    }

    .footer__credit {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 640px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
