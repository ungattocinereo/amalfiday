---
import CityLabel from './CityLabel.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import PhotoshootHeroSummary from './PhotoshootHeroSummary.astro'
import PhotoshootStory from './PhotoshootStory.astro'
import PhotoshootGallery from './PhotoshootGallery.astro'
import GalleryStudyControls from './GalleryStudyControls.astro'
import PhotoRequestDialog from './PhotoRequestDialog.astro'
import { buildPhotoshootSchema } from '../data/photoshoot-schema'
import { photoStyle, type Photoshoot } from '../data/photoshoot-types'
import '../styles/gallery-study.css'
interface Props { shoot: Photoshoot }
const { shoot } = Astro.props
const { hero, frames } = shoot
const mobileHero = shoot.mobileHero && frames.find(frame => frame.id === shoot.mobileHero!.frameId)
if (shoot.mobileHero && !mobileHero) throw new Error(`Unknown mobile hero: ${shoot.slug}/${shoot.mobileHero.frameId}`)
const context = [shoot.name, shoot.schema.description, ...shoot.chapters.flatMap(chapter => chapter.before.flatMap(story => story.paragraphs))]
const jsonLd = buildPhotoshootSchema({ slug: shoot.slug, ...shoot.schema, hero: hero.original, location: shoot.location, galleryImages: frames.map(frame => ({ src: frame.original, alt: frame.alt })) })
const browserFrames = frames.map(({ original, src, alt }) => ({ original, src, alt }))
---
<BaseLayout title={shoot.title} description={shoot.description} image={hero.original} imageAlt={hero.alt} jsonLd={jsonLd}>
  <div class="gs gs-shoot" data-gallery-study data-shoot={shoot.slug}>
    <script type="application/json" data-gallery-frames set:html={JSON.stringify(browserFrames).replace(/</g, '\\u003c')} />
    <section class="gs-hero hero--dark" data-hero-layout={shoot.heroLayout} data-mobile-heading={shoot.mobileHero?.headingPosition} aria-label={`${shoot.name} — photoshoot in ${shoot.location}`} style={photoStyle({ ...hero, mobileFocal: shoot.mobileHero?.focal || hero.mobileFocal })}>
      <picture class="gs-hero__motion">
        {mobileHero && <source media="(max-width: 900px) and (orientation: portrait)" srcset={mobileHero.srcset} sizes={`max(100vw, ${(mobileHero.width / mobileHero.height * 100).toFixed(1)}svh)`} width={mobileHero.width} height={mobileHero.height} />}
        <img class="gs-hero__image" src={hero.src} srcset={hero.srcset} sizes={`max(100vw, ${(hero.width / hero.height * 100).toFixed(1)}svh)`} alt={mobileHero ? `${shoot.name} — photoshoot in ${shoot.location}` : hero.alt} width={hero.width} height={hero.height} fetchpriority="high" loading="eager" />
      </picture>
      <div class="gs-hero__veil"></div>
      <div class="gs-hero__content hero-container">
        <div class="gs-eyebrow"><div class="gs-hero__location"><CityLabel name={shoot.location} />, Italy</div>{shoot.date && <span>{shoot.date}</span>}</div>
        <h1>{shoot.heading.lead}<br /><em>{shoot.heading.accent}</em></h1>
        <div class="gs-hero__bottom"><PhotoshootHeroSummary description={shoot.summary} context={context} images={frames} inline /><a href="#gs-story" aria-label="Discover the story"><span>Discover</span><i class="ph ph-arrow-down" aria-hidden="true"></i></a></div>
      </div>
      <button class="gs-motion-toggle" type="button" aria-label="Pause cover animation" aria-pressed="false"><i class="ph ph-pause" aria-hidden="true"></i></button>
    </section>
    {shoot.chapters.map((chapter, index) => <>
      {chapter.before.map((story, storyIndex) => <PhotoshootStory story={story} location={shoot.location} id={index === 0 && storyIndex === 0 ? 'gs-story' : undefined} />)}
      {index === 0 && shoot.quote && <section class="gs-quote gs-wrap" aria-label={`Words from ${shoot.quote.author}`}>
        <blockquote data-reveal><span class="gs-quote__mark" aria-hidden="true">“</span><p>{shoot.quote.text}</p><footer><span class="gs-quote__rule"></span><cite>{shoot.quote.author}</cite></footer></blockquote>
      </section>}
      <PhotoshootGallery chapter={chapter} images={chapter.frameIds.map(id => frames.find(frame => frame.id === id)!)} number={index + 1} name={shoot.name} location={shoot.location} />
    </>)}
    <section class="gs-cta gs-wrap" data-reveal>
      <span class="gs-eyebrow"><i class="ph ph-camera" aria-hidden="true"></i> Your turn to remember</span>
      <h2>A place. A feeling.<br /><em>A story that’s yours.</em></h2>
      <p>Tell me a little about yourself.<br />I’ll take care of the light, the places, and the quiet moments in between.</p>
      <a class="gs-button gs-request-trigger" href="/contact?service=Photoshooting" data-request aria-haspopup="dialog" aria-controls="gs-request"><span class="gs-request-trigger__label">Request a photoshoot</span><span class="gs-request-trigger__icon" aria-hidden="true"><i class="ph ph-arrow-right" aria-hidden="true"></i><i class="ph ph-camera" aria-hidden="true"></i></span></a>
      <span class="gs-cta__note">Made with you, on the Amalfi Coast.</span>
    </section>
  </div>
  <dialog class="gs-dialog gs-lightbox" id="gs-lightbox" aria-label="Photograph viewer">
    <div class="gs-lightbox__top"><span class="gs-eyebrow">{shoot.name} / {shoot.location}</span><button class="gs-icon" type="button" data-close aria-label="Close photograph viewer"><i class="ph ph-x" aria-hidden="true"></i></button></div>
    <div class="gs-lightbox__image"><img alt="" /></div>
    <GalleryStudyControls label="Full-size photographs" images={frames} />
    <p class="sr-only" data-lightbox-status aria-live="polite"></p>
  </dialog>
  <PhotoRequestDialog />
  <script>
    import '../scripts/gallery-study'
  </script>
</BaseLayout>
