---
import { photoStyle, type PhotoFrame } from '../data/photoshoot-types'
interface Props { label: string; images: PhotoFrame[]; paired?: boolean }
const { label, images, paired = false } = Astro.props
const initialCount = paired && images.length > 1 ? '01–02' : '01'
---
<div class="gs-controls">
  <span class="gs-count"><span data-current>{initialCount}</span><span class="gs-count__line"></span><span data-total>{String(images.length).padStart(2, '0')}</span></span>
  <div class="gs-thumbs" aria-label={`${label}: choose a photograph`}>
    {images.map((image, index) => (
      <button type="button" class="gs-thumb" data-frame={index} style={photoStyle(image)} aria-label={`View photograph ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}>
        <img src={image.thumb} alt="" width="32" height="38" loading="lazy" />
      </button>
    ))}
  </div>
  <div class="gs-arrows">
    <button class="gs-icon" type="button" data-prev aria-label="Previous photograph"><i class="ph ph-arrow-left" aria-hidden="true"></i></button>
    <button class="gs-icon" type="button" data-next aria-label="Next photograph"><i class="ph ph-arrow-right" aria-hidden="true"></i></button>
  </div>
</div>
