---
---
<dialog class="gs-dialog gs-request" id="gs-request" aria-labelledby="gs-request-title">
  <div class="gs-request__sheet">
    <button class="gs-icon gs-close" type="button" data-close aria-label="Close request form"><i class="ph ph-x" aria-hidden="true"></i></button>
    <div class="gs-request__intro">
      <span class="gs-eyebrow"><i class="ph ph-camera" aria-hidden="true"></i> A little time, just for you</span>
      <h2 id="gs-request-title" tabindex="-1" autofocus>Let’s make <em>your story.</em></h2>
      <p>Leave a contact. I’ll take care of the next step.</p>
    </div>
    <form id="gs-request-form" action="/api/contact" method="post">
      <div class="gs-fields">
        <div class="gs-field-pair gs-essentials">
          <label>Your name <input name="name" autocomplete="name" placeholder="Your name" maxlength="80" required /></label>
          <div class="gs-contact-field" data-contact-kind="unknown">
            <label for="gs-contact">Email or WhatsApp</label>
            <div class="gs-contact-input">
              <input id="gs-contact" name="contact" type="text" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="Email or +39…" maxlength="120" aria-describedby="gs-contact-hint" required />
              <span class="gs-contact-icons" aria-hidden="true"><i class="ph ph-envelope" aria-hidden="true"></i><i class="ph ph-whatsapp-logo" aria-hidden="true"></i></span>
            </div>
          </div>
        </div>
        <p class="gs-contact-hint" id="gs-contact-hint">An email address or a WhatsApp number with country code.</p>
        <div class="gs-field-pair">
          <label>Photoshoot <span class="gs-optional">optional</span><span class="gs-select"><select name="shoot_type"><option value="">Let’s decide</option><option>Solo portrait</option><option>Couple</option><option>Proposal</option><option>Family</option><option>Editorial / brand</option></select><i class="ph ph-caret-down" aria-hidden="true"></i></span></label>
          <label><span><i class="ph ph-calendar-blank" aria-hidden="true"></i> Date <span class="gs-optional">optional</span></span><input name="dates" type="date" /></label>
        </div>
        <details class="gs-extra">
          <summary><span>Add a note <span class="gs-optional">optional</span></span><i class="ph ph-plus" aria-hidden="true"></i></summary>
          <label class="sr-only" for="gs-message">A little about your plans</label>
          <textarea id="gs-message" name="message" rows="2" maxlength="1800" placeholder="A place, an occasion, a feeling…"></textarea>
        </details>
        <label class="gs-consent"><input type="checkbox" name="gdpr" required /><span>I agree to the <a href="/privacy" target="_blank" rel="noreferrer">privacy policy</a> and sending my request via Telegram.</span></label>
      </div>
      <div class="gs-trap" aria-hidden="true"><label>Leave empty<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="_form_started_at" />
      <input type="hidden" name="service" value="Photoshooting" />
      <button class="gs-button gs-send" type="submit"><span>Send my request</span><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i></button>
      <p class="gs-form-status" role="status" aria-live="polite"></p>
      <p class="gs-request__note">A personal reply. No commitment or payment.</p>
    </form>
    <div class="gs-success" hidden tabindex="-1">
      <span class="gs-success__mark"><i class="ph ph-check" aria-hidden="true"></i></span>
      <span class="gs-eyebrow">The first step is yours</span>
      <h2>Your story<br /><em>starts here.</em></h2>
      <p>Thank you. Your request has been sent.<br />I’ll get back to you using your chosen contact.</p>
      <button class="gs-button" type="button" data-close>Back to the photographs <i class="ph ph-arrow-right" aria-hidden="true"></i></button>
    </div>
  </div>
</dialog>
