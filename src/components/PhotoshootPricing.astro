---
import CityLabel from './CityLabel.astro'
import StatsCounter from './StatsCounter.astro'
import type { PhotographyPackage } from '../data/photographer'

interface Props {
  packages: PhotographyPackage[]
}

const { packages } = Astro.props
---

<div class="package-grid">
  {packages.map((pkg, index) => (
    <article
      class:list={['package-card', { 'package-card--recommended': pkg.recommended }]}
      id={pkg.id}
      aria-labelledby={`${pkg.id}-title`}
    >
      <div class="package-card__topline">
        <span class="package-card__edition">0{index + 1} / {pkg.session === 'solo' ? 'Just you' : 'For two'}</span>
        <span class:list={['package-card__badge', { 'package-card__badge--recommended': pkg.recommended }]}>
          {pkg.recommended ? 'Recommended' : index === 0 ? 'The essentials' : 'The full story'}
        </span>
      </div>

      <header class="package-card__header">
        <h3 id={`${pkg.id}-title`}>{pkg.tier}</h3>
        <p>{pkg.tagline}</p>
      </header>

      <div class="package-card__price">
        <span class="package-card__amount"><span class="package-card__currency">€</span>{pkg.price}</span>
        <span class="package-card__price-note">{pkg.session === 'solo' ? 'for one person' : 'total for two people'}</span>
      </div>

      <dl class="package-card__metrics">
        <div>
          <dt>Retouched photos</dt>
          <dd><StatsCounter value={pkg.photoCount} /><span class="package-card__unit">+</span></dd>
        </div>
        <div>
          <dt>Session time</dt>
          <dd><StatsCounter value={pkg.durationMinutes} /><span class="package-card__unit"> min</span></dd>
        </div>
      </dl>

      <div class="package-card__location">
        {pkg.locations.split(' or ').map((location, index) => <>
          {index > 0 && <span>or</span>}
          <CityLabel name={location} />
        </>)}
      </div>
      <ul class="package-card__features">
        <li><i class="ph ph-path" aria-hidden="true"></i><span>{pkg.route}</span></li>
        <li><i class="ph ph-t-shirt" aria-hidden="true"></i><span>{pkg.outfits}</span></li>
        <li><i class={`ph ${pkg.previews ? 'ph-lightning' : 'ph-cloud-arrow-down'}`} aria-hidden="true"></i><span>{pkg.previews ? `${pkg.previews} previews within 24 hours` : 'Private online gallery'}</span></li>
        <li><i class="ph ph-calendar-check" aria-hidden="true"></i><span>All photos within 7 business days</span></li>
      </ul>

      <p class="package-card__ideal">Made for <span>{pkg.idealFor.toLowerCase()}.</span></p>
      <a
        class="package-card__button"
        href={`/contact?${new URLSearchParams({ service: 'Photoshooting', package: pkg.id })}#contact-form`}
        aria-label={`Choose ${pkg.name}, €${pkg.price}, ${pkg.durationMinutes} minutes and ${pkg.photoCount}+ retouched photos`}
      >
        Choose {pkg.tier}<i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    </article>
  ))}
</div>

<div class="package-assurance">
  <p><i class="ph ph-camera" aria-hidden="true"></i> Posing guidance &amp; professional retouching in every session</p>
  <p>Base prices include Atrani &amp; Amalfi. <a href="#travel-fees">See travel fees for other towns <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></p>
</div>

<style>
  @property --package-border-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }

  .package-card {
    --package-text: var(--color-text);
    --package-muted: var(--color-text-muted);
    --package-border: var(--color-border);
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--package-border);
    border-radius: 20px;
    background: var(--color-card);
    color: var(--package-text);
    scroll-margin-top: calc(var(--header-space) + 1.5rem);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .package-card:hover,
  .package-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .package-card--recommended {
    --package-border-gradient: conic-gradient(
      from var(--package-border-angle),
      #ff5900,
      #ffc300 22%,
      #ffe7b0 40%,
      #ff5900 58%,
      #ffae62 78%,
      #ff5900
    );
    isolation: isolate;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--color-card), var(--color-card)) padding-box,
      var(--package-border-gradient) border-box;
    box-shadow: 0 10px 30px rgba(255, 89, 0, 0.08);
    animation: package-border-orbit 10s linear infinite;
  }

  .package-card--recommended::before {
    content: '';
    position: absolute;
    inset: -6px;
    z-index: -2;
    border-radius: inherit;
    background: var(--package-border-gradient);
    filter: blur(22px);
    opacity: 0.32;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .package-card--recommended::after {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border: inherit;
    border-radius: inherit;
    background: inherit;
    pointer-events: none;
  }

  .package-card--recommended:hover,
  .package-card--recommended:focus-within {
    box-shadow: 0 14px 36px rgba(255, 89, 0, 0.12);
  }

  .package-card--recommended:hover::before,
  .package-card--recommended:focus-within::before {
    opacity: 0.5;
  }

  @keyframes package-border-orbit {
    to {
      --package-border-angle: 360deg;
    }
  }

  .package-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .package-card__edition {
    color: var(--package-muted);
  }

  .package-card__badge {
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--package-border);
    border-radius: 5px;
    color: var(--package-muted);
  }

  .package-card__badge--recommended {
    color: #1a1a1a;
    background: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }

  .package-card__header h3 {
    color: var(--package-text);
    font-size: clamp(1.5rem, 2.3vw, 1.85rem);
    line-height: 1.2;
    margin: 0 0 0.8rem;
  }

  .package-card__header p {
    min-height: 3.2em;
    margin: 0;
    color: var(--package-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .package-card__price {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1.2rem 0 1.25rem;
  }

  .package-card__amount {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.06em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .package-card__currency {
    margin-right: 0.15em;
    font-size: 0.6em;
    vertical-align: 0.15em;
  }

  .package-card__price-note {
    color: var(--package-muted);
    font-size: 0.78rem;
  }

  .package-card__metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 0 1.1rem;
    padding: 1rem 0;
    border-block: 1px solid var(--package-border);
  }

  .package-card__metrics > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.45rem;
  }

  .package-card__metrics > div + div {
    padding-left: 1.15rem;
    border-left: 1px solid var(--package-border);
  }

  .package-card__metrics dt {
    color: var(--package-muted);
    font-size: 0.72rem;
  }

  .package-card__metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .package-card__unit {
    margin-left: 0.15em;
    font-family: var(--font-body);
    font-size: 0.8rem;
  }

  .package-card__location {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
    color: var(--package-text);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .package-card__features {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
    flex: 1;
  }

  .package-card__features li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.65rem;
    color: var(--package-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .package-card__features i {
    color: var(--package-text);
    font-size: 0.75rem;
    text-align: center;
  }

  .package-card__ideal {
    border-top: 1px solid var(--package-border);
    padding-top: 0.8rem;
    margin: 0 0 1rem;
    min-height: 3.8em;
    color: var(--package-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .package-card__ideal span {
    color: var(--package-text);
  }

  .package-card__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.8rem 1rem;
    border: 1px solid var(--package-border);
    border-radius: 8px;
    color: var(--package-text);
    font-size: 0.83rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .package-card--recommended .package-card__button,
  .package-card__button:hover {
    color: #1a1a1a;
    background: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .package-card--recommended .package-card__button:hover {
    background: #ff762c;
    border-color: #ff762c;
  }

  .package-card__button:focus-visible {
    outline: 3px solid var(--color-aux-2);
    outline-offset: 4px;
  }

  .package-assurance {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    column-gap: 1.5rem;
    row-gap: 0.6rem;
    margin-top: 1.8rem;
    text-align: center;
  }

  .package-assurance p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .package-assurance i {
    margin-right: 0.4rem;
  }

  .package-assurance a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 899px) {
    .package-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
      gap: 1.25rem;
    }

    .package-card {
      padding: 1.6rem;
    }

    .package-card__topline {
      margin-bottom: 1.5rem;
      font-size: 0.62rem;
    }

    .package-card__header p {
      min-height: 0;
    }

    .package-card__features {
      gap: 0.6rem;
    }

    .package-card__ideal {
      min-height: 0;
    }
  }

  @media (max-width: 359px) {
    .package-card {
      padding: 1.25rem;
    }

    .package-card__topline {
      font-size: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .package-card--recommended {
      animation: none;
    }

    .package-card,
    .package-card--recommended::before,
    .package-card__button {
      transition: none;
    }

    .package-card:hover,
    .package-card:focus-within {
      transform: none;
    }
  }
</style>
