---
// Left column of the contact hero: short intro + every way to reach us.
interface Props {
  whatsappHref: string
  email: string
}
const { whatsappHref, email } = Astro.props
---

<div class="contact-intro">
  <span class="badge contact-intro__badge">
    <i class="ph ph-chat" aria-hidden="true"></i> Contact Amalfi.Day
  </span>
  <h1>Let's plan your <span class="accent-italic">Amalfi</span> days</h1>
  <p class="contact-intro__lead">
    Tell us your dates and what you have in mind: a photoshoot, a stay in Atrani or a private tour.
    We reply personally.
  </p>

  <ul class="contact-intro__channels">
    <li>
      <a class="contact-intro__channel contact-intro__channel--whatsapp" href={whatsappHref} target="_blank" rel="noreferrer">
        <i class="ph ph-whatsapp-logo" aria-hidden="true"></i>
        <span class="contact-intro__channel-text"><strong>WhatsApp</strong><span>Fastest way</span></span>
      </a>
    </li>
    <li>
      <a class="contact-intro__channel" href="https://instagram.com/amalfi.day" target="_blank" rel="noreferrer">
        <i class="ph ph-instagram-logo" aria-hidden="true"></i>
        <span class="contact-intro__channel-text"><strong>Instagram</strong><span>@amalfi.day</span></span>
      </a>
    </li>
    <li>
      <a class="contact-intro__channel" href={`mailto:${email}`}>
        <i class="ph ph-envelope" aria-hidden="true"></i>
        <span class="contact-intro__channel-text"><strong>Email</strong><span>{email}</span></span>
      </a>
    </li>
  </ul>

  <p class="contact-intro__reply">
    <i class="ph ph-clock" aria-hidden="true"></i> We reply within 24 hours
  </p>
</div>

<style>
  .contact-intro {
    color: #ffffff;
    max-width: 560px;
  }

  .contact-intro__badge {
    background: rgba(15, 17, 21, 0.65);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .contact-intro h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    margin: 0.9rem 0 0.8rem;
  }

  .contact-intro__lead {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.86);
    margin: 0 0 1.4rem;
  }

  .contact-intro__channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .contact-intro__channel {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .contact-intro__channel:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.18);
  }

  .contact-intro__channel > i {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.3rem;
    background: rgba(255, 255, 255, 0.14);
  }

  /* Brand-orange primary channel: white text and icon only. */
  .contact-intro__channel--whatsapp {
    background: #ff5900;
    border-color: #ff5900;
  }

  .contact-intro__channel--whatsapp:hover {
    background: #e64f00;
  }

  .contact-intro__channel--whatsapp > i {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .contact-intro__channel-text {
    display: grid;
    gap: 0.1rem;
  }

  .contact-intro__channel-text strong {
    font-size: 1rem;
    color: #ffffff;
  }

  .contact-intro__channel-text span {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.82);
    overflow-wrap: anywhere;
  }

  .contact-intro__reply {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    /* Mobile: channels become compact buttons in a row. */
    .contact-intro__channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .contact-intro__channel {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 0.7rem 0.4rem;
      gap: 0.35rem;
    }

    .contact-intro__channel-text span {
      display: none;
    }
  }
</style>
