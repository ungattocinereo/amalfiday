---
import GalleryStudyControls from './GalleryStudyControls.astro'
import { photoStyle, type PhotoFrame, type PhotoHeading } from '../data/photoshoot-types'
interface Props {
  images: PhotoFrame[]
  number?: number
  name: string
  location: string
  eyebrow?: string
  heading?: PhotoHeading
}
const { images, number = 4, name, location, eyebrow = '04 / The whole picture', heading = { lead: 'A view', accent: 'to keep.' } } = Astro.props
---

<!-- Gallery 4: an optional, full-viewport treatment of the same sequence. -->
<section class="gs-immersive" id={`gs-chapter-${number}`} data-gallery="immersive" data-frame-indices={JSON.stringify(images.map(image => image.index))} data-active-fit={images[0].immersiveFit || 'cover'} aria-labelledby={`gs-title-${number}`} aria-roledescription="carousel">
  <div class="gs-immersive__viewport" tabindex="0" aria-label="Photographs. Swipe or use the arrow keys to browse.">
    {images.map((image, index) => (
      <figure class="gs-immersive__frame" data-fit={image.immersiveFit || 'cover'} style={photoStyle(image)} role="group" aria-roledescription="slide" aria-label={`Photograph ${index + 1} of ${images.length}`}>
        <img
          src={image.src}
          srcset={image.srcset}
          sizes={`max(100vw, ${(image.width / image.height * 100).toFixed(1)}svh)`}
          width={image.width}
          height={image.height}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </figure>
    ))}
  </div>
  <div class="gs-immersive__veil" aria-hidden="true"></div>
  <div class="gs-immersive__top">
    <span class="gs-eyebrow">{name} <span>/ {location}, Italy</span></span>
    <a class="gs-icon" data-immersive-open data-open-photo={images[0].index} href={images[0].original} aria-label="Open photograph 1 in full">
      <i class="fa-solid fa-expand" aria-hidden="true"></i>
    </a>
  </div>
  <div class="gs-immersive__overlay">
    <div class="gs-immersive__story">
      <span class="gs-eyebrow">{eyebrow}</span>
      <h2 id={`gs-title-${number}`}>{heading.lead}<br /> <em>{heading.accent}</em>{heading.tail && ` ${heading.tail}`}</h2>
      <p data-immersive-caption>{images[0].alt}</p>
    </div>
    <GalleryStudyControls label={eyebrow} images={images} />
  </div>
  <p class="sr-only" data-immersive-status aria-live="polite" aria-atomic="true"></p>
</section>
