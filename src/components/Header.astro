---
import { navigation, socialLinks, site } from '../data/site'
const headerSocials = socialLinks.filter((item) => ['Instagram', 'Facebook'].includes(item.label))
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (href?: string) => href === currentPath
const isWithin = (href?: string) => href && !href.includes('#') && (isCurrent(href) || currentPath.startsWith(`${href}/`))
const isActive = (item: (typeof navigation)[number]) =>
  isWithin(item.href) || item.dropdownSections?.some((section) => section.items.some((link) => isWithin(link.href)))
---

<header class="header" id="header">
  <div class="glass-bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
      <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
    </a>

    <div class="header__center">
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map((item) => item.dropdownSections?.length ? (
          <details class="nav-disclosure" data-desktop-disclosure>
            <summary class:list={['nav-link', { 'is-active': isActive(item) }]}>
              {item.label}<i class="fa-solid fa-chevron-down chevron" aria-hidden="true"></i>
            </summary>
            <div class="nav-sheet">
              <div class="nav-sheet__intro">
                <span class="eyebrow">Explore the coast</span>
                <span class="nav-sheet__title">{item.label}</span>
                {item.href && <a class="overview" href={item.href}>Discover all <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
              </div>
              <div class="nav-sheet__sections">
                {item.dropdownSections.map((section) => (
                  <div class="nav-section">
                    <span class="eyebrow">{section.heading}</span>
                    {section.items.map((link) => (
                      <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                        <i class={`fa-solid ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </details>
        ) : (
          <a class:list={['nav-link', { 'is-active': isActive(item) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header__connect">
        {headerSocials.map((item) => (
          <a class="icon-link" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.label} (opens in a new tab)`} title={item.label}>
            <i class={`fa-brands fa-${item.label.toLowerCase()}`} aria-hidden="true"></i>
          </a>
        ))}
        <a class="contact-link" href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </div>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
      <span class="menu-lines" aria-hidden="true"></span><span>Menu</span>
    </button>
    <button class="theme-button" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
      <i class="fa-regular fa-moon theme-moon" aria-hidden="true"></i><i class="fa-regular fa-sun theme-sun" aria-hidden="true"></i>
    </button>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation">
    <div class="mobile-menu__bar">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
        <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
      </a>
      <button class="menu-close" type="button" autofocus><i class="fa-solid fa-xmark" aria-hidden="true"></i> Close</button>
      <button class="theme-button" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
        <i class="fa-regular fa-moon theme-moon" aria-hidden="true"></i><i class="fa-regular fa-sun theme-sun" aria-hidden="true"></i>
      </button>
    </div>
    <div class="mobile-menu__body">
      <div class="mobile-menu__intro"><span class="eyebrow">Amalfi coast, your way</span><span class="mobile-menu__title">A little closer to paradise.</span></div>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a class="mobile-nav__link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="nav-number" aria-hidden="true">01</span><span>Home</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        {navigation.map((item, index) => item.dropdownSections?.length ? (
          <details class="mobile-disclosure">
            <summary class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="fa-solid fa-plus" aria-hidden="true"></i></summary>
            <div class="mobile-subnav">
              {item.href && <a class="overview" href={item.href}>Discover all {item.label.toLowerCase()} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
              {item.dropdownSections.map((section) => (
                <div class="nav-section">
                  <span class="eyebrow">{section.heading}</span>
                  {section.items.map((link) => <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><i class={`fa-solid ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span></a>)}
                </div>
              ))}
            </div>
          </details>
        ) : (
          <a class="mobile-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        ))}
      </nav>
      <div class="mobile-connect">
        <a class="mobile-contact" href="/contact"><span>Let’s plan your day</span><span>Get in touch <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span></a>
        <div class="mobile-socials">
          {headerSocials.map((item) => <a href={item.href} target="_blank" rel="noreferrer"><i class={`fa-brands fa-${item.label.toLowerCase()}`} aria-hidden="true"></i>{item.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
        </div>
      </div>
    </div>
  </dialog>
</header>

<script is:inline>
  ;(() => {
    const root = document.documentElement
    const header = document.getElementById('header')
    const themeButtons = header.querySelectorAll('[data-theme-toggle]')
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
    let storedTheme
    try { storedTheme = localStorage.getItem('theme') } catch {}
    let followSystem = storedTheme !== 'day' && storedTheme !== 'night'
    const setTheme = (theme) => {
      root.dataset.theme = theme
      window.__setBrowserThemeColor?.(theme)
      themeButtons.forEach((button) => {
        const label = `Switch to ${theme === 'night' ? 'light' : 'dark'} theme`
        button.setAttribute('aria-label', label)
        button.title = label
      })
    }
    setTheme(root.dataset.theme || (systemTheme.matches ? 'night' : 'day'))
    themeButtons.forEach((button) => button.addEventListener('click', () => {
      followSystem = false
      const theme = root.dataset.theme === 'night' ? 'day' : 'night'
      setTheme(theme)
      try { localStorage.setItem('theme', theme) } catch {}
    }))
    systemTheme.addEventListener('change', (event) => {
      if (followSystem) setTheme(event.matches ? 'night' : 'day')
    })

    const disclosures = [...header.querySelectorAll('[data-desktop-disclosure]')]
    const closeDisclosures = (except) => disclosures.forEach((details) => {
      if (details !== except) details.open = false
    })
    disclosures.forEach((details) => {
      details.querySelector('summary').addEventListener('click', () => closeDisclosures(details))
      details.addEventListener('focusout', (event) => {
        if (!details.contains(event.relatedTarget)) details.open = false
      })
    })
    document.addEventListener('click', (event) => {
      if (!disclosures.some((details) => details.contains(event.target))) closeDisclosures()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      const opened = disclosures.find((details) => details.open)
      if (opened) {
        opened.querySelector('summary').focus()
        closeDisclosures()
      }
    })

    const menu = header.querySelector('#mobile-menu')
    const menuToggle = header.querySelector('.menu-toggle')
    const desktop = window.matchMedia('(min-width: 1100px)')
    let previousOverflow = ''
    menuToggle.addEventListener('click', () => {
      closeDisclosures()
      previousOverflow = document.body.style.overflow
      menu.showModal()
      document.body.style.overflow = 'hidden'
      menuToggle.setAttribute('aria-expanded', 'true')
    })
    const closeMenu = () => menu.close()
    menu.querySelector('.menu-close').addEventListener('click', closeMenu)
    menu.addEventListener('click', (event) => {
      if (event.target === menu || event.target.closest('a')) closeMenu()
    })
    menu.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow
      menuToggle.setAttribute('aria-expanded', 'false')
      menu.querySelectorAll('details').forEach((details) => { details.open = false })
      if (desktop.matches) header.querySelector('.brand').focus({ preventScroll: true })
      else menuToggle.focus({ preventScroll: true })
    })
    desktop.addEventListener('change', () => {
      closeDisclosures()
      if (menu.open) closeMenu()
    })
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 16)
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  })()
</script>

<style>
  .header {
    --glass: rgba(255, 253, 249, 0.82);
    --glass-solid: #fffdf9;
    --glass-line: rgba(43, 39, 33, 0.15);
    --glass-ink: #292822;
    --glass-muted: #67645c;
    --glass-hover: rgba(140, 116, 77, 0.09);
    --glass-accent: #a93c0b;
    position: fixed;
    z-index: 30;
    top: max(16px, env(safe-area-inset-top));
    inset-inline: 24px;
    color: var(--glass-ink);
  }
  :global([data-theme='night']) .header {
    --glass: rgba(22, 26, 29, 0.84);
    --glass-solid: #161a1d;
    --glass-line: rgba(255, 246, 230, 0.18);
    --glass-ink: #f6f1e8;
    --glass-muted: #b9b6ae;
    --glass-hover: rgba(255, 244, 220, 0.08);
    --glass-accent: #ffac77;
  }
  .glass-bar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(174px, 1fr) auto minmax(174px, 1fr);
    align-items: center;
    gap: 20px;
    min-height: 76px;
    padding: 10px 24px;
    border: 1px solid var(--glass-line);
    border-radius: 5px;
    background: var(--glass);
    backdrop-filter: blur(24px) saturate(135%);
    -webkit-backdrop-filter: blur(24px) saturate(135%);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.24), 0 8px 32px rgba(22, 25, 27, 0.07);
    transition: background 180ms, box-shadow 180ms;
  }
  .is-scrolled .glass-bar { box-shadow: inset 0 1px rgba(255, 255, 255, 0.18), 0 8px 32px rgba(22, 25, 27, 0.14); }
  .header a, .header button, .header summary { -webkit-tap-highlight-color: transparent; }
  .header a:hover { text-decoration: none; }
  .header :is(a, button, summary):focus-visible { outline: 2px solid var(--glass-accent); outline-offset: 4px; border-radius: 3px; }
  .brand { display: inline-flex; align-items: center; justify-self: start; min-height: 44px; }
  .brand img { width: 170px; height: auto; }
  .brand__night { display: none; }
  :global([data-theme='night']) .brand__day { display: none; }
  :global([data-theme='night']) .brand__night { display: block; }
  .header__center, .desktop-nav, .header__connect { display: flex; align-items: center; }
  .desktop-nav { gap: 4px; }
  .header__connect { gap: 0; margin-left: 17px; padding-left: 17px; border-left: 1px solid var(--glass-line); }
  .nav-link { position: relative; display: flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 12px; color: var(--glass-ink); font-size: 14px; font-weight: 500; white-space: nowrap; cursor: pointer; }
  .nav-link::after { content: ''; position: absolute; height: 1px; bottom: 3px; left: 12px; right: 12px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 180ms; }
  .nav-link:hover::after, .nav-link.is-active::after, details[open] > .nav-link::after { transform: scaleX(1); }
  .nav-link:hover, .nav-link.is-active, .contact-link:hover { color: var(--glass-accent); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .chevron { font-size: 8px; color: var(--glass-muted); transition: transform 180ms; }
  details[open] > summary .chevron { transform: rotate(180deg); }
  .icon-link, .theme-button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--glass-ink); border-radius: 3px; font-size: 17px; }
  .icon-link:hover, .theme-button:hover, .menu-toggle:hover, .menu-close:hover { color: var(--glass-ink); background: var(--glass-hover); }
  .contact-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-left: 10px; color: var(--glass-ink); font-size: 14px; font-weight: 500; }
  .contact-link i { font-size: 10px; color: var(--glass-accent); }
  .theme-button { justify-self: end; border: 1px solid var(--glass-line); background: transparent; cursor: pointer; }
  .theme-sun { display: none; }
  :global([data-theme='night']) .theme-moon { display: none; }
  :global([data-theme='night']) .theme-sun { display: inline-block; }
  .nav-sheet { position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); width: min(720px, calc(100vw - 64px)); max-height: calc(100dvh - 130px); overflow-y: auto; display: grid; grid-template-columns: 190px 1fr; padding: 26px; gap: 28px; border: 1px solid var(--glass-line); border-radius: 5px; background: var(--glass-solid); color: var(--glass-ink); box-shadow: 0 18px 50px rgba(10, 20, 25, 0.18); animation: reveal 180ms ease-out; }
  .nav-sheet__intro { display: flex; flex-direction: column; align-items: flex-start; padding-right: 20px; border-right: 1px solid var(--glass-line); }
  .eyebrow { display: block; font-family: var(--font-mono); font-size: 9px; line-height: 1.6; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--glass-muted); }
  .nav-sheet__title { margin: 15px 0 24px; font-family: var(--font-display); font-size: 25px; line-height: 1.35; }
  .overview { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--glass-accent); font-size: 13px; font-weight: 500; }
  .overview:hover { color: var(--glass-ink); }
  .overview i { font-size: 10px; }
  .nav-section + .nav-section { margin-top: 16px; }
  .nav-section > .eyebrow { padding: 0 10px 5px; }
  .sub-link { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px; color: var(--glass-ink); font-size: 14px; line-height: 1.4; border-radius: 3px; }
  .sub-link i { width: 18px; flex-shrink: 0; color: var(--glass-muted); text-align: center; font-size: 14px; }
  .sub-link:hover, .sub-link[aria-current='page'] { background: var(--glass-hover); color: var(--glass-accent); }
  .menu-toggle, .menu-close { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 0 12px; background: none; color: var(--glass-ink); border: 0; font: 500 13px var(--font-body); cursor: pointer; }
  .menu-toggle { display: none; }
  .menu-lines { width: 17px; height: 8px; border-block: 1px solid currentColor; }
  .mobile-menu { position: fixed; inset: 8px; width: calc(100% - 16px); max-width: 640px; height: calc(100% - 16px); height: calc(100dvh - 16px); max-height: none; margin: 0 auto; padding: 0; border: 1px solid var(--glass-line); border-radius: 5px; color: var(--glass-ink); background: var(--glass-solid); overflow: clip; }
  .mobile-menu[open] { display: flex; flex-direction: column; animation: reveal 200ms ease-out; }
  .mobile-menu::backdrop { background: rgba(12, 20, 25, 0.46); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .mobile-menu__bar { position: sticky; top: 0; z-index: 1; background: var(--glass-solid); flex-shrink: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 68px; padding: 10px 14px; padding-top: max(10px, env(safe-area-inset-top)); border-bottom: 1px solid var(--glass-line); }
  .mobile-menu__body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 28px 24px max(24px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; flex: 1; }
  .mobile-menu__body > * { flex-shrink: 0; }
  .mobile-menu__intro { margin-bottom: 24px; }
  .mobile-menu__title { display: block; margin-top: 9px; font-family: var(--font-display); font-style: italic; font-size: 17px; line-height: 1.6; }
  .mobile-nav { border-top: 1px solid var(--glass-line); }
  .mobile-nav > * { border-bottom: 1px solid var(--glass-line); }
  .mobile-nav__link { display: grid; grid-template-columns: 24px 1fr 20px; align-items: center; gap: 12px; min-height: 72px; color: var(--glass-ink); font-family: var(--font-display); font-size: 23px; cursor: pointer; }
  .mobile-nav__link:hover, .mobile-nav__link.is-active, .mobile-nav__link[aria-current='page'] { color: var(--glass-accent); }
  .nav-number { font: 10px var(--font-mono); color: var(--glass-muted); }
  .mobile-nav__link > i { justify-self: end; font-size: 13px; transition: transform 180ms; }
  .mobile-disclosure[open] > summary > i { transform: rotate(45deg); }
  .mobile-subnav { padding: 0 0 20px 26px; }
  .mobile-subnav > .overview { margin: 0 10px 14px; }
  .mobile-connect { margin-top: auto; padding-top: 30px; }
  .mobile-contact { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 1px solid var(--glass-line); border-radius: 3px; background: var(--glass-hover); color: var(--glass-ink); }
  .mobile-contact > span:first-child { font: 10px var(--font-mono); color: var(--glass-muted); }
  .mobile-contact > span:last-child { display: flex; justify-content: space-between; align-items: center; font-size: 18px; }
  .mobile-contact i { color: var(--glass-accent); font-size: 13px; }
  .mobile-contact:hover { color: var(--glass-accent); }
  .mobile-socials { display: flex; justify-content: center; gap: 28px; margin-top: 14px; }
  .mobile-socials a { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; color: var(--glass-ink); font-size: 12px; }
  .mobile-socials i { font-size: 18px; }
  @keyframes reveal { from { opacity: 0; margin-top: -5px; } to { opacity: 1; margin-top: 0; } }
  @media (max-width: 1099px) {
    .header { inset-inline: 12px; top: max(10px, env(safe-area-inset-top)); }
    .glass-bar { grid-template-columns: 1fr auto 1fr; min-height: 66px; gap: 12px; padding: 10px 14px; }
    .brand img { width: 132px; }
    .header__center { display: none; }
    .menu-toggle { display: flex; }
  }
  @media (max-width: 380px) {
    .header { inset-inline: 8px; }
    .glass-bar, .mobile-menu__bar { padding-inline: 10px; gap: 6px; }
    .brand img { width: 110px; }
    .menu-toggle, .menu-close { gap: 7px; padding-inline: 8px; }
    .mobile-menu__body { padding-inline: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header *, .header *::after { transition: none !important; animation: none !important; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-bar { background: var(--glass-solid); }
  }
</style>
