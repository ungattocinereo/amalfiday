---
// Header shell: glass bar, logo morph, theme, collapse on scroll and light/dark
// lettering that follows the page underneath. Menus live in ./nav/.
import { navCta, site } from '../data/site'
import MorphingLogo from './MorphingLogo.astro'
import DesktopNav from './nav/DesktopNav.astro'
import MobileNav from './nav/MobileNav.astro'

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const ctaCurrent = currentPath === navCta.href.replace(/\/$/, '')
---

<header class="header" id="header" data-home={currentPath === '/' ? '' : undefined}>
  <div class="glass-bar">
    <span class="glass-bar__edge" aria-hidden="true"></span>
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <MorphingLogo />
    </a>

    <DesktopNav currentPath={currentPath} />
    <MobileNav currentPath={currentPath} />

    <div class="actions">
      <a class="cta" href={navCta.href} aria-current={ctaCurrent ? 'page' : undefined}>
        <i class={`ph-fill ${navCta.icon}`} aria-hidden="true"></i> {navCta.label}
      </a>
      <button class="theme" type="button" role="switch" data-theme-toggle aria-label="Dark mode" aria-checked="false" title="Switch to dark theme">
        <i class="ph ph-sun theme__sun" aria-hidden="true"></i>
        <i class="ph ph-moon theme__moon" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<script>
  import { initHeader } from '../scripts/nav/header.mjs'
  const header = document.getElementById('header')
  if (header) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => initHeader(header), { once: true })
    else initHeader(header)
  }
</script>

<style>
  /* Popup panels follow the chosen theme; the bar follows the page below it. */
  .header {
    --accent: #FF5900;
    --pop-bg: rgba(255, 255, 255, 0.94);
    --pop-solid: #ffffff;
    --pop-ink: #141414;
    --pop-muted: #6b6b6b;
    --pop-line: rgba(20, 20, 20, 0.1);
    --pop-hover: rgba(20, 20, 20, 0.06);
    --morph: 460ms;
    --morph-ease: cubic-bezier(0.33, 1, 0.68, 1);
    position: fixed;
    z-index: 30;
    top: 0;
    inset-inline: 0;
    padding: max(14px, env(safe-area-inset-top)) max(var(--page-gutter), env(safe-area-inset-right)) 0 max(var(--page-gutter), env(safe-area-inset-left));
    transition: padding-top var(--morph) var(--morph-ease);
  }
  :global([data-theme='night']) .header {
    --pop-bg: rgba(20, 23, 27, 0.93);
    --pop-solid: #14171b;
    --pop-ink: #ffffff;
    --pop-muted: #a9adb5;
    --pop-line: rgba(255, 255, 255, 0.12);
    --pop-hover: rgba(255, 255, 255, 0.08);
  }
  .header.is-scrolled { padding-top: max(10px, env(safe-area-inset-top)); }

  /* Bar lettering and glass. Light by default, dark over dark sections and the home hero. */
  .glass-bar {
    --bar-ink: #141414;
    --bar-hover: rgba(20, 20, 20, 0.06);
    --bar-glass: rgba(255, 255, 255, 0.62);
    --bar-glass-strong: rgba(255, 255, 255, 0.8);
    --bar-line: rgba(20, 20, 20, 0.1);
    --bar-sheen: rgba(255, 255, 255, 0.35);
    --bar-solid: #ffffff;
  }
  .glass-bar[data-surface='dark'],
  :global([data-theme='night']) .glass-bar:not([data-surface]),
  .header[data-home]:not(.is-scrolled) .glass-bar {
    --bar-ink: #ffffff;
    --bar-hover: rgba(255, 255, 255, 0.14);
    --bar-glass: rgba(14, 17, 21, 0.26);
    --bar-glass-strong: rgba(18, 21, 25, 0.62);
    --bar-line: rgba(255, 255, 255, 0.16);
    --bar-sheen: rgba(255, 255, 255, 0.12);
    --bar-solid: #14171b;
  }

  .glass-bar {
    box-sizing: border-box;
    position: relative;
    isolation: isolate;
    width: min(var(--content-max), 100%);
    height: 64px;
    margin: 0 auto;
    padding: 0 10px 0 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--bar-line);
    border-radius: 999px;
    color: var(--bar-ink);
    transition: width var(--morph) var(--morph-ease), height var(--morph) var(--morph-ease), padding var(--morph) var(--morph-ease), border-color 0.3s ease, color 0.2s ease;
  }
  /* The glass lives on a pseudo-element so the bar is not a backdrop root for the menu popup. */
  .glass-bar::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: var(--bar-glass);
    box-shadow: 0 8px 30px rgba(10, 20, 30, 0.08), inset 0 1px 0 var(--bar-sheen);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .is-scrolled .glass-bar::before {
    background: var(--bar-glass-strong);
    box-shadow: 0 10px 34px rgba(10, 20, 30, 0.14), inset 0 1px 0 var(--bar-sheen);
  }
  /* A masked light reflection follows the perimeter once the bar is a capsule. */
  .glass-bar__edge {
    display: none;
    position: absolute;
    inset: -1px;
    z-index: 1;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.12) 24%, rgba(255, 255, 255, 0.03) 46%, rgba(255, 255, 255, 0.24) 74%, rgba(255, 255, 255, 0.7));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    transition: opacity 320ms ease;
  }
  @supports (mask-composite: exclude) or (-webkit-mask-composite: xor) {
    .glass-bar__edge { display: block; }
  }
  .is-scrolled .glass-bar__edge { opacity: 0.8; }

  .header a, .header button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .header a:hover { text-decoration: none; }

  .brand { flex-shrink: 0; position: relative; display: block; width: 150px; height: 44px; color: var(--bar-ink); transition: width var(--morph) var(--morph-ease); }
  .brand:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 4px; }

  .actions { flex-shrink: 0; display: flex; align-items: center; gap: 6px; }
  .cta {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px;
    white-space: nowrap; background: var(--accent); color: #fff; font: 600 14px/1 var(--font-body); text-decoration: none;
    transition: height var(--morph) var(--morph-ease), padding var(--morph) var(--morph-ease), background 0.18s, transform 0.18s;
  }
  .cta:hover { text-decoration: none; color: #fff; background: color-mix(in srgb, var(--accent) 90%, #000); transform: translateY(-1px); }
  .cta:focus-visible { outline: 2px solid var(--bar-ink); outline-offset: 3px; }
  .theme {
    position: relative; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 999px;
    background: transparent; color: var(--bar-ink); font-size: 18px; cursor: pointer;
    transition: width var(--morph) var(--morph-ease), height var(--morph) var(--morph-ease), background 0.18s;
  }
  .theme:hover { background: var(--bar-hover); }
  .theme:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .theme > i { grid-area: 1 / 1; transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .theme__moon { opacity: 0; transform: rotate(-40deg) scale(0.7); }
  :global([data-theme='night']) .theme__sun { opacity: 0; transform: rotate(40deg) scale(0.7); }
  :global([data-theme='night']) .theme__moon { opacity: 1; transform: none; }

  @media (min-width: 1100px) {
    /* Collapsed: the bar shrinks horizontally around its contents and the wordmark morphs into the monogram. */
    .is-scrolled .glass-bar { width: var(--compact-w, 760px); height: 54px; padding: 0 6px 0 10px; }
    .is-scrolled .brand { width: 38px; }
    .is-scrolled .cta { height: 40px; padding: 0 16px; }
    .is-scrolled .theme { width: 40px; height: 40px; }
  }
  @media (max-width: 1099px) {
    .glass-bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); height: 56px; padding: 0 6px 0 16px; }
    .brand { width: 112px; }
    .is-scrolled .brand { width: 44px; }
    .actions { justify-self: end; }
    .cta { display: none; }
  }
  @media (max-width: 480px) {
    .brand { width: 104px; }
  }

  .header:not([data-surface-ready]), .header:not([data-surface-ready]) *, .header:not([data-surface-ready]) *::before, .header:not([data-surface-ready]) *::after { transition: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .header, .glass-bar, .glass-bar::before, .brand, .cta, .theme, .theme > i { transition: none !important; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .glass-bar::before { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--bar-solid); }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-bar::before { background: var(--bar-glass-strong); }
  }
</style>
