---
import { navigation, socialLinks, site } from '../data/site'
const headerSocials = socialLinks.filter((item) => ['Instagram', 'Facebook'].includes(item.label))
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (href?: string) => href === currentPath
const isWithin = (href?: string) => href && !href.includes('#') && (isCurrent(href) || currentPath.startsWith(`${href}/`))
const isActive = (item: (typeof navigation)[number]) =>
  isWithin(item.href) || item.dropdownSections?.some((section) => section.items.some((link) => isWithin(link.href)))
---

<header class="header" id="header">
  <div class="glass-bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
      <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
    </a>

    <div class="header__center">
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map((item) => item.dropdownSections?.length ? (
          <details class="nav-disclosure" data-desktop-disclosure>
            <summary class:list={['nav-link', { 'is-active': isActive(item) }]}>
              {item.label}<i class="fa-solid fa-chevron-down chevron" aria-hidden="true"></i>
            </summary>
            <div class="nav-sheet">
              <div class="nav-sheet__intro">
                <span class="eyebrow">Explore the coast</span>
                <span class="nav-sheet__title">{item.label}</span>
                {item.href && <a class="overview" href={item.href}>Discover all <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
              </div>
              <div class="nav-sheet__sections">
                {item.dropdownSections.map((section) => (
                  <div class="nav-section">
                    <span class="eyebrow">{section.heading}</span>
                    {section.items.map((link) => (
                      <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                        <i class={`fa-solid ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </details>
        ) : (
          <a class:list={['nav-link', { 'is-active': isActive(item) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header__connect">
        {headerSocials.map((item) => (
          <a class="icon-link" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.label} (opens in a new tab)`} title={item.label}>
            <i class={`fa-brands fa-${item.label.toLowerCase()}`} aria-hidden="true"></i>
          </a>
        ))}
        <a class="contact-link" href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </div>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
      <span class="menu-lines" aria-hidden="true"></span><span>Menu</span>
    </button>
    <button class="theme-button" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
      <i class="fa-regular fa-moon theme-moon" aria-hidden="true"></i><i class="fa-regular fa-sun theme-sun" aria-hidden="true"></i>
    </button>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation">
    <div class="mobile-menu__bar">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
        <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
      </a>
      <button class="menu-close" type="button" autofocus><i class="fa-solid fa-xmark" aria-hidden="true"></i> Close</button>
      <button class="theme-button" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
        <i class="fa-regular fa-moon theme-moon" aria-hidden="true"></i><i class="fa-regular fa-sun theme-sun" aria-hidden="true"></i>
      </button>
    </div>
    <div class="mobile-menu__body">
      <div class="mobile-menu__intro"><span class="eyebrow">Amalfi coast, your way</span><span class="mobile-menu__title">A little closer to paradise.</span></div>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a class="mobile-nav__link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="nav-number" aria-hidden="true">01</span><span>Home</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        {navigation.map((item, index) => item.dropdownSections?.length ? (
          <details class="mobile-disclosure">
            <summary class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="fa-solid fa-plus" aria-hidden="true"></i></summary>
            <div class="mobile-subnav">
              {item.href && <a class="overview" href={item.href}>Discover all {item.label.toLowerCase()} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
              {item.dropdownSections.map((section) => (
                <div class="nav-section">
                  <span class="eyebrow">{section.heading}</span>
                  {section.items.map((link) => <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><i class={`fa-solid ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span></a>)}
                </div>
              ))}
            </div>
          </details>
        ) : (
          <a class="mobile-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        ))}
      </nav>
      <div class="mobile-connect">
        <a class="mobile-contact" href="/contact"><span>Let’s plan your day</span><span>Get in touch <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span></a>
        <div class="mobile-socials">
          {headerSocials.map((item) => <a href={item.href} target="_blank" rel="noreferrer"><i class={`fa-brands fa-${item.label.toLowerCase()}`} aria-hidden="true"></i>{item.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
        </div>
      </div>
    </div>
  </dialog>
</header>

<script is:inline>
  ;(() => {
    const root = document.documentElement
    const header = document.getElementById('header')
    const themeButtons = header.querySelectorAll('[data-theme-toggle]')
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
    let storedTheme
    try { storedTheme = localStorage.getItem('theme') } catch {}
    let followSystem = storedTheme !== 'day' && storedTheme !== 'night'
    const setTheme = (theme) => {
      root.dataset.theme = theme
      window.__setBrowserThemeColor?.(theme)
      themeButtons.forEach((button) => {
        const label = `Switch to ${theme === 'night' ? 'light' : 'dark'} theme`
        button.setAttribute('aria-label', label)
        button.title = label
      })
    }
    setTheme(root.dataset.theme || (systemTheme.matches ? 'night' : 'day'))
    themeButtons.forEach((button) => button.addEventListener('click', () => {
      followSystem = false
      const theme = root.dataset.theme === 'night' ? 'day' : 'night'
      setTheme(theme)
      try { localStorage.setItem('theme', theme) } catch {}
    }))
    systemTheme.addEventListener('change', (event) => {
      if (followSystem) setTheme(event.matches ? 'night' : 'day')
    })

    const disclosures = [...header.querySelectorAll('[data-desktop-disclosure]')]
    const closeDisclosures = (except) => disclosures.forEach((details) => {
      if (details !== except) details.open = false
    })
    disclosures.forEach((details) => {
      details.querySelector('summary').addEventListener('click', () => closeDisclosures(details))
      details.addEventListener('focusout', (event) => {
        if (!details.contains(event.relatedTarget)) details.open = false
      })
    })
    document.addEventListener('click', (event) => {
      if (!disclosures.some((details) => details.contains(event.target))) closeDisclosures()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      const opened = disclosures.find((details) => details.open)
      if (opened) {
        opened.querySelector('summary').focus()
        closeDisclosures()
      }
    })

    const menu = header.querySelector('#mobile-menu')
    const menuToggle = header.querySelector('.menu-toggle')
    const desktop = window.matchMedia('(min-width: 1100px)')
    let previousOverflow = ''
    menuToggle.addEventListener('click', () => {
      closeDisclosures()
      previousOverflow = document.body.style.overflow
      menu.showModal()
      menu.querySelector('.mobile-menu__body').scrollTop = 0
      document.body.style.overflow = 'hidden'
      menuToggle.setAttribute('aria-expanded', 'true')
    })
    const closeMenu = () => menu.close()
    menu.querySelector('.menu-close').addEventListener('click', closeMenu)
    menu.addEventListener('click', (event) => {
      if (event.target === menu || event.target.closest('a')) closeMenu()
    })
    menu.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow
      menuToggle.setAttribute('aria-expanded', 'false')
      menu.querySelectorAll('details').forEach((details) => { details.open = false })
      if (desktop.matches) header.querySelector('.brand').focus({ preventScroll: true })
      else menuToggle.focus({ preventScroll: true })
    })
    desktop.addEventListener('change', () => {
      closeDisclosures()
      if (menu.open) closeMenu()
    })
    // Read the sections behind the fixed bar, ignoring the navigation itself.
    // Photo heroes already declare their dark treatment; a matching glass tint
    // keeps white lettering readable even over highlights in the photograph.
    const bar = header.querySelector('.glass-bar')
    const parseColor = (value) => {
      const channels = value.match(/[\d.]+/g)?.map(Number)
      return value.startsWith('rgb') && channels?.length >= 3
        ? [...channels.slice(0, 3), channels[3] ?? 1]
        : [0, 0, 0, 0]
    }
    const over = (front, back) => [
      ...front.slice(0, 3).map((channel, index) => channel * front[3] + back[index] * (1 - front[3])),
      1,
    ]
    const luminance = (color) => color.slice(0, 3).reduce((total, channel, index) => {
      const value = channel / 255
      const linear = value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4
      return total + linear * [0.2126, 0.7152, 0.0722][index]
    }, 0)
    const sectionTone = (section) => {
      const declared = section.closest('[data-nav-surface]')?.dataset.navSurface
      if (declared === 'dark' || declared === 'light') return declared
      if (section.closest('.hero--dark')) return 'dark'
      const layers = []
      for (let element = section; element; element = element.parentElement) {
        const style = getComputedStyle(element)
        let color = parseColor(style.backgroundColor)
        // Gradients in the site's sections use sRGB colors. Their average gives
        // a stable section tone instead of flickering as small details pass by.
        if (style.backgroundImage.includes('gradient(') && !style.backgroundImage.includes('url(')) {
          const stops = [...style.backgroundImage.matchAll(/rgba?\([^)]+\)/g)].map((match) => parseColor(match[0]))
          if (stops.length) {
            const average = [0, 1, 2, 3].map((index) => stops.reduce((sum, stop) => sum + stop[index], 0) / stops.length)
            // Preserve transparency so the ancestors still contribute.
            const alpha = average[3] + color[3] * (1 - average[3])
            if (alpha) color = [...average.slice(0, 3).map((v, i) => (v * average[3] + color[i] * color[3] * (1 - average[3])) / alpha), alpha]
          }
        }
        layers.push(color)
        if (color[3] >= 1) break
      }
      const fallback = root.dataset.theme === 'night' ? [15, 17, 21, 1] : [255, 255, 255, 1]
      const background = layers.reverse().reduce((back, front) => over(front, back), fallback)
      return luminance(background) < 0.18 ? 'dark' : 'light'
    }
    let scheduled = false
    const updateSurface = () => {
      scheduled = false
      if (menu.open) return
      header.classList.toggle('is-scrolled', window.scrollY > 16)
      const y = Math.min(bar.getBoundingClientRect().height / 2, window.innerHeight - 1)
      const tones = [0.12, 0.5, 0.88].map((position) => {
        const underneath = document.elementsFromPoint(window.innerWidth * position, y)
          .find((element) => !header.contains(element) && element.closest('main, footer, .prefooter'))
        const section = underneath?.closest('section, footer, article, main') || document.body
        return sectionTone(section)
      })
      const surface = tones.filter((tone) => tone === 'dark').length >= 2 ? 'dark' : 'light'
      if (bar.dataset.surface !== surface) bar.dataset.surface = surface
    }
    const scheduleSurface = () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(updateSurface)
    }
    window.addEventListener('scroll', scheduleSurface, { passive: true })
    window.addEventListener('resize', scheduleSurface, { passive: true })
    window.addEventListener('pageshow', scheduleSurface)
    window.addEventListener('load', scheduleSurface, { once: true })
    menu.addEventListener('close', scheduleSurface)
    let themeSettleTimer
    new MutationObserver(() => {
      scheduleSurface()
      clearTimeout(themeSettleTimer)
      themeSettleTimer = setTimeout(scheduleSurface, 350)
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] })
    const initSurface = () => {
      updateSurface()
      requestAnimationFrame(() => { header.dataset.surfaceReady = '' })
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSurface, { once: true })
    else initSurface()
  })()
</script>

<style>
  /* Panels follow the chosen theme. The bar independently follows the page below. */
  .header, .nav-sheet, .mobile-menu {
    --glass: rgba(255, 255, 255, 0.82);
    --glass-solid: #ffffff;
    --glass-line: rgba(20, 20, 20, 0.12);
    --glass-ink: #141414;
    --glass-muted: #626262;
    --glass-hover: rgba(255, 89, 0, 0.09);
    --glass-accent: #FF5900;
    --day-logo: block;
    --night-logo: none;
  }
  :global([data-theme='night']) :is(.header, .nav-sheet, .mobile-menu) {
    --glass: rgba(13, 16, 19, 0.86);
    --glass-solid: #111417;
    --glass-line: rgba(255, 255, 255, 0.15);
    --glass-ink: #ffffff;
    --glass-muted: #b8b8b8;
    --glass-hover: rgba(255, 89, 0, 0.13);
    --day-logo: none;
    --night-logo: block;
  }
  .header {
    position: fixed;
    z-index: 30;
    top: 0;
    inset-inline: 0;
    isolation: isolate;
    color: var(--glass-ink);
  }
  .glass-bar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    min-height: 88px;
    padding: 16px max(32px, env(safe-area-inset-right)) 16px max(32px, env(safe-area-inset-left));
    padding-top: max(16px, env(safe-area-inset-top));
    border: 0;
    border-radius: 0;
    color: var(--glass-ink);
    transition: min-height 200ms ease, padding-block 200ms ease, color 160ms ease;
  }
  .glass-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--glass);
    backdrop-filter: blur(22px) saturate(125%);
    -webkit-backdrop-filter: blur(22px) saturate(125%);
    transition: background 180ms ease;
    pointer-events: none;
  }
  .glass-bar[data-surface='light'] {
    --glass: rgba(255, 255, 255, 0.82);
    --glass-solid: #ffffff;
    --glass-line: rgba(20, 20, 20, 0.12);
    --glass-ink: #141414;
    --glass-muted: #626262;
    --glass-hover: rgba(255, 89, 0, 0.09);
    --day-logo: block;
    --night-logo: none;
  }
  .glass-bar[data-surface='dark'] {
    --glass: rgba(9, 12, 15, 0.72);
    --glass-solid: #111417;
    --glass-line: rgba(255, 255, 255, 0.15);
    --glass-ink: #ffffff;
    --glass-muted: #b8b8b8;
    --glass-hover: rgba(255, 89, 0, 0.13);
    --day-logo: none;
    --night-logo: block;
  }
  .is-scrolled .glass-bar { min-height: 72px; padding-block: max(8px, env(safe-area-inset-top)) 8px; }
  .is-scrolled .glass-bar[data-surface='light'] { --glass: rgba(255, 255, 255, 0.92); }
  .is-scrolled .glass-bar[data-surface='dark'] { --glass: rgba(9, 12, 15, 0.9); }
  .header a, .header button, .header summary { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .header a:hover { text-decoration: none; }
  .header :is(a, button, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 3px; }
  .brand { display: inline-flex; align-items: center; justify-self: start; min-width: 0; min-height: 44px; max-width: 100%; }
  .brand img { width: 176px; height: auto; }
  .brand__day { display: var(--day-logo); }
  .brand__night { display: var(--night-logo); }
  .header__center, .desktop-nav, .header__connect { display: flex; align-items: center; }
  .header__center { justify-self: center; }
  .desktop-nav { gap: 8px; }
  .header__connect { gap: 2px; margin-left: 20px; padding-left: 20px; border-left: 1px solid var(--glass-line); }
  .nav-link { position: relative; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 0 14px; border-radius: 4px; color: var(--glass-ink); font-size: 15px; font-weight: 500; white-space: nowrap; cursor: pointer; transition: background 160ms ease; }
  .nav-link::after { content: ''; position: absolute; height: 2px; bottom: 3px; left: 14px; right: 14px; background: var(--glass-accent); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .nav-link.is-active::after, details[open] > .nav-link::after { transform: scaleX(1); }
  .nav-link.is-active, details[open] > .nav-link { background: var(--glass-hover); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .chevron { font-size: 9px; transition: transform 180ms ease; }
  details[open] > summary .chevron { transform: rotate(180deg); }
  .icon-link, .theme-button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--glass-ink); border-radius: 4px; font-size: 18px; transition: background 160ms ease, color 160ms ease, transform 180ms ease; }
  .contact-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding-inline: 12px; margin-left: 8px; border-radius: 4px; color: var(--glass-ink); font-size: 15px; font-weight: 500; transition: background 160ms ease; }
  .contact-link i { font-size: 11px; transition: transform 180ms ease; }
  .contact-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--glass-accent); text-underline-offset: 9px; text-decoration-thickness: 2px; }
  .theme-button { justify-self: end; border: 0; background: transparent; cursor: pointer; }
  .theme-sun { display: none; }
  :global([data-theme='night']) .theme-moon { display: none; }
  :global([data-theme='night']) .theme-sun { display: inline-block; }
  .nav-sheet { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); width: min(760px, calc(100vw - 64px)); max-height: calc(100dvh - 100px); overflow-y: auto; display: grid; grid-template-columns: 190px 1fr; padding: 32px; gap: 28px; border: 0; border-radius: 0 0 6px 6px; background: var(--glass-solid); color: var(--glass-ink); box-shadow: 0 22px 45px rgba(10, 20, 25, 0.12); animation: reveal 180ms ease-out; }
  .nav-sheet__intro { display: flex; flex-direction: column; align-items: flex-start; padding-right: 20px; border-right: 1px solid var(--glass-line); }
  .eyebrow { display: block; font-family: var(--font-mono); font-size: 10px; line-height: 1.6; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--glass-muted); }
  .nav-sheet__title { margin: 15px 0 24px; font-family: var(--font-display); font-size: 25px; line-height: 1.35; }
  .overview { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--glass-ink); font-size: 13px; font-weight: 500; text-decoration: underline; text-decoration-color: var(--glass-accent); text-underline-offset: 6px; }
  .overview:hover { color: var(--glass-ink); text-decoration: underline !important; text-decoration-color: var(--glass-accent); }
  .overview i { font-size: 10px; color: var(--glass-accent); }
  .nav-section + .nav-section { margin-top: 16px; }
  .nav-section > .eyebrow { padding: 0 10px 5px; }
  .sub-link { display: flex; align-items: center; gap: 12px; min-height: 46px; padding: 10px; color: var(--glass-ink); font-size: 14px; line-height: 1.4; border-radius: 3px; transition: background 160ms ease; }
  .sub-link i { width: 18px; flex-shrink: 0; color: var(--glass-muted); text-align: center; font-size: 14px; }
  .sub-link:hover, .sub-link[aria-current='page'] { background: var(--glass-hover); color: var(--glass-ink); }
  .sub-link:hover i, .sub-link[aria-current='page'] i { color: var(--glass-accent); }
  .menu-toggle, .menu-close { display: flex; align-items: center; justify-content: center; justify-self: center; gap: 12px; min-height: 44px; padding: 0 16px; background: var(--glass-hover); color: var(--glass-ink); border: 0; border-radius: 4px; font: 500 14px var(--font-body); cursor: pointer; transition: background 180ms ease, color 180ms ease, transform 180ms ease; }
  .menu-toggle { display: none; }
  .menu-lines { position: relative; width: 20px; height: 14px; }
  .menu-lines::before, .menu-lines::after { content: ''; position: absolute; left: 0; height: 2px; background: var(--glass-accent); transition: width 180ms ease, background 180ms ease; }
  .menu-lines::before { width: 20px; top: 3px; }
  .menu-lines::after { width: 12px; bottom: 3px; }
  .menu-close i { color: var(--glass-accent); transition: transform 180ms ease; }
  .menu-toggle:active, .menu-close:active, .theme-button:active { transform: scale(0.96); }
  .mobile-menu { position: fixed; inset: 0; width: 100%; max-width: 640px; height: 100%; height: 100dvh; max-height: none; margin: 0 auto; padding: 0; border: 0; border-radius: 0; color: var(--glass-ink); background: var(--glass-solid); overflow: clip; }
  .mobile-menu[open] { display: flex; flex-direction: column; animation: reveal 200ms ease-out; }
  .mobile-menu::backdrop { background: rgba(12, 20, 25, 0.46); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .mobile-menu__bar { position: sticky; top: 0; z-index: 1; background: var(--glass-solid); flex-shrink: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: center; min-height: 76px; padding: 12px max(20px, env(safe-area-inset-right)) 12px max(20px, env(safe-area-inset-left)); padding-top: max(12px, env(safe-area-inset-top)); }
  .mobile-menu__body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 28px max(24px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left)); display: flex; flex-direction: column; flex: 1; }
  .mobile-menu__body > * { flex-shrink: 0; }
  .mobile-menu__intro { margin-bottom: 24px; }
  .mobile-menu__title { display: block; margin-top: 9px; font-family: var(--font-display); font-style: italic; font-size: 17px; line-height: 1.6; }
