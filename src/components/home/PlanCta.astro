<section class="plan-cta" aria-labelledby="plan-cta-title">
  <div class="container plan-cta__inner">
    <h2 id="plan-cta-title">Plan your <span class="accent-italic">day</span></h2>
    <p>Tell us when you arrive and what you’d like to do — a shoot, a tour, a room by the sea. We reply with a plan, usually within a few hours.</p>
    <a class="button plan-cta__button" href="/contact/">Plan your day <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
  </div>
</section>

<style>
  .plan-cta {
    padding: 5rem 0 6rem;
  }

  .plan-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    padding: 4rem 1.5rem;
    border-radius: 32px;
    background: #ff5900;
    color: #ffffff;
  }

  .plan-cta h2,
  .plan-cta p {
    margin: 0;
    color: #ffffff;
  }

  .plan-cta h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .plan-cta p {
    max-width: 560px;
    line-height: 1.6;
  }

  .plan-cta .accent-italic {
    color: #ffffff;
  }

  .plan-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #ffffff;
    color: #111111;
  }

  .plan-cta__button:hover {
    background: #111111;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .plan-cta {
      padding: 3rem 0 4rem;
    }

    .plan-cta__inner {
      padding: 3rem 1.25rem;
    }
  }
</style>
