---
import { getCityIcon } from '../data/city-icons'
import BaseLayout from '../layouts/BaseLayout.astro'
import CldImage from '../components/CldImage.astro'
import { site } from '../data/site'
const pageTitle = 'Amalfi Coast Beach Guide — 11 Beaches Reviewed | Amalfi.Day'
const pageDescription =
  'A local review of 11 Amalfi Coast beaches, from Vietri sul Mare to Positano: when the sea is warmest, sunbed tips, free strips and which shore suits your trip.'
const pageUpdatedISO = '2026-11-15'
const pageUpdatedLabel = 'November 2026'
const heroImage = '/staticpages/beach/amalfi-beach-review.jpg'
const shareImageAlt = 'Amalfi Coast shoreline and beach'

const heroStats = [
  { value: '11', label: 'Beaches reviewed' },
  { value: 'Apr–Nov', label: 'Season window' },
  { value: 'Jun–Sep', label: 'Warmest water' },
]

const quickFacts = [
  {
    title: 'Water',
    accent: 'warmth',
    icon: 'ph-thermometer-hot',
    text: 'The most comfortable swim comes from June to September, when the sea hovers around 26–28°C (79–82°F).',
  },
  {
    title: 'Beach',
    accent: 'texture',
    icon: 'ph-diamond',
    text: 'Most Amalfi beaches are pebbly. Big towns counter it with full service, smooth walkways, and shaded terraces.',
  },
  {
    title: 'Sunbed',
    accent: 'ritual',
    icon: 'ph-umbrella',
    text: 'A standard setup is two loungers plus one umbrella for the day. In July–August, reserve ahead in Amalfi and Positano.',
  },
]

const beaches = [
  {
    name: 'Vietri Sul Mare',
    accent: 'wide',
    description:
      'The widest and most accessible beach on the coast, with easy parking, democratic prices, and steady cleaning. A great base if you prefer to stay closer to the edge of the coast.',
  },
  {
    name: 'Erchie',
    accent: 'hidden',
    description:
      'A tiny fishing village tucked into a quiet bay. Boat-only coves hide along the cliffs, perfect for privacy and slow, quiet swims.',
  },
  {
    name: 'Maiori',
    accent: 'long',
    description:
      'The longest beach on the Amalfi Coast, popular with families. You can find budget stays, but premium zones can charge higher to keep crowds down.',
  },
  {
    name: 'Minori',
    accent: 'cozy',
    description:
      'A smaller, softer cousin to Maiori. It feels intimate and sweet, but it fills up fast in peak season.',
  },
  {
    name: 'Castiglione',
    accent: 'cliffside',
    description:
      'Ravello’s official beach, wedged between cliffs. Reach it via a 120-step staircase from the road. Motorcycle parking only, yet Atrani is an easy swim away.',
  },
  {
    name: 'Atrani',
    accent: 'quiet',
    description:
      'Split by a small river, with clean water and a handful of bars. It stays calm most of the year but fills up in July and August.',
  },
  {
    name: 'Amalfi',
    accent: 'central',
    description:
      'The main beach and the most crowded, especially near the cruise pier. Prices range from budget to premium, with private hotel clubs nearby and wilder cliffs beyond the port.',
  },
  {
    name: 'Conca dei Marini',
    accent: 'emerald',
    description:
      'Home to Grotta dello Smeraldo, the emerald-lit sea cave. The beach itself is small, cozy, and wrapped in rock and greenery.',
  },
  {
    name: 'Furore (Fiordo di Furore)',
    accent: 'dramatic',
    description:
      'One of the coast’s most photogenic spots. There’s no parking, so cars line the road with the risk of a fine. The view is the reward.',
  },
  {
    name: 'Praiano',
    accent: 'sunset',
    description:
      'Praiano nails the golden hour. Marina di Praia is framed by cliffs and feels secluded. It also hosts one of the rare seaside discos with music right by the water.',
  },
  {
    name: 'Positano',
    accent: 'iconic',
    description:
      'The most photographed town on the coast and the priciest beach scene. You’re paying for the name, the views, and the nightlife like Music on the Rocks.',
  },
]

const practicalNotes = [
  {
    title: 'Free water',
    accent: 'access',
    icon: 'ph-waves',
    text: 'Every beach keeps a public strip where you can lay a towel and swim. For comfort, rent a set — especially if you plan to stay all day.',
  },
  {
    title: 'Boat',
    accent: 'rentals',
    icon: 'ph-lifebuoy',
    text: 'Amalfi rentals often offer license-free boats within local limits. They are perfect for the Galli Islands, sea caves, and hidden coves. Keep distance from the shore and ask the operator about allowed zones.',
  },
  {
    title: 'Beach',
    accent: 'restaurants',
    icon: 'ph-coffee',
    text: 'Some trattorias are accessible only from the water. Arrive by boat, anchor, swim in, and enjoy a long, slow lunch between swims.',
  },
]

const beachFaqs = [
  {
    q: 'When is the best time to swim on the Amalfi Coast?',
    a: 'The warmest and most comfortable swims are from June to September, when the sea is around 26-28°C (79-82°F). The beach season starts around Easter, when beaches are cleaned and the first umbrellas go up, and it runs into the first weeks of November. July and August are the loudest and busiest months, so book sunbeds ahead in Amalfi and Positano.',
  },
  {
    q: 'Are Amalfi Coast beaches sandy or pebbly?',
    a: 'Most Amalfi Coast beaches are pebbly, so water shoes help if you like long walks along the shore. The bigger town beaches make up for it with full service, smooth walkways and shaded terraces. Vietri sul Mare has the widest and most accessible beach on the coast, and Maiori has the longest one.',
  },
  {
    q: 'Are there free beaches on the Amalfi Coast?',
    a: 'Yes. Every beach keeps a public strip where you can lay a towel and swim without paying. For a full day it is more comfortable to rent a set, which usually means two loungers and one umbrella. In July and August, Amalfi and Positano get busy, so reserve ahead.',
  },
  {
    q: 'Which Amalfi Coast beach is best for families?',
    a: 'Maiori has the longest beach on the Amalfi Coast and is popular with families, with budget options as well as pricier zones. Vietri sul Mare is the widest and most accessible beach, with easy parking and fair prices. Minori is smaller and sweeter but fills up quickly in peak season.',
  },
  {
    q: 'Which Amalfi Coast beaches are the quietest?',
    a: 'Erchie, a tiny fishing village in a quiet bay, has boat-only coves along the cliffs for private, slow swims. Atrani stays calm for most of the year and only fills up in July and August. Marina di Praia in Praiano is framed by cliffs and feels secluded. Castiglione, below Ravello, is reached by a 120-step staircase.',
  },
  {
    q: 'Can I rent a boat without a licence in Amalfi?',
    a: 'Amalfi rentals often offer licence-free boats within local limits. They are a good way to reach the Galli Islands, sea caves and hidden coves, and some trattorias can only be reached from the water. Keep your distance from the shore and ask the operator which zones you are allowed to use.',
  },
]

const nextLinks = [
  {
    href: '/photoshootings/',
    icon: 'ph-camera',
    title: 'Photoshoots with Greg',
    text: 'Couple and solo sessions in Atrani, Amalfi and Ravello, from €200, with posing help throughout.',
  },
  {
    href: '/photoshootings/positano-photographer/',
    icon: 'ph-aperture',
    title: 'Photographer in Positano',
    text: 'A photoshoot in the most photographed town on the coast.',
  },
  {
    href: '/experience/car-tours/',
    icon: 'ph-car-profile',
    title: 'Private car tours',
    text: 'Positano, Amalfi, Ravello or Tramonti with a local guide, up to 3 or 4–6 hours.',
  },
  {
    href: '/experience/scooter/',
    icon: 'ph-gauge',
    title: 'Scooter photo tour',
    text: 'Ride the coastal road past Furore and Positano with a guide who photographs the trip.',
  },
  {
    href: '/apartments/',
    icon: 'ph-house',
    title: 'Stay in Atrani',
    text: 'Suites and rooms by the sea, steps from Atrani beach and 10 minutes on foot from Amalfi.',
  },
  {
    href: '/ferry-timetables/',
    icon: 'ph-boat',
    title: 'Ferry timetables',
    text: 'Reach Positano, Maiori or Minori by sea: departures and fares from Salerno and Amalfi.',
  },
  {
    href: '/parking/',
    icon: 'ph-park',
    title: 'Parking guide',
    text: 'Beach parking by town, including Vietri sul Mare, Maiori and the Furore fjord.',
  },
  {
    href: '/what-to-do/',
    icon: 'ph-compass',
    title: 'What to do on the coast',
    text: "A local's picks beyond the beach: walks, viewpoints, food and day trips.",
  },
]

const beachesJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageTitle,
    description: pageDescription,
    url: `${site.url}/beaches`,
    mainEntityOfPage: `${site.url}/beaches`,
    dateModified: pageUpdatedISO,
    image: new URL(heroImage, site.url).toString(),
    author: { '@id': `${site.url}/#business` },
    publisher: { '@id': `${site.url}/#business` },
    inLanguage: 'en',
    about: { '@type': 'Place', name: 'Amalfi Coast' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Amalfi Coast beaches',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: beaches.length,
    itemListElement: beaches.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': ['TouristAttraction', 'Beach'],
        name: b.name,
        description: b.description,
        containedInPlace: { '@type': 'Place', name: 'Amalfi Coast' },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: beachFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Beaches', item: `${site.url}/beaches` },
    ],
  },
]
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={heroImage}
  imageAlt={shareImageAlt}
  jsonLd={beachesJsonLd}
>
  <section class="beach-hero hero--dark hero-bottom">
    <CldImage
      class="beach-hero__image"
      src={heroImage}
      alt="Amalfi Coast shoreline and beach"
      width={2000}
      height={1500}
      priority
      sizes="100vw"
    />
    <div class="beach-hero__veil hero-shade" aria-hidden="true"></div>
    <div class="container beach-hero__content hero-content hero-container">
      <div class="beach-hero__copy">
        <span class="badge beach-hero__badge"><i class="ph ph-waves" aria-hidden="true"></i> Personal guide</span>
        <h1>
          Amalfi Beach <span class="accent-italic">review</span>
        </h1>
        <p class="beach-hero__lead">
          A personal, photo-minded map of the Amalfi Coast shoreline — where to swim, where to
          book a lounger, and which coves stay quiet.
        </p>
        <div class="beach-hero__stats">
          {heroStats.map((item) => (
            <div class="beach-stat">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
        <div class="beach-hero__links">
          <a href="#timing">When to go</a>
          <a href="#beach-atlas">Beach atlas</a>
          <a href="#practical">Practical notes</a>
        </div>
      </div>
      <aside class="beach-hero__aside">
        <div class="beach-eyebrow">Author note</div>
        <p>
          I keep a private beach log and decided to share it. It’s a personal opinion, meant to
          give you a clear picture of the Amalfi Coast and help you choose a shore where your
          vacation feels effortless.
        </p>
        <div class="beach-hero__author">
          <strong>Gregory Day</strong>
          <span>Author of Amalfi.Day</span>
        </div>
      </aside>
    </div>
  </section>

  <div class="quick-answer" role="region" aria-labelledby="quick-answer-title">
    <div class="container">
      <div class="quick-answer__box">
        <div class="beach-eyebrow">Quick answer</div>
        <h2 class="quick-answer__title" id="quick-answer-title">Which Amalfi Coast beach should I choose?</h2>
        <p>
          The Amalfi Coast beach season runs from around Easter to early November, and the sea is
          warmest from June to September at about 26-28°C. Most beaches are pebbly. For space and
          easy parking, pick Vietri sul Mare or Maiori, the longest beach on the coast. For quiet
          water, try Atrani or the boat-only coves near Erchie, and for the famous view, Positano,
          the priciest beach scene. In July and August, book loungers ahead in Amalfi and Positano.
        </p>
        <p class="quick-answer__date">
          Last updated: <time datetime={pageUpdatedISO}>{pageUpdatedLabel}</time>
        </p>
      </div>
    </div>
  </div>

  <section class="section beach-intro" id="timing">
    <div class="container">
      <div class="beach-intro__copy">
        <div class="beach-eyebrow">Season timing</div>
        <h2>
          When to chase <span class="accent-italic">warm</span> water
        </h2>
        <p>
          The coast wakes up around Easter, when the beaches are cleaned, sand is refreshed, and
          the first umbrellas appear. The season runs into the first weeks of November, but the
          most comfortable swims arrive between June and September.
        </p>
        <div class="beach-eyebrow">Beach rhythm</div>
        <h2>
          Pebbles, <span class="accent-italic">service</span>, and etiquette
        </h2>
        <p>
          Most Amalfi beaches are pebbly, so bring water shoes if you love long shoreline walks.
          City beaches are well equipped, and a day setup typically includes two loungers and one
          umbrella. July and August are loud and full — reserve ahead for Amalfi and Positano.
        </p>
      </div>
      <div class="beach-intro__facts">
        {quickFacts.map((item) => (
          <article class="card fact-card">
            <div class="fact-card__icon">
              <i class={`ph ${item.icon}`} aria-hidden="true"></i>
            </div>
            <h3>
              {item.title} <span class="accent-italic">{item.accent}</span>
            </h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beach-atlas" id="beach-atlas">
    <div class="container">
      <div class="section__header">
        <h2>
          Beaches of the <span class="accent-italic">Amalfi</span> Coast
        </h2>
        <p>Eleven shores, eleven moods — from wide promenades to hidden cliff coves.</p>
      </div>
      <div class="beach-list-shell">
        <div class="beach-list">
          {beaches.map((beach) => (
            <article class="beach-row">
              <div class="beach-row__icon" aria-hidden="true">
                <i class={`ph ${getCityIcon(beach.name)}`} aria-hidden="true"></i>
              </div>
              <div class="beach-row__content">
                <h3>
                  {beach.name} <span class="accent-italic">{beach.accent}</span>
                </h3>
                <p>{beach.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section beach-notes" id="practical">
    <div class="container">
      <div class="section__header">
        <h2>
          Practical <span class="accent-italic">notes</span>
        </h2>
        <p>Small details that make the day smoother.</p>
      </div>
      <div class="beach-notes__grid">
        {practicalNotes.map((item) => (
          <article class="card note-card">
            <div class="note-card__icon">
              <i class={`ph ${item.icon}`} aria-hidden="true"></i>
            </div>
            <h3>
              {item.title} <span class="accent-italic">{item.accent}</span>
            </h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beach-faq" aria-labelledby="beach-faq-title">
    <div class="container">
      <div class="section__header">
        <h2 id="beach-faq-title">
          Beach <span class="accent-italic">questions</span>
        </h2>
        <p>Short answers about water temperature, pebbles, free strips and boats.</p>
      </div>
      <div class="beach-faq__list">
        {beachFaqs.map((f) => (
          <details class="beach-faq__item">
            <summary class="beach-faq__q">{f.q}</summary>
            <p class="beach-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section beach-summary">
    <div class="container">
      <div class="beach-summary__card">
        <div class="beach-eyebrow">Summary</div>
        <h2>
          The coast is <span class="accent-italic">built</span> for comfort
        </h2>
        <p>
          Amalfi is not just a postcard — it is a coastline shaped for real holidays. You can
          pick a quiet cove for slow swims or a lively beach with bars and music. Choose the mood
          that fits your trip, and let the scenery do the rest.
        </p>
      </div>
    </div>
  </section>

  <section class="section next-links" aria-labelledby="next-links-title">
    <div class="container">
      <div class="section__header">
        <h2 id="next-links-title">
          While you're <span class="accent-italic">here</span>
        </h2>
        <p>The rest of the trip, from a photoshoot on the beach in Atrani to a ferry to Positano.</p>
      </div>
      <div class="next-links__grid">
        {nextLinks.map((link) => (
          <a class="card next-link" href={link.href}>
            <strong class="next-link__title">
              <i class={`ph ${link.icon}`} aria-hidden="true"></i>
              {link.title}
            </strong>
            <span class="next-link__text">{link.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .beach-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #ffffff;
    padding: calc(var(--header-space) + 4rem) 0 4rem;
  }

  .beach-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.05);
    z-index: -2;
  }

  .beach-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(12, 16, 20, 0.9) 0%, rgba(12, 16, 20, 0.35) 45%, rgba(12, 16, 20, 0.08) 70%),
      radial-gradient(circle at 20% 20%, rgba(255, 195, 0, 0.35), transparent 45%);
    z-index: -1;
  }

  .beach-hero__content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    gap: 2.5rem;
    align-items: end;
  }

  .beach-hero__badge {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .beach-hero__copy h1 {
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    margin-top: 1.2rem;
    color: #ffffff;
  }

  .beach-hero__lead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .beach-hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .beach-stat {
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
  }

  .beach-stat strong {
    display: block;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }

  .beach-stat span {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
  }

  .beach-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .beach-hero__links a {
    color: #ffffff;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    text-decoration: none;
  }

  .beach-hero__links a:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.9);
  }

  .beach-hero__aside {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: rgba(12, 16, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
  }

  .beach-hero__aside p {
    color: rgba(255, 255, 255, 0.82);
  }

  .beach-hero__author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.4rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .beach-hero__author strong {
    color: #ffffff;
    font-size: 1rem;
  }

  .beach-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
  }

  .beach-hero .beach-eyebrow {
    color: rgba(255, 255, 255, 0.65);
  }

  .beach-summary__card .beach-eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }

  .beach-intro__copy h2 {
    font-size: clamp(2rem, 3vw, 2.8rem);
  }

  .beach-intro__copy p {
    max-width: 36rem;
  }

  .beach-intro__facts {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .fact-card {
    padding: 1.6rem;
    display: grid;
    gap: 0.7rem;
  }

  .fact-card__icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .section__header h2 {
    font-size: clamp(2.1rem, 3.2vw, 3rem);
    margin-bottom: 0.4rem;
  }

  .section__header p {
    max-width: 28rem;
  }

  .beach-list-shell {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 2rem;
  }

  .beach-list {
    grid-column: 2 / 4;
    display: grid;
    gap: 2.2rem;
  }

  .beach-row {
    display: grid;
    grid-template-columns: minmax(56px, 72px) minmax(0, 1fr);
    column-gap: 2rem;
    align-items: start;
  }

  .beach-row__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-aux);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    position: relative;
  }

