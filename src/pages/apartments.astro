---
import BaseLayout from '../layouts/BaseLayout.astro'
import StayCard from '../components/StayCard.astro'
import DirectBooking from '../components/DirectBooking.astro'
import { ALL_APARTMENTS, DIRECT_APARTMENTS, PLATFORM_APARTMENTS } from '../data/apartments'
import { site, business } from '../data/site'

const pageTitle = 'CristallPont Amalfi Day: Apartments & Rooms in Atrani'
const pageDescription =
  'CristallPont Amalfi Day: rooms, suites and apartments in Atrani on the Amalfi Coast, plus Ravello. Book direct on this site, or on Booking.com and Airbnb.'
const shareImage = '/apartments/3-view-from-cristall-Pont.jpg'

const lodgingId = `${site.url}/apartments/#lodging`

const sharedAddress = {
  '@type': 'PostalAddress',
  streetAddress: business.street,
  addressLocality: business.locality,
  addressRegion: business.region,
  postalCode: business.postalCode,
  addressCountry: business.country,
}

// Villa Susy and The Sunrise Balcony
// are in Ravello per their listings; the rest are at the Atrani address.
const ravelloIds = new Set(['villa-susy', 'sunrise-balcony'])
const ravelloAddress = {
  '@type': 'PostalAddress',
  addressLocality: 'Ravello',
  addressRegion: business.region,
  addressCountry: business.country,
}

const apartmentItems = ALL_APARTMENTS.map((a, i) => {
  // Direct units reserve on our own booking page; the rest on the platforms.
  const reserveUrl = a.direct
    ? `${site.url}/book/${a.id}/`
    : a.bookingLinks.airbnb || a.bookingLinks.booking
  const node = {
    '@type': 'Apartment',
    '@id': `${site.url}/apartments/#${a.id}`,
    name: a.name,
    description: a.description,
    image: a.gallery.map((g) => new URL(g, site.url).toString()),
    address: ravelloIds.has(a.id) ? ravelloAddress : sharedAddress,
    containedInPlace: { '@id': lodgingId },
    url: `${site.url}/apartments/${a.id}/`,
    ...(a.cin ? { identifier: a.cin } : {}),
    ...(reserveUrl
      ? {
          potentialAction: {
            '@type': 'ReserveAction',
            target: reserveUrl,
          },
        }
      : {}),
  }
  return { position: i + 1, item: node }
})

const ravelloCount = ALL_APARTMENTS.filter((a) => ravelloIds.has(a.id)).length
const unitCount = ALL_APARTMENTS.length
const directNames = DIRECT_APARTMENTS.map((a) => a.name).join(', ')
const platformNames = PLATFORM_APARTMENTS.map((a) => a.name).join(', ')

const faqs = [
  {
    q: 'Is Amalfi.Day the same as CristallPont Amalfi Day on Booking.com?',
    a: `Yes. CristallPont Amalfi Day is the name of the property on Booking.com. The same rooms, suites and apartments are listed on Airbnb under host Gregory and are run by local host Gregory (Greg) and CristallPont S.R.L. under the brand ${business.brandName}. This page is the property's own site, where you can also book direct.`,
  },
  {
    q: 'Where is CristallPont Amalfi Day and how do I get there from Amalfi?',
    a: `The Atrani address is ${business.street}, ${business.postalCode} ${business.locality} (${business.region}), ${business.countryName}. From the Amalfi ferry terminal, follow the waterfront road: the walk to Atrani takes about 10 minutes. Two apartments are in Ravello instead.`,
    link: { href: '/directions/', label: 'Directions to Atrani' },
  },
  {
    q: 'Is there parking at CristallPont Amalfi Day?',
    a: 'Overnight parking is forbidden in Atrani town. The closest paid garage is Parcheggio Luna Rossa in Amalfi (from 40 EUR/day, 5 minutes on foot), and the cheapest option is street parking on the coastal road just outside Atrani. Prices and limits change by season; see the parking guide.',
    link: { href: '/parking/', label: 'Parking on the Amalfi Coast' },
  },
  {
    q: 'Is it cheaper to book direct?',
    a: `Yes. Booking direct on this site is 10% cheaper than the same stay on Airbnb or Booking.com. Pick your dates in the Book direct search to see the exact price. At the moment you send a booking request here and we confirm by message; free cancellation up to 7 days before arrival, and payment is due 9 days before check-in.`,
  },
  {
    q: 'Which units can be booked direct and which on Airbnb or Booking.com?',
    a: `Bookable direct on this site: ${directNames}. Booked through Airbnb or Booking.com: ${platformNames}. The ${unitCount} units in total include ${ravelloCount} apartments in Ravello; the others are in Atrani.`,
  },
  {
    q: 'How do I get from Naples airport to CristallPont Amalfi Day?',
    a: 'The simplest options are the direct airport shuttle to Amalfi, or train to Salerno and then a ferry or SITA bus to Amalfi. From Amalfi it is a 10-minute walk to Atrani. The airport guide compares times and costs.',
    link: { href: '/how-to-get/', label: 'Naples Airport to the Amalfi Coast' },
  },
]

const apartmentsSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LodgingBusiness',
    '@id': lodgingId,
    name: 'CristallPont Amalfi Day',
    alternateName: [
      'CristallPont',
      'Cristallpont Amalfi Day',
      'CristallPont AmalfiDay',
      `${business.brandName} apartments`,
    ],
    description: pageDescription,
    url: `${site.url}/apartments/`,
    image: new URL(shareImage, site.url).toString(),
    telephone: business.phone,
    email: business.email,
    address: sharedAddress,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: business.geo.lat,
      longitude: business.geo.lon,
    },
    parentOrganization: { '@id': `${site.url}/#business` },
    sameAs: [business.bookingUrl, business.airbnbUrl],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    description: pageDescription,
    url: `${site.url}/apartments/`,
    inLanguage: 'en',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': lodgingId },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: apartmentItems.map(({ position, item }) => ({
        '@type': 'ListItem',
        position,
        item,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${site.url}/apartments/#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Apartments', item: `${site.url}/apartments/` },
    ],
  },
]

const stats = [
  { value: '15+', label: 'Years of experience' },
  { value: '2000+', label: 'Positive reviews' },
]

const heroSlides = [
  { image: '/apartments/3-view-from-cristall-Pont.jpg', label: 'Atrani', alt: 'View over the rooftops and sea of Atrani at CristallPont Amalfi Day on the Amalfi Coast' },
  { image: '/apartments/villa-ravello-amalfiday-rent-1500x770.webp', label: 'Ravello', alt: 'Villa apartment in Ravello, part of the Amalfi.Day stays' },
  { image: '/apartments/dragone-2.webp', label: 'Rooms', alt: 'Room with balcony in Atrani, Amalfi Coast' },
  { image: '/apartments/harmony.jpg.avif', label: 'Suites', alt: 'Suite Harmony, an apartment by the sea in Atrani' },
]

const heroTags = [
  'Beachfront',
  'Historic center',
  'Sea views',
  'Private balconies',
  'Full kitchens',
  'Free Wi-Fi',
]

const testimonials = [
  {
    quote:
      "My stay in Atrani was wonderful! Very close to Amalfi, it's a short distance walking and you get to enjoy the view and the way there Gregory is a very nice host, He answered all my questions, I got to know his family wish they were nice to me as well , I recommend this beautiful place 100% It's worth it!",
    author: 'Silvia, Howey-in-the-Hills, FL',
    meta: 'December 2022',
  },
  {
    quote:
      'Amazing stay and location, 10 minute walk to edge of Amalfi. Everything was clean and tidy, kitchen was great and well-stocked. And host is super friendly and interesting. Even more, the host has a great website guiding us on how to get there and the attractions in Amalfi. I would recommend to everybody who wants to come here.',
    author: 'Ethan, London, United Kingdom',
    meta: 'October 2022',
  },
  {
    quote:
      'Perfect for what I needed and looked exactly like the pictures. Communication with Gregory was great and he messaged back immediately when I was having trouble finding the walking route from Amalfi to Atrani. He provided a great guide of suggestions of things to do. I was able to easily do day trips to Ravello, a Positano boat tour and walk to Amalfi.',
    author: 'Erin, Brighton East, Australia',
    meta: 'October 2022',
  },
  {
    quote:
      "Amazing stay. Wifi was great. Room was cozy and clean. Loved the balcony. Shared restroom was also clean and had supplies like soap,detergent,etc. Honestly I wish I went to Gregory's airbnb as soon as I got to Amalfi coast it's a great location you'll be right next to Amalfi only like a 10 minute walk it's great you got the beach next to you!",
    author: 'Sofia, Paris, France',
    meta: 'October 2022',
  },
]
---

<BaseLayout title={pageTitle} description={pageDescription} image={shareImage} jsonLd={apartmentsSchema}>
  <section class="apt-hero hero--dark hero-bottom">
    <div class="apt-hero__slides" aria-hidden="true">
      {heroSlides.map((slide, i) => (
        <div class={`apt-hero__slide ${i === 0 ? 'is-active' : ''}`}>
          <img src={slide.image} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="apt-hero__vignette hero-shade"></div>
    <div class="apt-hero__content hero-content">
      <div class="container hero-container">
        <div class="apt-hero__grid">
          <div class="apt-hero__copy">
            <span class="apt-hero__eyebrow">CristallPont Amalfi Day · Atrani</span>
            <h1 class="apt-hero__title">
              Apartments, rooms<br /><span class="apt-hero__title-accent">& villa</span>
            </h1>
            <p class="apt-hero__lead">
              Most of our stays sit in the heart of Atrani — a 2-minute walk to the main square and the beach. Fifteen years of hosting and 2000+ positive reviews.
            </p>
            <div class="apt-hero__stats">
              {stats.map((item) => (
                <div class="apt-hero__stat">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))}
            </div>
            <div class="apt-hero__actions">
              <a class="apt-hero__btn apt-hero__btn--primary" href="#direct">Book your stay</a>
              <a class="apt-hero__btn apt-hero__btn--ghost" href="#platforms">Browse apartments</a>
            </div>
          </div>
          <div class="apt-hero__aside">
            <ul class="apt-hero__tags">
              {heroTags.map((tag, i) => (
                <li class="apt-hero__tag" style={`animation-delay: ${0.6 + i * 0.08}s`}>{tag}</li>
              ))}
            </ul>
            <div class="apt-hero__progress">
              {heroSlides.map((slide, i) => (
                <button
                  class={`apt-hero__dot ${i === 0 ? 'is-active' : ''}`}
                  data-slide={i}
                  aria-label={`Show ${slide.label}`}
                >
                  <span class="apt-hero__dot-label">{slide.label}</span>
                  <span class="apt-hero__dot-bar"><span class="apt-hero__dot-fill"></span></span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="apt-hero__scroll-hint" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <DirectBooking />

  <section id="platforms" class="section platforms">
    <div class="container section__header">
      <h2>Also on Airbnb &amp; Booking.com</h2>
      <p>These stays are booked through the platforms. The calendar shows which nights are still free.</p>
    </div>
    <div class="container stay-grid">
      {PLATFORM_APARTMENTS.map((apartment) => (
        <StayCard apartment={apartment} variant="grid" />
      ))}
    </div>
  </section>

  <section class="section apt-answer" aria-labelledby="apt-answer-title">
    <div class="container">
      <div class="apt-answer__grid">
        <div class="apt-answer__copy">
          <span class="apt-answer__eyebrow">The short answer</span>
          <h2 id="apt-answer-title">What is CristallPont Amalfi Day?</h2>
          <p>
            CristallPont Amalfi Day is the name of this property on Booking.com, and the same
            stays are listed on Airbnb under host Gregory. It offers rooms and suites in Atrani,
            a 10-minute walk from Amalfi, plus {ravelloCount} apartments in Ravello.
          </p>
          <p>
            It is run by local host Gregory (Greg) and {business.legalName} under the brand{' '}
            {business.brandName}. Booking direct on this site is 10% cheaper than the platforms.
          </p>
          <p class="apt-answer__more">
            Not sure Atrani is the right base?{' '}
            <a href="/where-to-stay-in-atrani/">Read where to stay in Atrani</a>.{' '}
            <a class="apt-answer__faq" href="#faq">Questions? See the FAQ</a>
          </p>
        </div>
        <aside class="apt-facts" aria-label="At a glance">
          <h3>At a glance</h3>
          <dl>
            <div><dt>Address</dt><dd>{business.street}, {business.postalCode} {business.locality} ({business.region})</dd></div>
            <div><dt>Town</dt><dd>Atrani, Amalfi Coast</dd></div>
            <div><dt>To Amalfi</dt><dd>10-minute walk</dd></div>
            <div><dt>Beach</dt><dd>2-minute walk</dd></div>
            <div><dt>Units</dt><dd>{unitCount} ({ravelloCount} in Ravello)</dd></div>
            <div><dt>Phone</dt><dd><a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a></dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
            <div><dt>Book on</dt><dd>Amalfi.Day, <a href={business.bookingUrl} rel="noopener">Booking.com</a>, <a href={business.airbnbUrl} rel="noopener">Airbnb</a></dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--adventure">
    <div class="container adventure-grid">
      <div class="adventure-copy">
        <span class="eyebrow">amalfi.day</span>
        <h2>Adventure awaits</h2>
        <p class="lead">
          At CristallPont Amalfi Day we offer comfortable and cost-effective stays in apartments,
          rooms, and a villa near Atrani. Most of our apartments are located in the center of
          Atrani, just a 2-minute walk from the main square and Atrani's beach. With 15+ years of
          experience, we aim to be a trusted and reliable choice for travelers.
        </p>
        <div class="adventure-pillars">
          <div class="pillar">
            <h3>Comfortable</h3>
            <p>
              As we understand the needs of travelers visiting Amalfi, we have designed our
              rooms and apartments to be comfortable for short-term stays.
            </p>
          </div>
          <div class="pillar">
            <h3>...and cost-effective</h3>
            <p>
              We understand that budget can be a concern for travelers, so we have several
              cost-effective options that will ensure your holiday in Amalfi is enjoyable and
              fantastic.
            </p>
          </div>
        </div>
      </div>
      <div class="adventure-media">
        <img
          src="/apartments/3-view-from-cristall-Pont.jpg"
          alt="Atrani townscape at sunset"
          loading="lazy"
          decoding="async" width="1768" height="1450"
        />
      </div>
    </div>
  </section>

  <section class="section testimonials">
    <div class="container section__header">
      <h2>Guest impressions</h2>
      <p>Recent words from travelers who stayed with us in Atrani.</p>
    </div>
    <div class="container testimonials__grid">
      {testimonials.map((item) => (
        <article class="testimonial">
          <p>"{item.quote}"</p>
          <div class="testimonial__meta">
            <strong>{item.author}</strong>
            <span>{item.meta}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section apt-faq" id="faq" aria-labelledby="apt-faq-title">
    <div class="container">
      <h2 id="apt-faq-title">Frequently asked <span class="accent-italic">questions</span></h2>
      <div class="apt-faq__list">
        {faqs.map((f) => (
          <details class="apt-faq__item">
            <summary class="apt-faq__q">{f.q}<i class="ph ph-plus" aria-hidden="true"></i></summary>
            <p class="apt-faq__a">
              {f.a}
              {f.link && <> <a href={f.link.href}>{f.link.label}</a>.</>}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  ;(function () {
    const slides = document.querySelectorAll('.apt-hero__slide')
    const dots = document.querySelectorAll('.apt-hero__dot')
    if (!slides.length) return

    let current = 0
    const DURATION = 6000
    const FADE_DURATION = 1300
    const freezeTimers = new WeakMap()

    function clearSlideFreeze(slide) {
      const image = slide?.querySelector('img')
      if (!image) return
      image.style.animation = ''
      image.style.transform = ''
    }

    function freezeSlideTransform(slide) {
      const image = slide?.querySelector('img')
      if (!image) return

      const transform = window.getComputedStyle(image).transform
      image.style.animation = 'none'
      image.style.transform = transform === 'none' ? '' : transform

      window.clearTimeout(freezeTimers.get(slide))
      freezeTimers.set(
        slide,
        window.setTimeout(() => {
          if (!slide.classList.contains('is-active')) {
            clearSlideFreeze(slide)
          }
          freezeTimers.delete(slide)
        }, FADE_DURATION)
      )
    }

    function go(next) {
      if (next === current) return
      freezeSlideTransform(slides[current])
      slides[current].classList.remove('is-active')
      dots[current].classList.remove('is-active')
      current = next
      clearSlideFreeze(slides[current])
      slides[current].classList.add('is-active')
      dots[current].classList.add('is-active')
    }

    let timer = setInterval(() => go((current + 1) % slides.length), DURATION)

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        clearInterval(timer)
        go(Number(dot.dataset.slide))
        timer = setInterval(() => go((current + 1) % slides.length), DURATION)
      })
    })
  })()
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const galleries = Array.from(document.querySelectorAll('[data-gallery]'))

    galleries.forEach((gallery) => {
      const mode = gallery.dataset.galleryMode || 'cycle'
      if (mode === 'scroll') {
        const track = gallery.querySelector('.stay__track')
        const slides = track ? Array.from(track.querySelectorAll('.stay__slide')) : []
        const prevBtn = gallery.querySelector('[data-gallery-prev]')
        const nextBtn = gallery.querySelector('[data-gallery-next]')

        const getClosestIndex = () => {
          if (!track || !slides.length) return 0
          const center = track.scrollLeft + track.clientWidth / 2
          let closestIndex = 0
          let closestDistance = Infinity
          slides.forEach((slide, index) => {
            const slideCenter = slide.offsetLeft + slide.offsetWidth / 2
            const distance = Math.abs(slideCenter - center)
            if (distance < closestDistance) {
              closestDistance = distance
              closestIndex = index
            }
          })
          return closestIndex
        }

        const scrollToIndex = (index) => {
          if (!track || !slides.length) return
          const clamped = Math.max(0, Math.min(index, slides.length - 1))
          const slide = slides[clamped]
          const left = slide.offsetLeft + slide.offsetWidth / 2 - track.clientWidth / 2
          track.scrollTo({ left, behavior: 'smooth' })
        }

        nextBtn?.addEventListener('click', () => scrollToIndex(getClosestIndex() + 1))
        prevBtn?.addEventListener('click', () => scrollToIndex(getClosestIndex() - 1))
        return
      }

      const images = Array.from(gallery.querySelectorAll('[data-gallery-image]'))
      if (images.length <= 1) return

      let index = 0
      const show = (nextIndex) => {
        index = (nextIndex + images.length) % images.length
        images.forEach((img, i) => img.classList.toggle('is-active', i === index))
      }
      const next = () => show(index + 1)
      const prev = () => show(index - 1)

      gallery.addEventListener('click', (event) => {
        const target = event.target.closest('button[data-gallery-next], button[data-gallery-prev]')
        if (target?.hasAttribute('data-gallery-next')) {
          next()
          return
        }
        if (target?.hasAttribute('data-gallery-prev')) {
          prev()
          return
        }
        if (event.target.closest('img[data-gallery-image]')) {
          next()
        }
      })

      let startX = 0
      gallery.addEventListener('touchstart', (event) => {
        startX = event.touches[0]?.clientX ?? 0
      })
      gallery.addEventListener('touchend', (event) => {
        const endX = event.changedTouches[0]?.clientX ?? 0
        const diff = endX - startX
        if (Math.abs(diff) < 35) return
        if (diff < 0) next()
        else prev()
      })
    })
  })
</script>

<style>
  /* ===== APARTMENTS HERO — Full-viewport cinematic ===== */

  .apt-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #0a0a0a;
    color: #ffffff;
  }

  .apt-hero__slides {
    position: absolute;
    inset: -2px;
    z-index: 0;
    overflow: hidden;
  }

  .apt-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    backface-visibility: hidden;
  }

  .apt-hero__slide.is-active {
    opacity: 1;
  }

  .apt-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    backface-visibility: hidden;
  }

  .apt-hero__slide.is-active img {
    animation: apt-ken-burns 6.5s cubic-bezier(0.25, 0, 0.4, 1) forwards;
  }

  @keyframes apt-ken-burns {
    from { transform: scale(1.01); }
    to { transform: scale(1.06); }
  }

  .apt-hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, transparent 65%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 0%, transparent 50%, rgba(0, 0, 0, 0.18) 100%);
    pointer-events: none;
  }

  .apt-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(2.5rem, 5vh, 4.5rem);
  }

  .apt-hero__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
  }

  .apt-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    margin-bottom: 1rem;
    opacity: 0;
    animation: apt-fade-up 0.7s 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .apt-hero__title {
    font-size: clamp(2.8rem, 6.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    opacity: 0;
    animation: apt-fade-up 0.8s 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .apt-hero__title-accent {
