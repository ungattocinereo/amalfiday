---
// PREVIEW ONLY — prototype of the new desktop navigation (animate-ui style).
// Not linked anywhere; delete or replace with the real Header before shipping.
import '../styles/global.css'
import MorphingLogo from '../components/MorphingLogo.astro'

const img = {
  couple: '/photoshootings/optimized/regan-tay-ravello/HERO-regan-walk-ravello-love-720.webp',
  solo: '/photoshootings/optimized/loreana/hero-720.webp',
  family: '/photoshootings/olga-marat/28-olga-marat-atrani-2023.webp',
  balcony: '/apartments/the-sunrise-balcony.webp',
  atrani: '/apartments/3-view-from-cristall-Pont.jpg',
  orange: '/apartments/orange-room.jpg',
  vintage: '/apartments/room-in-atrani-vintage.webp',
  scenic: '/staticpages/car-tours/Scenic-Coast/Scenic-Coast-amalfi-coast-tours-5.webp',
  peak: '/staticpages/car-tours/Peak-Flavors/Peak-Flavors-amalfi-coast-tours-7.webp',
  moto: '/staticpages/moto/hero/moto-ride-with-photographer-in-amalfi-coast-4.webp',
  ferry: '/staticpages/timetables/ferry-hero-01.webp',
}
---
<!doctype html>
<html lang="en" data-theme="day">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Nav preview · Amalfi.Day</title>
</head>
<body>
  <header class="hdr">
    <div class="bar">
      <a class="logo" href="/" aria-label="Amalfi.Day home">
        <MorphingLogo />
      </a>

      <nav class="nm" aria-label="Main navigation" data-nm>
        <ul class="nm-list">
          <span class="nm-hl" aria-hidden="true"></span>
          <li><button class="nm-trigger" type="button" aria-expanded="false" aria-controls="p-photo" data-panel="p-photo">Photoshoots <i class="ph ph-caret-down"></i></button></li>
          <li><button class="nm-trigger" type="button" aria-expanded="false" aria-controls="p-stay" data-panel="p-stay">Apartments <span class="nm-pill">−10%</span> <i class="ph ph-caret-down"></i></button></li>
          <li><button class="nm-trigger" type="button" aria-expanded="false" aria-controls="p-tours" data-panel="p-tours">Tours <i class="ph ph-caret-down"></i></button></li>
          <li><button class="nm-trigger" type="button" aria-expanded="false" aria-controls="p-guide" data-panel="p-guide">Coast guide <i class="ph ph-caret-down"></i></button></li>
          <li><a class="nm-trigger" href="/blog/">News</a></li>
        </ul>

        <div class="nm-popup" data-popup>
          <div class="nm-viewport">

            <!-- PHOTOSHOOTS -->
            <section class="nm-panel nm-panel--photo" id="p-photo">
              <a class="feat" href="/photoshootings/" style="--i:0">
                <img src={img.couple} alt="" loading="lazy" />
                <span class="feat__body">
                  <span class="eyebrow">Real stories · Ravello</span>
                  <span class="feat__title">Your Amalfi, <em>in frames</em></span>
                  <span class="feat__cta">See all photoshoots <i class="ph ph-arrow-right"></i></span>
                </span>
              </a>
              <div class="col">
                <span class="eyebrow" style="--i:1">Who’s in the frame</span>
                <a class="row" href="/photoshootings/solo-photoshoot/" style="--i:2"><img src={img.solo} alt="" loading="lazy" /><span><b>Solo portrait</b><small>Golden hour, just you</small></span></a>
                <a class="row" href="/photoshootings/couple-photoshoot/" style="--i:3"><img src={img.couple} alt="" loading="lazy" /><span><b>Couples</b><small>Walks, terraces, sunsets</small></span></a>
                <a class="row" href="/photoshootings/family-photoshoot/" style="--i:4"><img src={img.family} alt="" loading="lazy" /><span><b>Family</b><small>Relaxed, kids welcome</small></span></a>
                <a class="row" href="/photoshootings/proposal-photographer/" style="--i:5"><span class="row__icon"><i class="ph ph-diamond"></i></span><span><b>Proposal</b><small>We keep the secret</small></span></a>
              </div>
              <div class="col col--narrow">
                <span class="eyebrow" style="--i:1">By location</span>
                <a class="link" href="/photoshootings/positano-photographer/" style="--i:2">Positano</a>
                <a class="link" href="/photoshootings/amalfi-photographer/" style="--i:3">Amalfi &amp; Atrani</a>
                <a class="link" href="/photoshootings/ravello-photographer/" style="--i:4">Ravello</a>
                <a class="link" href="/photoshootings/path-of-the-gods-photographer/" style="--i:5">Path of the Gods</a>
                <a class="note" href="/#posing-guide" style="--i:6"><i class="ph ph-sparkle"></i> Never posed? Free posing guide</a>
              </div>
            </section>

            <!-- APARTMENTS -->
            <section class="nm-panel nm-panel--stay" id="p-stay">
              <a class="feat feat--tall" href="/apartments/#direct" style="--i:0">
                <img src={img.balcony} alt="" loading="lazy" />
                <span class="sticker">Book direct<br /><b>−10%</b></span>
                <span class="feat__body">
                  <span class="eyebrow">Atrani · steps from the sea</span>
                  <span class="feat__title">Stay with <em>locals</em></span>
                  <span class="feat__cta">Check your dates <i class="ph ph-calendar-blank"></i></span>
                </span>
              </a>
              <div class="col">
                <span class="eyebrow" style="--i:1">Rooms you can book direct</span>
                <a class="row" href="/book/orange/" style="--i:2"><img src={img.orange} alt="" loading="lazy" /><span><b>Orange room</b><small>Up to 2 guests</small></span></a>
                <a class="row" href="/book/vintage/" style="--i:3"><img src={img.vintage} alt="" loading="lazy" /><span><b>Vintage interior</b><small>Up to 2 guests</small></span></a>
                <a class="row" href="/book/awesome/" style="--i:4"><img src={img.atrani} alt="" loading="lazy" /><span><b>Awesome apartments</b><small>Up to 2 guests</small></span></a>
                <a class="row" href="/book/youth/" style="--i:5"><img src="/apartments/casa-bunkbed-room.jpg" alt="" loading="lazy" /><span><b>Room for youngsters</b><small>Up to 2 guests</small></span></a>
                <a class="row" href="/book/solo/" style="--i:6"><img src="/apartments/romfor-1-person.jpg.webp" alt="" loading="lazy" /><span><b>Solo traveller</b><small>1 guest</small></span></a>
                <a class="more" href="/apartments/" style="--i:7"><span>All stays &amp; villas</span> <i class="ph ph-arrow-right"></i></a>
              </div>
            </section>

            <!-- TOURS -->
            <section class="nm-panel nm-panel--tours" id="p-tours">
              <a class="card" href="/experience/car-tours/#tour-scenic" style="--i:0"><img src={img.scenic} alt="" loading="lazy" /><span class="card__body"><span class="eyebrow">Private car tour</span><b>Scenic Coast</b><small>Cliff villages, limoncello, lunch by the sea</small></span></a>
              <a class="card" href="/experience/car-tours/#tour-tramonti" style="--i:1"><img src={img.peak} alt="" loading="lazy" /><span class="card__body"><span class="eyebrow">Wine &amp; food</span><b>Peak Flavors</b><small>Tramonti vineyards and mountain views</small></span></a>
              <a class="card" href="/experience/scooter/" style="--i:2"><img src={img.moto} alt="" loading="lazy" /><span class="card__body"><span class="eyebrow">Ride + photos</span><b>Scooter Photo Tour</b><small>Cliffside roads, 50+ photos included</small></span></a>
              <a class="more more--wide" href="/experience/" style="--i:3"><span>All experiences</span> <i class="ph ph-arrow-right"></i></a>
            </section>

            <!-- GUIDE -->
            <section class="nm-panel nm-panel--guide" id="p-guide">
              <div class="col">
                <span class="eyebrow" style="--i:0">Getting around</span>
                <a class="row row--icon" href="/how-to-get/" style="--i:1"><span class="row__icon"><i class="ph ph-airplane-tilt"></i></span><span><b>How to get here</b><small>From Naples, Rome, Salerno</small></span></a>
                <a class="row row--icon" href="/ferry-timetables/" style="--i:2"><span class="row__icon"><i class="ph ph-boat"></i></span><span><b>Ferry timetables</b><small>Updated for the season</small></span></a>
                <a class="row row--icon" href="/timetables/" style="--i:3"><span class="row__icon"><i class="ph ph-bus"></i></span><span><b>Buses</b><small>SITA lines and stops</small></span></a>
                <a class="row row--icon" href="/parking/" style="--i:4"><span class="row__icon"><i class="ph ph-park"></i></span><span><b>Parking</b><small>Where and how much</small></span></a>
              </div>
              <div class="col col--narrow">
                <span class="eyebrow" style="--i:0">Field notes</span>
                <a class="link" href="/beaches/" style="--i:1">Beach reviews</a>
                <a class="link" href="/moto/" style="--i:2">Moto roads</a>
                <a class="link" href="/what-to-do/" style="--i:3">What to do</a>
                <a class="link" href="/guide/" style="--i:4">Greg’s guide</a>
              </div>
              <a class="mini" href="/ferry-timetables/" style="--i:5"><img src={img.ferry} alt="" loading="lazy" /><span>Next ferry from Amalfi <i class="ph ph-arrow-up-right"></i></span></a>
            </section>

          </div>
        </div>
      </nav>

      <div class="actions">
        <a class="cta" href="/contact/"><i class="ph-fill ph-chat-circle-dots"></i> Plan your day</a>
        <button class="theme" type="button" data-theme-btn aria-label="Toggle theme"><i class="ph ph-sun"></i></button>
      </div>
    </div>
  </header>

  <main>
    <section class="stage">
      <img src="/photoshootings/optimized/ravello-photoshooting/hero-1920.webp" alt="" />
      <div class="stage__text">
        <span class="eyebrow">Preview · desktop navigation</span>
        <h1>Hover the menu above</h1>
        <p>Glass bar, sliding highlight, one popup that morphs between panels with direction-aware content. Toggle day/night top right.</p>
      </div>
    </section>
    <section class="plain"><p>Scroll area to check the bar over light content.</p></section>
  </main>

<script is:inline>
;(() => {
  // --- spring → CSS linear() easing (damped harmonic oscillator, mass 1) ---
  const spring = (k, c, steps = 40) => {
    const w0 = Math.sqrt(k), z = c / (2 * w0)
    const x = (t) => {
      if (z < 1) { const wd = w0 * Math.sqrt(1 - z * z); return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t)) }
      return 1 - Math.exp(-w0 * t) * (1 + w0 * t)
    }
    let T = 0.05; while (Math.abs(1 - x(T)) > 0.001 && T < 2) T += 0.01
    const pts = Array.from({ length: steps + 1 }, (_, i) => +x((T * i) / steps).toFixed(4))
    pts[steps] = 1
    return { easing: `linear(${pts.join(',')})`, ms: Math.round(T * 1000) }
  }
  const root = document.documentElement
  const set = (name, s) => { root.style.setProperty(`--${name}-ease`, s.easing); root.style.setProperty(`--${name}-ms`, s.ms + 'ms') }
  set('hl', spring(500, 40))     // highlight glide
  set('pop', spring(660, 52))    // popup move / resize
  set('in', spring(450, 43))     // incoming content

  const nav = document.querySelector('[data-nm]')
  const list = nav.querySelector('.nm-list')
  const hl = nav.querySelector('.nm-hl')
  const popup = nav.querySelector('[data-popup]')
  const triggers = [...nav.querySelectorAll('.nm-trigger')]
  const panelTriggers = triggers.filter((t) => t.dataset.panel)
  const panels = Object.fromEntries(panelTriggers.map((t) => [t.dataset.panel, document.getElementById(t.dataset.panel)]))
  const reduced = matchMedia('(prefers-reduced-motion: reduce)')
  let active = null, closeTimer, openedAt = 0, pinned = false

  const moveHighlight = (el) => {
    if (!el) { hl.classList.remove('is-on'); return }
    const a = el.getBoundingClientRect(), b = list.getBoundingClientRect()
    const first = !hl.classList.contains('is-on')
    if (first) hl.style.transition = 'opacity 200ms ease'
    hl.style.transform = `translateX(${a.left - b.left}px)`
    hl.style.width = `${a.width}px`
    hl.classList.add('is-on')
    if (first) requestAnimationFrame(() => { hl.style.transition = '' })
  }

  const place = (trigger, panel) => {
    const w = panel.offsetWidth, h = panel.offsetHeight
    const nb = nav.getBoundingClientRect(), tb = trigger.getBoundingClientRect()
    let left = tb.left + tb.width / 2 - w / 2
    left = Math.max(16, Math.min(left, innerWidth - w - 16)) - nb.left
    popup.style.setProperty('--x', `${left}px`)
    popup.style.setProperty('--w', `${w}px`)
    popup.style.setProperty('--h', `${h}px`)
    popup.style.setProperty('--ox', `${tb.left + tb.width / 2 - nb.left - left}px`)
  }

  const open = (trigger) => {
    clearTimeout(closeTimer)
    const id = trigger.dataset.panel
    if (active === id) return
    const panel = panels[id]
    const prev = active && panels[active]
    const fromClosed = !active
    const dir = prev ? (panelTriggers.indexOf(trigger) > panelTriggers.findIndex((t) => t.dataset.panel === active) ? 1 : -1) : 0
    panelTriggers.forEach((t) => t.setAttribute('aria-expanded', String(t === trigger)))
    if (fromClosed) popup.classList.add('no-move')
    place(trigger, panel)
    if (prev) {
      prev.style.setProperty('--dir', -dir)
      prev.classList.remove('is-active', 'is-stagger')
      prev.classList.add('is-leaving')
      setTimeout(() => prev.classList.remove('is-leaving'), 240)
    }
    panel.classList.remove('is-leaving')
    panel.style.setProperty('--dir', dir)
    panel.classList.add('is-entering')
    panel.classList.toggle('is-stagger', fromClosed && !reduced.matches)
    panel.getBoundingClientRect()
    panel.classList.remove('is-entering')
    panel.classList.add('is-active')
    popup.classList.add('is-open')
    if (fromClosed) { popup.getBoundingClientRect(); requestAnimationFrame(() => popup.classList.remove('no-move')) }
    active = id
    openedAt = performance.now()
  }

  const close = () => {
    if (!active) return
    panels[active].classList.remove('is-active', 'is-stagger')
    popup.classList.remove('is-open')
    panelTriggers.forEach((t) => t.setAttribute('aria-expanded', 'false'))
    active = null; pinned = false
    moveHighlight(null)
  }
  const scheduleClose = () => { if (pinned) return; clearTimeout(closeTimer); closeTimer = setTimeout(close, 160) }

  triggers.forEach((t) => {
    t.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return
      moveHighlight(t)
      if (t.dataset.panel) open(t)
      else scheduleClose()
    })
    t.addEventListener('focus', () => moveHighlight(t))
    if (!t.dataset.panel) return
    t.addEventListener('click', () => {
      // A click within 500ms of the hover that opened it pins the menu open.
      if (active === t.dataset.panel) {
        if (performance.now() - openedAt < 500) { pinned = true; return }
        close(); return
      }
      open(t); pinned = true; moveHighlight(t)
    })
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return
      e.preventDefault(); open(t); moveHighlight(t)
      panels[t.dataset.panel].querySelector('a')?.focus()
    })
  })
  nav.addEventListener('pointerleave', scheduleClose)
  nav.addEventListener('pointerenter', () => clearTimeout(closeTimer))
  list.addEventListener('pointerleave', () => { if (!active) moveHighlight(null) })
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !active) return
    const t = panelTriggers.find((x) => x.dataset.panel === active); close(); t.focus()
  })
  document.addEventListener('click', (e) => { if (!nav.contains(e.target)) close() })
  nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget)) close() })
  addEventListener('resize', () => { if (active) place(panelTriggers.find((x) => x.dataset.panel === active), panels[active]) })

  // Theme toggle + scrolled state for the preview
  document.querySelector('[data-theme-btn]').addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'night' ? 'day' : 'night'
  })
  const hdr = document.querySelector('.hdr')
  const bar = hdr.querySelector('.bar')
  const actions = hdr.querySelector('.actions')
  // Collapsed width = monogram + menu + actions with their compact sizes (fixed numbers, so the
  // capsule does not chase animated widths): pad 10 + logo 38 + gap 12 + list + gap 12 + actions + pad 6.
  const measure = () => {
    const ctaW = hdr.querySelector('.cta').offsetWidth - (hdr.classList.contains('is-scrolled') ? 0 : 4)  // 18px → 16px side padding
    const actionsW = ctaW + 6 + 40
    bar.style.setProperty('--compact-w', `${10 + 38 + 12 + list.scrollWidth + 12 + actionsW + 6}px`)
  }
  let scrolled = false
  const onScroll = () => {
    // Hysteresis keeps the morph steady near the threshold.
    const next = scrollY > (scrolled ? 16 : 48)
    if (next === scrolled) return
    scrolled = next
    close()
    hdr.classList.toggle('is-scrolled', scrolled)
  }
  measure()
  addEventListener('resize', measure)
  addEventListener('scroll', onScroll, { passive: true }); onScroll()
})()
</script>

<style is:global>
  body { margin: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); }
  .stage { position: relative; height: 92vh; min-height: 620px; overflow: hidden; }
  .stage > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .stage::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35), transparent 30%, rgba(0,0,0,.45)); }
  .stage__text { position: absolute; z-index: 1; left: 64px; bottom: 72px; max-width: 560px; color: #fff; }
  .stage__text h1 { font-family: var(--font-display); font-size: 52px; line-height: 1.15; margin: 12px 0; }
  .stage__text .eyebrow { color: rgba(255,255,255,.8); }
  .plain { height: 120vh; display: grid; place-items: start center; padding-top: 80px; color: var(--color-text-muted); }

  .hdr {
    --ink: #141414; --muted: #6b6b6b; --line: rgba(20,20,20,.1);
    --panel: rgba(255,255,255,.94); --hover: rgba(20,20,20,.06); --accent: #ff5900;
    --morph: 460ms; --morph-ease: cubic-bezier(.33,1,.68,1);
    position: fixed; z-index: 50; inset: 0 0 auto; padding: 14px 24px;
    transition: padding var(--morph) var(--morph-ease);
  }
  .hdr.is-scrolled { padding-top: 10px; }
  [data-theme='night'] .hdr { --ink: #fff; --muted: #a9adb5; --line: rgba(255,255,255,.12); --panel: rgba(20,23,27,.93); --hover: rgba(255,255,255,.08); }
  .bar {
    box-sizing: border-box; width: min(1320px, 100%); margin: 0 auto; height: 64px; padding: 0 10px 0 22px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    transition: width var(--morph) var(--morph-ease), height var(--morph) var(--morph-ease), padding var(--morph) var(--morph-ease), background .3s ease, box-shadow .3s ease;
    border-radius: 999px; color: var(--ink);
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    border: 1px solid var(--line);
    box-shadow: 0 8px 30px rgba(10,20,30,.08), inset 0 1px 0 rgba(255,255,255,.35);
    -webkit-backdrop-filter: blur(24px) saturate(160%); backdrop-filter: blur(24px) saturate(160%);
  }
  .logo { flex-shrink: 0; position: relative; display: block; width: 150px; height: 44px; color: var(--ink); transition: width var(--morph) var(--morph-ease); }
  /* Collapsed: the bar shrinks horizontally around its contents, the wordmark morphs into the monogram. */
  .is-scrolled .bar { width: var(--compact-w, 760px); height: 54px; padding: 0 6px 0 10px; background: color-mix(in srgb, var(--panel) 82%, transparent); box-shadow: 0 10px 34px rgba(10,20,30,.14), inset 0 1px 0 rgba(255,255,255,.35); }
  .is-scrolled .logo { width: 38px; }
  .cta, .theme, .nm-trigger { transition: height var(--morph) var(--morph-ease), padding var(--morph) var(--morph-ease), background .18s, transform .18s; }
  .is-scrolled .cta { height: 40px; padding: 0 16px; }
  .is-scrolled .theme { width: 40px; height: 40px; }
  .actions { flex-shrink: 0; display: flex; align-items: center; gap: 6px; }
  .cta { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; white-space: nowrap; background: var(--accent); color: #fff; font-size: 14px; font-weight: 600; text-decoration: none; transition: transform .18s, background .18s; }
  .cta:hover { text-decoration: none; color: #fff; background: color-mix(in srgb, var(--accent) 90%, #000); transform: translateY(-1px); }
  .theme { width: 44px; height: 44px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font-size: 18px; cursor: pointer; }
  .theme:hover { background: var(--hover); }

  /* --- Navigation menu --- */
  .nm { position: relative; flex-shrink: 0; }
  .nm-list { position: relative; display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; isolation: isolate; }
  .nm-hl {
    position: absolute; z-index: -1; top: 0; left: 0; height: 40px; width: 0; border-radius: 999px;
    background: var(--hover); opacity: 0; pointer-events: none;
    transition: transform var(--hl-ms) var(--hl-ease), width var(--hl-ms) var(--hl-ease), opacity 200ms ease;
  }
  .nm-hl.is-on { opacity: 1; }
  .nm-trigger {
    display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 15px;
    border: 0; border-radius: 999px; background: transparent; color: var(--ink);
    font: 500 14.5px/1 var(--font-body); text-decoration: none; cursor: pointer; white-space: nowrap;
  }
  .nm-trigger:hover { text-decoration: none; color: var(--ink); }
  .nm-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nm-trigger i { font-size: 11px; opacity: .6; transition: transform .2s; }
  .nm-trigger[aria-expanded='true'] i { transform: rotate(180deg); }
  .nm-pill { padding: 3px 6px; border-radius: 999px; background: var(--accent); color: #fff; font: 600 10px/1 var(--font-mono); }

  .nm-popup {
    position: absolute; top: calc(100% + 18px); left: var(--x, 0);
    width: var(--w, 600px); height: var(--h, 300px);
    transform: scale(.9); transform-origin: var(--ox, 50%) 0;
    opacity: 0; pointer-events: none;
    border-radius: 22px; border: 1px solid var(--line); overflow: hidden;
    background: var(--panel); color: var(--ink);
    box-shadow: 0 24px 60px rgba(10,20,30,.18), 0 2px 8px rgba(10,20,30,.06);
    -webkit-backdrop-filter: blur(28px) saturate(160%); backdrop-filter: blur(28px) saturate(160%);
    transition:
      opacity 220ms cubic-bezier(.215,.61,.355,1),
      transform 220ms cubic-bezier(.215,.61,.355,1),
      left var(--pop-ms) var(--pop-ease),
      width var(--pop-ms) var(--pop-ease), height var(--pop-ms) var(--pop-ease);
  }
  .nm-popup.is-open { opacity: 1; pointer-events: auto; transform: none; }
  .nm-popup.no-move { transition: opacity 220ms cubic-bezier(.215,.61,.355,1), transform 220ms cubic-bezier(.215,.61,.355,1); }
  /* bridge so the pointer can cross the gap */
  .nm-popup::before { content: ''; position: absolute; inset: -20px 0 auto; height: 20px; }
  .nm-viewport { position: relative; width: 100%; height: 100%; }

  .nm-panel {
    position: absolute; top: 0; left: 0; box-sizing: border-box; padding: 14px;
    visibility: hidden; opacity: 0; transform: translateX(calc(var(--dir, 0) * 24px));
    transition: opacity 260ms ease, transform var(--in-ms) var(--in-ease), visibility 0s 260ms;
  }
  .nm-panel.is-entering { transition: none; }
  .nm-panel.is-active { visibility: visible; opacity: 1; transform: none; transition: opacity 260ms ease, transform var(--in-ms) var(--in-ease); }
  .nm-panel.is-leaving { visibility: visible; opacity: 0; transform: translateX(calc(var(--dir, 0) * 24px)); transition: opacity 220ms ease, transform 220ms ease; pointer-events: none; }
  /* stagger on first open */
  .nm-panel [style*='--i'] { transition: opacity .3s cubic-bezier(.215,.61,.355,1), transform .3s cubic-bezier(.215,.61,.355,1), filter .3s, background .16s; }
  .nm-panel.is-stagger [style*='--i'] { animation: nm-row .3s cubic-bezier(.215,.61,.355,1) both; animation-delay: calc(var(--i) * 33ms); }
  @keyframes nm-row { from { opacity: 0; transform: translateX(8px); filter: blur(4px); } }

  .nm-panel--photo { width: 760px; display: grid; grid-template-columns: 260px 1fr 190px; gap: 6px; }
  .nm-panel--stay { width: 640px; display: grid; grid-template-columns: 290px 1fr; gap: 6px; }
  .nm-panel--tours { width: 720px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .nm-panel--guide { width: 620px; display: grid; grid-template-columns: 1fr 170px; grid-template-rows: auto auto; gap: 6px; }

  .nm-panel .eyebrow { display: block; padding: 8px 10px 6px; font: 500 10px/1.6 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .nm-panel a { color: var(--ink); text-decoration: none; }
  .nm-panel a:hover { text-decoration: none; color: var(--ink); }
  .nm-panel a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .col { display: flex; flex-direction: column; padding: 4px 4px; }
  .col--narrow { border-left: 1px solid var(--line); padding-left: 10px; }

  .feat { position: relative; display: block; min-height: 300px; border-radius: 14px; overflow: hidden; color: #fff !important; }
  .feat--tall { min-height: 380px; }
  .feat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .feat:hover img { transform: scale(1.05); }
  .feat::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(0,0,0,.72)); }
  .feat__body { position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 16px; display: flex; flex-direction: column; gap: 4px; }
  .feat .eyebrow { padding: 0; color: rgba(255,255,255,.75); }
  .feat__title { font: 400 24px/1.2 var(--font-display); }
  .feat__title em { color: var(--accent); }
  .feat__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 13px; font-weight: 500; }
  .sticker { position: absolute; z-index: 1; top: 14px; right: 14px; display: grid; place-items: center; width: 74px; height: 74px; border-radius: 50%; background: var(--accent); color: #fff; text-align: center; font: 500 10px/1.15 var(--font-body); transform: rotate(-10deg); box-shadow: 0 6px 18px rgba(0,0,0,.25); }
  .sticker b { font: 700 20px/1 var(--font-body); }

  .row { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 12px; }
  .row:hover { background: var(--hover); }
  .row img, .row__icon { flex-shrink: 0; width: 46px; height: 46px; border-radius: 10px; object-fit: cover; }
  .row__icon { display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-size: 20px; }
  .row b { display: block; font-size: 14.5px; font-weight: 500; }
  .row small { display: block; margin-top: 2px; font-size: 12.5px; color: var(--muted); }
  .row:hover .row__icon { background: var(--accent); color: #fff; }

  .link { padding: 9px 10px; border-radius: 10px; font-size: 14px; }
  .link:hover { background: var(--hover); }
  .note { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 12px 10px; border-radius: 10px; font-size: 12.5px; color: var(--muted) !important; }
  .note i { color: var(--accent); }
  .note:hover { background: var(--hover); color: var(--ink) !important; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding: 12px 10px; font-size: 13px; font-weight: 500; text-decoration: none !important; }
  .more span { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 6px; }
  .more i { color: var(--accent); }
  .more--wide { grid-column: 1 / -1; justify-self: start; margin-top: 0; padding-top: 4px; }

  .card { display: flex; flex-direction: column; border-radius: 14px; overflow: hidden; background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .card img { width: 100%; height: 150px; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .card:hover img { transform: scale(1.05); }
  .card__body { display: flex; flex-direction: column; gap: 4px; padding: 4px 6px 14px; }
  .card__body .eyebrow { padding: 8px 6px 0; }
  .card b { padding: 0 6px; font: 400 17px/1.3 var(--font-display); }
  .card small { padding: 0 6px; font-size: 12.5px; line-height: 1.45; color: var(--muted); }

  .mini { grid-column: 1 / -1; position: relative; display: flex; align-items: flex-end; height: 92px; border-radius: 14px; overflow: hidden; color: #fff !important; }
  .mini img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .mini::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.6), transparent 70%); }
  .mini span { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; padding: 14px 16px; font-size: 14px; font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .nm-hl, .nm-popup, .nm-panel, .nm-panel * { transition: opacity .15s ease !important; animation: none !important; transform: none !important; }
  }
</style>
</body>
</html>
