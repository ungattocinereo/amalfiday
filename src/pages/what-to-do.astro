---
import BaseLayout from '../layouts/BaseLayout.astro'
import CldImage from '../components/CldImage.astro'
import { site } from '../data/site'

const pageTitle = "What to Do on the Amalfi Coast — A Local's Picks by Town"
const pageDescription =
  "What to do on the Amalfi Coast, picked by a local in Atrani: Amalfi, Ravello, Positano, the Path of the Gods, Tramonti food stops, boats and photo spots."
const heroImage = '/staticpages/car-tours/positano-Hero-tours-amalfi-coast-by-car-3.webp'
const shareImageAlt = 'Positano seen from the coastal road on the Amalfi Coast'
const pageUrl = `${site.url}/what-to-do`
const pageUpdatedISO = '2026-11-15'
const pageUpdatedLabel = 'November 2026'

type Pick = {
  name: string
  why: string
  when: string
  time: string
  links: { href: string; label: string }[]
}

type Group = {
  id: string
  kicker: string
  title: string
  accent: string
  intro: string
  picks: Pick[]
}

const groups: Group[] = [
  {
    id: 'atrani-amalfi',
    kicker: 'Start here',
    title: 'Atrani and',
    accent: 'Amalfi',
    intro:
      'I live in Atrani, so this is where my list starts. The two towns are a 10-minute walk apart, and most buses and ferries stop in Amalfi.',
    picks: [
      {
        name: 'Atrani at sunrise',
        why: 'Atrani is one of the smallest towns in Italy: a beach, a little square under the arch, and houses stacked up the valley. Before the day-trippers arrive it is completely yours, which is why I take most sunrise photoshoots here.',
        when: 'Early morning, all year',
        time: '1 hour',
        links: [
          { href: '/photoshootings/', label: 'Sunrise photoshoot with Greg' },
          { href: '/directions/', label: 'Walk from Amalfi to Atrani' },
        ],
      },
      {
        name: 'Amalfi Cathedral and the old town',
        why: "The Cathedral of Sant'Andrea, with its striped facade and long flight of steps, is the centre of town. Walk past it and keep going uphill: the lanes behind the main street are quieter and full of small food shops.",
        when: 'Morning, before the ferries unload',
        time: '1-2 hours',
        links: [
          { href: '/photoshootings/amalfi-photographer/', label: 'Photoshoot in Amalfi' },
          { href: '/timetables/', label: 'Bus timetables' },
        ],
      },
      {
        name: 'Valle delle Ferriere walk',
        why: 'A shaded path into the valley above Amalfi, past old paper mills and small waterfalls. It is a good escape on a hot day, when the seafront is crowded.',
        when: 'Spring to autumn, in the morning',
        time: 'Half a day',
        links: [{ href: '/parking/', label: 'Parking in Amalfi' }],
      },
    ],
  },
  {
    id: 'ravello',
    kicker: 'Above the sea',
    title: 'Ravello and',
    accent: 'its gardens',
    intro:
      'Ravello sits 365 metres above the sea, so the views are wide and the air is cooler. SITA bus 5110 and the Amico shuttle (10€ one way) climb up from Amalfi.',
    picks: [
      {
        name: 'Villa Rufolo and Villa Cimbrone',
        why: 'Two historic villas with gardens hanging over the coast. At Villa Cimbrone, walk to the Terrace of Infinity, a balcony of marble busts that looks straight down to the sea. In summer the Ravello Festival holds concerts in Villa Rufolo.',
        when: 'Late afternoon, for the softest light',
        time: 'Half a day with lunch',
        links: [
          { href: '/photoshootings/ravello-photographer/', label: 'Photoshoot in Ravello' },
          { href: '/experience/car-tours/', label: 'Car tour with a Ravello stop' },
        ],
      },
    ],
  },
  {
    id: 'positano-west',
    kicker: 'West of Amalfi',
    title: 'Positano and',
    accent: 'the cliffs',
    intro:
      'The road west of Amalfi is the most dramatic stretch of the coast, and the most crowded in summer. Take the ferry when the sea allows it: Amalfi to Positano takes about 25 minutes.',
    picks: [
      {
        name: 'Positano',
        why: 'The most photographed town on the coast, with pastel houses falling down to a busy beach. Go for the view and a slow walk through the lanes, and expect the highest prices on the coast.',
        when: 'Morning or early evening; avoid midday in August',
        time: 'Half a day',
        links: [
          { href: '/ferry-timetables/', label: 'Ferry from Amalfi or Salerno' },
          { href: '/photoshootings/positano-photographer/', label: 'Photoshoot in Positano' },
        ],
      },
      {
        name: 'Path of the Gods',
        why: 'The famous walking trail high above Positano, starting near Agerola. You walk on a ledge between the mountains and the sea, with the whole coast below you.',
        when: 'Spring and autumn, starting early',
        time: 'Half a day',
        links: [
          { href: '/photoshootings/path-of-the-gods-photographer/', label: 'Photoshoot on the trail' },
          { href: '/moto/', label: 'Ride the road to Agerola' },
        ],
      },
      {
        name: 'Furore fjord and Praiano sunset',
        why: 'Furore is a narrow fjord crossed by a road bridge, one of the most photogenic spots on the coast. A little further west, Praiano and Marina di Praia catch the best golden hour of the day.',
        when: 'Evening',
        time: '2-3 hours',
        links: [
          { href: '/beaches/', label: 'Beach guide' },
          { href: '/experience/scooter/', label: 'Scooter photo tour' },
        ],
      },
    ],
  },
  {
    id: 'east-mountains',
    kicker: 'East and inland',
    title: 'Food, wine and',
    accent: 'mountains',
    intro:
      'East of Atrani the coast gets quieter and more local. Inland, the Tramonti Valley is where much of the coast’s food and wine comes from.',
    picks: [
      {
        name: 'Tramonti and the Valico di Chiunzi',
        why: 'Fresh mozzarella at a small dairy, a tasting at a family winery, then up to the Valico di Chiunzi viewpoint at 880 metres, where you can see Vesuvius on a clear day.',
        when: 'All year; late afternoon for the view',
        time: 'Half a day to a full day',
        links: [
          { href: '/experience/car-tours/', label: 'Peak Flavors car tour' },
          { href: '/moto/', label: 'Tramonti Valley moto route' },
        ],
      },
      {
        name: 'Minori, Maiori, Cetara and Vietri sul Mare',
        why: 'Stop in Minori for pastries at Sal De Riso, swim on Maiori’s long beach, eat anchovies in the fishing village of Cetara, and finish in Vietri sul Mare, the town of hand-painted ceramics.',
        when: 'Any season',
        time: 'A full day by bus or ferry',
        links: [
          { href: '/timetables/', label: 'SITA line 5120' },
          { href: '/ferry-timetables/', label: 'Travelmar ferries' },
        ],
      },
    ],
  },
  {
    id: 'water',
    kicker: 'From the sea',
    title: 'Boats and',
    accent: 'beaches',
    intro:
      'The coast looks different from the water, and some of its best corners can only be reached by boat.',
    picks: [
      {
        name: 'A day on a boat',
        why: 'Amalfi rentals often offer licence-free boats within local limits. Head for the Galli Islands, the sea caves and the coves you cannot reach by road, then anchor for lunch at a trattoria you can only reach from the water.',
        when: 'June to September, on a calm day',
        time: 'Half a day or a full day',
        links: [{ href: '/beaches/', label: 'Practical beach notes' }],
      },
      {
        name: 'The right beach for your mood',
        why: 'Maiori for space, Atrani for calm water, the coves near Erchie for privacy, Positano for the scene. The sea is warmest from June to September, at around 26-28°C.',
        when: 'June to September',
        time: 'As long as you like',
        links: [{ href: '/beaches/', label: '11 beaches reviewed' }],
      },
      {
        name: 'Capri as a day trip',
        why: 'Ferries run from Amalfi, Positano and Salerno to Capri in season. Take an early boat and check the return times before you go.',
        when: 'April to October',
        time: 'A full day',
        links: [{ href: '/ferry-timetables/', label: 'Ferries to Capri' }],
      },
    ],
  },
]

const allPicks = groups.flatMap((group) => group.picks)

const faqs = [
  {
    q: 'What is there to do on the Amalfi Coast?',
    a: 'Walk the lanes of Amalfi and Atrani, visit the gardens of Villa Rufolo and Villa Cimbrone in Ravello, take the ferry to Positano, and hike the Path of the Gods. Inland, the Tramonti Valley has mozzarella dairies and family wineries. From the water you can reach sea caves, the Galli Islands and Capri. Most towns are linked by SITA buses and seasonal ferries.',
  },
  {
    q: 'How many days do you need on the Amalfi Coast?',
    a: 'Three to four days is a comfortable minimum: one for Amalfi and Atrani, one for Ravello, one for Positano and the Path of the Gods, and a spare day for a boat, the beach or the Tramonti Valley. Buses and ferries are slow in summer, so it helps to stay in one central town, like Atrani or Amalfi, and take day trips from there.',
  },
  {
    q: 'Which town is the best base on the Amalfi Coast?',
    a: 'Amalfi and Atrani are the most practical bases. They sit in the middle of the coast, Amalfi is the main hub for SITA buses and ferries, and Atrani is a 10-minute walk away but much quieter. Positano is beautiful but harder for transport, and Ravello is calm but up a steep road.',
  },
  {
    q: 'Can you see the Amalfi Coast without a car?',
    a: 'Yes. SITA buses link every coastal town, ferries run between Salerno, Amalfi and Positano in season, and parking is scarce and expensive anyway. A car is useful for the Tramonti Valley and the mountain roads, but you can also book a private car tour and let a local guide do the driving.',
  },
  {
    q: 'When is the best time to visit the Amalfi Coast?',
    a: 'May, June and September are the sweet spot: warm sea, long days and fewer crowds than July and August. The beach season runs from around Easter to early November, and most ferry routes run from April to October. Winter is quiet and cheaper, with fewer boats and more local life.',
  },
]

const nextLinks = [
  {
    href: '/photoshootings/',
    icon: 'ph-camera',
    title: 'Photoshoots with Greg',
    text: 'Couple and solo sessions in Atrani, Amalfi and Ravello, from €200, with posing help throughout.',
  },
  {
    href: '/experience/car-tours/',
    icon: 'ph-car-profile',
    title: 'Private car tours',
    text: 'Scenic Coast or Peak Flavors with a local guide, up to 3 or 4–6 hours.',
  },
  {
    href: '/experience/scooter/',
    icon: 'ph-gauge',
    title: 'Scooter photo tour',
    text: 'One rider, one guide who photographs the trip, from €350.',
  },
  {
    href: '/apartments/',
    icon: 'ph-house',
    title: 'Stay in Atrani',
    text: 'Suites and rooms by the sea, 10 minutes on foot from Amalfi.',
  },
  {
    href: '/how-to-get/',
    icon: 'ph-airplane-landing',
    title: 'Naples Airport to the coast',
    text: 'Shuttle, train and ferry, or taxi compared.',
  },
  {
    href: '/blog/',
    icon: 'ph-newspaper',
    title: 'Amalfi Notes blog',
    text: 'Routes, photography tips, culture and food from the coast.',
  },
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageTitle,
    description: pageDescription,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    image: new URL(heroImage, site.url).toString(),
    dateModified: pageUpdatedISO,
    author: { '@id': `${site.url}/#business` },
    publisher: { '@id': `${site.url}/#business` },
    inLanguage: 'en',
    about: { '@type': 'Place', name: 'Amalfi Coast' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Things to do on the Amalfi Coast',
    itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: allPicks.length,
    itemListElement: allPicks.map((pick, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'TouristAttraction',
        name: pick.name,
        description: pick.why,
        containedInPlace: { '@type': 'Place', name: 'Amalfi Coast' },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'What to do', item: pageUrl },
    ],
  },
]
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={heroImage}
  imageAlt={shareImageAlt}
  type="article"
  jsonLd={jsonLd}
>
  <section class="wtd-hero hero--dark hero-bottom">
    <CldImage
      class="wtd-hero__image"
      src={heroImage}
      alt="Positano seen from the coastal road"
      width={2500}
      height={1875}
      priority
      sizes="100vw"
    />
    <div class="wtd-hero__veil hero-shade" aria-hidden="true"></div>
    <div class="container wtd-hero__content hero-content hero-container">
      <div class="wtd-hero__copy">
        <span class="badge wtd-hero__badge"><i class="ph ph-compass" aria-hidden="true"></i> Local picks</span>
        <h1>
          What to do on the <span class="accent-italic">Amalfi Coast</span>
        </h1>
        <p class="wtd-hero__lead">
          My own list, from Atrani: the walks, viewpoints, food stops and boat days I send friends
          to, grouped by town, with when to go and how long to allow.
        </p>
        <nav class="wtd-hero__links" aria-label="Sections">
          {groups.map((group) => (
            <a href={`#${group.id}`}>{group.title} {group.accent}</a>
          ))}
        </nav>
      </div>
      <aside class="wtd-hero__aside">
        <div class="wtd-eyebrow">Author note</div>
        <p>
          I live in Atrani, photograph couples and travellers along the coast, and host guests in
          our apartments. These are the places I keep recommending.
        </p>
        <div class="wtd-hero__author">
          <strong>Greg</strong>
          <span>Photographer and host, Amalfi.Day</span>
        </div>
      </aside>
    </div>
  </section>

  <div class="quick-answer" role="region" aria-labelledby="quick-answer-title">
    <div class="container">
      <div class="quick-answer__box">
        <div class="wtd-eyebrow">Quick answer</div>
        <h2 class="quick-answer__title" id="quick-answer-title">What should I do on the Amalfi Coast?</h2>
        <p>
          Base yourself in Amalfi or Atrani and give the coast three or four days. Spend one on the
          Amalfi old town and an early morning in Atrani, one in Ravello's villa gardens, and one
          taking the 25-minute ferry to Positano or walking the Path of the Gods. Keep a spare day
          for a boat, the beach, or a food and wine afternoon in the Tramonti Valley. Not sure
          where to sleep? Read <a href="/where-to-stay-in-atrani/">where to stay in Atrani</a>.
        </p>
        <p class="quick-answer__date">
          Last updated: <time datetime={pageUpdatedISO}>{pageUpdatedLabel}</time>
        </p>
      </div>
    </div>
  </div>

  {groups.map((group) => (
    <section class="section wtd-group" id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="container">
        <div class="section__header">
          <div>
            <div class="wtd-eyebrow">{group.kicker}</div>
            <h2 id={`${group.id}-title`}>
              {group.title} <span class="accent-italic">{group.accent}</span>
            </h2>
          </div>
          <p>{group.intro}</p>
        </div>
        <div class="wtd-grid">
          {group.picks.map((pick) => (
            <article class="card wtd-card">
              <h3>{pick.name}</h3>
              <p>{pick.why}</p>
              <dl class="wtd-card__meta">
                <div>
                  <dt><i class="ph ph-sun" aria-hidden="true"></i> When</dt>
                  <dd>{pick.when}</dd>
                </div>
                <div>
                  <dt><i class="ph ph-clock" aria-hidden="true"></i> How long</dt>
                  <dd>{pick.time}</dd>
                </div>
              </dl>
              <ul class="wtd-card__links">
                {pick.links.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label} <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section wtd-logistics">
    <div class="container">
      <div class="wtd-summary">
        <div class="wtd-eyebrow">Getting around</div>
        <h2>
          Plan the <span class="accent-italic">moves</span> first
        </h2>
        <p>
          Most of the list above depends on buses, ferries and the weather. Check the
          <a href="/timetables/">SITA bus timetables</a> and
          <a href="/ferry-timetables/">ferry timetables</a> for your dates, read the
          <a href="/parking/">parking guide</a> before you rent a car, and plan your arrival with the
          <a href="/how-to-get/">Naples Airport guide</a> and
          <a href="/directions/">directions to Atrani</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section wtd-faq" aria-labelledby="wtd-faq-title">
    <div class="container">
      <div class="section__header">
        <h2 id="wtd-faq-title">
          Trip <span class="accent-italic">questions</span>
        </h2>
        <p>Short answers about days, bases, cars and seasons.</p>
      </div>
      <div class="wtd-faq__list">
        {faqs.map((f) => (
          <details class="wtd-faq__item">
            <summary class="wtd-faq__q">{f.q}</summary>
            <p class="wtd-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section next-links" aria-labelledby="next-links-title">
    <div class="container">
      <div class="section__header">
        <h2 id="next-links-title">
          While you're <span class="accent-italic">here</span>
        </h2>
        <p>Let a local plan part of it: a photoshoot, a private tour, or a place to stay.</p>
      </div>
      <div class="next-links__grid">
        {nextLinks.map((link) => (
          <a class="card next-link" href={link.href}>
            <strong class="next-link__title">
              <i class={`ph ${link.icon}`} aria-hidden="true"></i>
              {link.title}
            </strong>
            <span class="next-link__text">{link.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wtd-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #ffffff;
    padding: calc(var(--header-space) + 4rem) 0 4rem;
  }

  .wtd-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.05);
    z-index: -2;
  }

  .wtd-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(12, 16, 20, 0.9) 0%, rgba(12, 16, 20, 0.35) 45%, rgba(12, 16, 20, 0.08) 70%),
      radial-gradient(circle at 20% 20%, rgba(255, 195, 0, 0.35), transparent 45%);
    z-index: -1;
  }

  .wtd-hero__content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    gap: 2.5rem;
    align-items: end;
  }

  .wtd-hero__badge {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .wtd-hero__copy h1 {
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    margin-top: 1.2rem;
    color: #ffffff;
  }

  .wtd-hero__lead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .wtd-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .wtd-hero__links a {
    color: #ffffff;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    text-decoration: none;
  }

  .wtd-hero__links a:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.9);
  }

  .wtd-hero__aside {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: rgba(12, 16, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
  }

  .wtd-hero__aside p {
    color: rgba(255, 255, 255, 0.82);
  }

  .wtd-hero__author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.4rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .wtd-hero__author strong {
    color: #ffffff;
    font-size: 1rem;
  }

  .wtd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
  }

  .wtd-hero .wtd-eyebrow {
    color: rgba(255, 255, 255, 0.65);
  }

  .section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .section__header h2 {
    font-size: clamp(2.1rem, 3.2vw, 3rem);
    margin-bottom: 0.4rem;
  }

  .section__header p {
    max-width: 28rem;
  }

  .wtd-group:nth-of-type(even) {
    background: var(--color-surface);
  }

  .wtd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .wtd-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.8rem;
  }

  .wtd-card h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .wtd-card p {
    margin: 0;
  }

  .wtd-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0.2rem 0 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .wtd-card__meta dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .wtd-card__meta dd {
    margin: 0.3rem 0 0;
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .wtd-card__links {
    display: grid;
    gap: 0.45rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .wtd-card__links a {
