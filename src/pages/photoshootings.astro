    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .platform-card__logo img {
    max-height: 64px;
    max-width: 240px;
    width: auto;
    object-fit: contain;
  }

  .platform-card--airbnb .platform-card__logo img {
    max-height: 74px;
  }

  .platform-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
    gap: 0.3rem;
  }

  .platform-card__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .platform-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .platform-card__arrow {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .platform-card:hover .platform-card__arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .platforms__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .platform-card {
      flex-direction: row;
      text-align: left;
      padding: 1.2rem 1rem;
      gap: 0.75rem;
    }

    .platform-card__logo {
      width: 64px;
      height: 48px;
      flex-shrink: 0;
    }

    .platform-card .platform-card__logo img {
      max-width: 64px;
      max-height: 48px;
    }

    .platform-card__arrow {
      opacity: 0.4;
      position: static;
      margin-left: auto;
      flex-shrink: 0;
    }
  }

  /* ===== HERO — Full-viewport cinematic ===== */

  .xp-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #0a0a0a;
    color: #ffffff;
  }

  .xp-hero__slides {
    position: absolute;
    inset: -2px;
    z-index: 0;
    overflow: hidden;
  }

  .xp-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    backface-visibility: hidden;
  }

  .xp-hero__slide.is-active {
    opacity: 1;
  }

  .xp-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    backface-visibility: hidden;
  }

  .xp-hero__slide.is-active img {
    animation: xp-ken-burns 6.5s cubic-bezier(0.25, 0, 0.4, 1) forwards;
  }

  @keyframes xp-ken-burns {
    from { transform: scale(1.01); }
    to { transform: scale(1.06); }
  }

  .xp-hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, transparent 65%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 0%, transparent 50%, rgba(0, 0, 0, 0.18) 100%);
    pointer-events: none;
  }

  .xp-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(2.5rem, 5vh, 4.5rem);
  }

  .xp-hero__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
  }

  .xp-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
    opacity: 0;
    animation: xp-fade-up 0.7s 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__title {
    font-size: clamp(2.8rem, 6.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__title-accent {
    font-style: italic;
    color: #ffc300;
    display: inline-block;
  }

  .xp-hero__lead {
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin-top: 1.2rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    border: none;
  }

  .xp-hero__btn--primary {
    background: #ff5900;
    color: #ffffff;
  }

  .xp-hero__btn--primary:hover {
    background: #ff7a33;
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(255, 89, 0, 0.35);
    text-decoration: none;
    color: #ffffff;
  }

  .xp-hero__btn--ghost {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .xp-hero__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    color: #ffffff;
  }

  .xp-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    max-width: 260px;
  }

  .xp-hero__tag {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    opacity: 0;
    animation: xp-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__progress {
    display: flex;
    gap: 0.6rem;
  }

  .xp-hero__dot {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .xp-hero__dot-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0.4;
    transition: opacity 0.4s ease;
  }

  .xp-hero__dot.is-active .xp-hero__dot-label {
    opacity: 1;
  }

  .xp-hero__dot-bar {
    width: 36px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .xp-hero__dot-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: #ff5900;
    border-radius: 2px;
    transform-origin: left center;
    transform: scaleX(0);
  }

  .xp-hero__dot.is-active .xp-hero__dot-fill {
    animation: xp-fill-bar 6s linear forwards;
  }

  @keyframes xp-fill-bar {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .xp-hero__scroll-hint {
    position: absolute;
    bottom: clamp(1rem, 2.5vh, 2rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    opacity: 0;
    animation: xp-fade-up 0.6s 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__scroll-hint span {
    display: block;
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
    animation: xp-scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes xp-scroll-pulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.3); }
  }

  @keyframes xp-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .xp-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .xp-hero__aside {
      align-items: flex-start;
    }

    .xp-hero__tags {
      justify-content: flex-start;
      max-width: none;
    }

    .xp-hero__title {
      font-size: clamp(2.4rem, 10vw, 3.8rem);
    }

    .xp-hero__progress {
      align-self: flex-start;
    }
  }

  /* ── Category header ── */
  .cat-header {
    margin-bottom: 3rem;
  }

  .cat-header h2 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    margin-bottom: 0.8rem;
  }

  .cat-header__desc {
    max-width: 640px;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* ── Shoot card grid ── */
  .shoot-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .shoot-grid--couple {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 1024px) {
    .shoot-grid,
    .shoot-grid--couple {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .shoot-grid,
    .shoot-grid--couple {
      grid-template-columns: 1fr;
    }
  }

  /* ── Centered variant for cat-header ── */
  .cat-header--center {
    text-align: center;
  }

  .cat-header--center .cat-header__desc {
    margin-inline: auto;
  }

  /* ── Testimonials ── */
  .testimonials {
    background: var(--color-surface);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .testimonial {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .testimonial__quote {
    margin: 0;
    padding: 0;
    border: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    font-style: italic;
    flex: 1;
  }

  .testimonial__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .testimonial__rating {
    color: var(--color-text);
    white-space: nowrap;
  }

  .testimonial__rating span {
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  .testimonial__source a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .testimonial__translation {
    margin: 0.8rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .testimonial__footer {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .testimonial__footer strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.15rem;
  }

  .testimonial__footer span {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .testimonial__footer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════════════════════════════════════════
     PRICING SECTION
     ═══════════════════════════════════════════ */

  .pricing {
    background: var(--color-bg);
  }

  .pricing__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .pricing--alt {
    background: var(--color-surface);
  }

  /* ── Every session includes — mini cards ── */
  .included-section {
    background: var(--color-bg);
  }

  .included-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .included-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.8rem 1.5rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .included-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .included-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: rgba(255, 89, 0, 0.08);
    color: var(--color-accent);
    font-size: 1.3rem;
  }

  .included-card__name {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }

  .included-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .included-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .included-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════ TRAVEL TABLE ═══════ */

  .pricing-travel {
    background: var(--color-surface);
  }

  .travel-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .travel-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .travel-table th,
  .travel-table td {
    padding: 0.9rem 1.2rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .travel-table thead th {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .travel-table tbody tr:last-child td {
    border-bottom: none;
  }

  .travel-table tbody td {
    color: var(--color-text-muted);
  }

  .travel-fee {
    font-weight: 600;
    color: var(--color-text);
  }

  .travel-zone {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .travel-zone--0 { background: rgba(0, 200, 83, 0.12); color: #00c853; }
  .travel-zone--1 { background: rgba(0, 156, 255, 0.12); color: var(--color-aux-2); }
  .travel-zone--2 { background: rgba(1, 98, 255, 0.12); color: var(--color-aux); }
  .travel-zone--3 { background: rgba(255, 195, 0, 0.15); color: #d4a200; }
  .travel-zone--4 { background: rgba(255, 89, 0, 0.12); color: var(--color-accent); }
  .travel-zone--5 { background: rgba(255, 89, 0, 0.2); color: var(--color-accent); }

  [data-theme='night'] .travel-zone--3 { color: var(--color-accent-2); }

  .travel-notes {
    margin-top: 1rem;
  }

  .travel-notes p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ═══════ ADD-ONS ═══════ */

  .pricing-addons {
    background: var(--color-bg);
  }

  .addons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .addon-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .addon-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    border-color: var(--color-accent);
  }

  .addon-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(255, 89, 0, 0.08);
    color: var(--color-accent);
    font-size: 1rem;
    flex-shrink: 0;
  }

  .addon-card__body {
    flex: 1;
    min-width: 0;
  }

  .addon-card__name {
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .addon-card__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0;
    line-height: 1.4;
  }

  .addon-card__price {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .addons-note {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .addons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .addons-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════ SEASONAL ═══════ */

  .pricing-seasons {
    background: var(--color-surface);
  }

  .seasons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .season-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.6rem;
    text-align: center;
  }

  .season-card__icon {
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
  }

  .season-card--high .season-card__icon { color: var(--color-accent); }
  .season-card--mid .season-card__icon { color: #ffffff; }
  .season-card--low .season-card__icon { color: var(--color-aux-2); }

  .season-card--mid {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .season-card--mid .season-card__name { color: #ffffff; }
  .season-card--mid .season-card__months { color: rgba(255, 255, 255, 0.7); }
  .season-card--mid .season-card__desc { color: rgba(255, 255, 255, 0.85); }

  .season-card--mid .season-card__badge {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .season-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-text);
    margin: 0 0 0.3rem;
  }

  .season-card__months {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
  }

  .season-card__badge {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 89, 0, 0.1);
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.78rem;
    margin-bottom: 0.8rem;
  }

  .season-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.65;
  }

  .seasons-note {
    text-align: center;
    margin-top: 1.8rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .seasons-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════ POLICIES ═══════ */

  .pricing-policies {
    background: var(--color-bg);
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .policy-block {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.6rem;
  }

  .policy-block h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-text);
    margin: 0 0 0.8rem;
  }

  .policy-block h3 i {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .policy-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .policy-block ul li {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .policy-block ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .policies-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════ FINAL CTA ═══════ */

  .pricing-cta {
    background: var(--color-surface);
  }

  .pricing-cta__inner {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .pricing-cta__tag {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: var(--color-accent);
    margin-bottom: 0.8rem;
  }

  .pricing-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.35;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .pricing-cta__lead {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.8rem;
  }

  .pricing-cta__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .pricing-cta__actions .button {
    padding: 1rem 2rem;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(255, 89, 0, 0.3);
  }

  .pricing-cta__actions .button:hover {
    text-decoration: none;
    color: #ffffff;
    box-shadow: 0 12px 40px rgba(255, 89, 0, 0.45);
  }

  .pricing-cta__whatsapp {
    background: rgba(37, 211, 102, 0.15);
    color: #25d366;
    border: 1px solid rgba(37, 211, 102, 0.3);
  }

  .pricing-cta__whatsapp:hover {
