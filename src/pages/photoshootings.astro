    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }

  @media (min-width: 1025px) {
    #posing-guide { scroll-margin-top: 12rem; }
  }

  .posing-guide__copy .button {
    margin-top: 1rem;
    gap: 0.75rem;
  }

  .posing-guide__copy .posing-guide__note {
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .photography-faq__inner {
    max-width: 900px;
  }

  .photography-faq details {
    border-bottom: 1px solid var(--color-border);
    padding-block: 1.25rem;
  }

