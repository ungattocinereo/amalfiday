      {heroSlides.map((slide, i) => (
        <div class={`xp-hero__slide ${i === 0 ? 'is-active' : ''}`}>
          <img src={slide.image} alt={`Amalfi Coast photoshoot in ${slide.label}`} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="xp-hero__vignette"></div>
    <div class="xp-hero__content">
      <div class="container">
        <div class="xp-hero__grid">
          <div class="xp-hero__copy">
            <span class="xp-hero__eyebrow">Couple &amp; solo photoshoots with Greg</span>
            <h1 class="xp-hero__title">
              Amalfi Coast<br /><span class="xp-hero__title-accent">Photographer</span>
            </h1>
            <p class="xp-hero__lead">
              I'm Gregory, your local photographer in Atrani, Amalfi and Ravello.
              I'll find the light, help you pose, and make you feel at ease in front of the camera.
            </p>
            <div class="xp-hero__actions">
              <a class="xp-hero__btn xp-hero__btn--primary" href="/contact">Book your session</a>
              <a class="xp-hero__btn xp-hero__btn--ghost" href="#pricing">Explore packages</a>
            </div>
          </div>
          <div class="xp-hero__aside">
            <ul class="xp-hero__tags">
              {heroTags.map((tag, i) => (
                <li class="xp-hero__tag" style={`animation-delay: ${0.6 + i * 0.08}s`}>{tag}</li>
              ))}
            </ul>
            <div class="xp-hero__progress">
              {heroSlides.map((slide, i) => (
                <button
                  class={`xp-hero__dot ${i === 0 ? 'is-active' : ''}`}
                  data-slide={i}
                  aria-label={`Show ${slide.label}`}
                >
                  <span class="xp-hero__dot-label">{slide.label}</span>
                  <span class="xp-hero__dot-bar"><span class="xp-hero__dot-fill"></span></span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="xp-hero__scroll-hint" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <script is:inline>
    ;(function () {
      const slides = document.querySelectorAll('.xp-hero__slide')
      const dots = document.querySelectorAll('.xp-hero__dot')
      if (!slides.length) return

      let current = 0
      const DURATION = 6000
      const FADE_DURATION = 1300
      const freezeTimers = new WeakMap()

      function clearSlideFreeze(slide) {
        const image = slide?.querySelector('img')
        if (!image) return
        image.style.animation = ''
        image.style.transform = ''
      }

      function freezeSlideTransform(slide) {
        const image = slide?.querySelector('img')
        if (!image) return

        const transform = window.getComputedStyle(image).transform
        image.style.animation = 'none'
        image.style.transform = transform === 'none' ? '' : transform

        window.clearTimeout(freezeTimers.get(slide))
        freezeTimers.set(
          slide,
          window.setTimeout(() => {
            if (!slide.classList.contains('is-active')) {
              clearSlideFreeze(slide)
            }
            freezeTimers.delete(slide)
          }, FADE_DURATION)
        )
      }

      function go(next) {
        if (next === current) return
        freezeSlideTransform(slides[current])
        slides[current].classList.remove('is-active')
        dots[current].classList.remove('is-active')
        current = next
        clearSlideFreeze(slides[current])
        slides[current].classList.add('is-active')
        dots[current].classList.add('is-active')
      }

      let timer = setInterval(() => go((current + 1) % slides.length), DURATION)

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          clearInterval(timer)
          go(Number(dot.dataset.slide))
          timer = setInterval(() => go((current + 1) % slides.length), DURATION)
        })
      })
    })()
  </script>

  <section class="section photographer-intro" id="gregory" aria-labelledby="photographer-title">
    <div class="container photographer-intro__grid">
      <img class="photographer-intro__portrait" src="/staticpages/gregs-transparency.webp" alt="Gregory, the photographer behind Amalfi.Day, in Atrani" width="700" height="700" loading="lazy" decoding="async" />
