    color: var(--color-text);
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  }

  .platform-card:hover {
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
    border-color: var(--color-accent);
    text-decoration: none;
  }

