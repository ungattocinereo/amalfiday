<style>
  .photographer-intro__grid,
  .posing-guide__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .photographer-intro__portrait {
    width: 100%;
    max-width: 440px;
    height: auto;
    justify-self: center;
    border-radius: 50%;
  }

  .photographer-intro h2,
  .posing-guide h2 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.2;
    margin: 0 0 1.5rem;
  }

  .photographer-intro__copy p,
  .posing-guide__copy p,
  .photography-faq p {
    color: var(--color-text-muted);
    line-height: 1.8;
  }

