    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
  }

  .photography-faq p {
    margin: 1rem 0 0;
  }

  .photography-faq a,
  .posing-guide__copy p a,
  .included-card__desc a,
  .testimonials .cat-header__desc a {
    text-decoration: underline;
