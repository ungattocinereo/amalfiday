    margin-block: 1.5rem;
  }

  .photography-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
  }

  .posing-guide {
    position: relative;
    z-index: 1;
    margin-top: 4rem;
    background: var(--color-surface);
  }

