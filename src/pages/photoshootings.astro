      </div>
      <div class="platforms__grid">

        <a class="platform-card" href={photography.localgrapherUrl} target="_blank" rel="noopener noreferrer">
          <div class="platform-card__logo">
            <img src="/brand/localgrapher.svg" alt="Localgrapher" loading="lazy" width="332" height="171" />
          </div>
          <div class="platform-card__body">
            <span class="platform-card__badge">Meet Gregory</span>
            <span class="platform-card__name">Localgrapher</span>
          </div>
          <i class="fa-solid fa-up-right-from-square platform-card__arrow"></i>
        </a>

        <a class="platform-card" href={photography.getYourGuideUrl} target="_blank" rel="noopener noreferrer">
          <div class="platform-card__logo">
            <img src="/brand/getyourguide.png" alt="GetYourGuide" loading="lazy" width="285" height="100" />
          </div>
          <div class="platform-card__body">
            <span class="platform-card__badge">Sunrise photo walk &amp; reviews</span>
            <span class="platform-card__name">GetYourGuide</span>
          </div>
          <i class="fa-solid fa-up-right-from-square platform-card__arrow"></i>
        </a>

        <a class="platform-card platform-card--airbnb" href={photography.airbnbUrl} target="_blank" rel="noopener noreferrer">
          <div class="platform-card__logo">
            <img src="/brand/airbnb.avif" alt="Airbnb" loading="lazy" width="480" height="480" />
          </div>
          <div class="platform-card__body">
            <span class="platform-card__badge">Photography by Greg</span>
            <span class="platform-card__name">Airbnb</span>
          </div>
          <i class="fa-solid fa-up-right-from-square platform-card__arrow"></i>
        </a>

      </div>
    </div>
  </section>

  <section class="section posing-guide" id="posing-guide" aria-labelledby="posing-title">
    <div class="container posing-guide__grid">
      <div class="posing-guide__copy">
        <span class="pricing__eyebrow">A little inspiration before we meet</span>
        <h2 id="posing-title">Never posed before?<br /><span class="accent-italic">I'll help you.</span></h2>
        <p>During your session, I'll guide you through simple poses and movements. You can relax, ask questions and take your time.</p>
        <p>Use my free PhotoPoses guide at <a href={photography.poseGuideUrl} target="_blank" rel="noopener noreferrer">poses.amalfi.day</a> to browse ideas before your shoot. Bookmark a few favorites on your phone and we'll adapt them to you and the location.</p>
        <a class="button" href={photography.poseGuideUrl} target="_blank" rel="noopener noreferrer">Explore the free posing guide <span aria-hidden="true">↗</span></a>
        <p class="posing-guide__note">Bring your favorite ideas, or let me guide you from the first frame.</p>
      </div>
      <a class="posing-guide__preview" href={photography.poseGuideUrl} target="_blank" rel="noopener noreferrer" aria-label="Preview PhotoPoses, Greg's free posing guide">
        <img src="/pose-guide/photoposes-preview.jpg" alt="PhotoPoses guide with posing ideas for photos around Amalfi" width="1800" height="871" loading="lazy" decoding="async" />
        <span>PhotoPoses <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <!-- ═══════ 1. INDIVIDUAL GALLERY ═══════ -->
  <section class="section section--individual">
    <div class="container">
      <div class="cat-header">
        <h2>Individual <span class="accent-italic">Sessions</span></h2>
        <p class="cat-header__desc">
          Every solo session is a private journey through the Amalfi Coast's most cinematic corners.
          No rush, no groups — just you, golden light, and a story waiting to be told.
        </p>
      </div>
      <div class="shoot-grid">
        {individualShoots.map((item) => (
          <a class="shoot-card" href={item.href}>
            <div class="shoot-card__media">
              <img class="shoot-card__img shoot-card__img--main" src={item.image} alt={item.title} loading="lazy" decoding="async" />
              <img class="shoot-card__img shoot-card__img--hover" src={item.hoverImage} alt="" loading="lazy" decoding="async" />
            </div>
            <span class="shoot-card__tag">{item.tag}</span>
            <div class="shoot-card__overlay">
              <div class="shoot-card__location"><i class="fa-solid fa-location-dot"></i> {item.location}</div>
              <h3 class="shoot-card__title">{item.title}</h3>
              <p class="shoot-card__desc">{item.desc}</p>
              <span class="shoot-card__cta">View story <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ 2. SOLO PRICING ═══════ -->
  <section class="section pricing" id="pricing">
    <div class="container">
      <div class="cat-header cat-header--center">
        <span class="pricing__eyebrow">Transparent Pricing</span>
        <h2>Solo &amp; Individual <span class="accent-italic">Packages</span></h2>
        <p class="cat-header__desc">
          No hidden fees, no platform commissions. Direct booking with a local photographer who lives on the coast.
        </p>
      </div>
      <div class="pricing__cards">
        <div class="pricing-card" id={photographyPackages.portrait.id}>
          <div class="pricing-card__head">
            <span class="pricing-card__tag">Personal</span>
            <h3 class="pricing-card__name">{photographyPackages.portrait.name}</h3>
            <p class="pricing-card__tagline">Quick &amp; cinematic — your Amalfi moment</p>
            <div class="pricing-card__price">&euro;{photographyPackages.portrait.price}</div>
          </div>
          <ul class="pricing-card__list">
            <li><i class="fa-solid fa-clock"></i> ~45 minutes</li>
            <li><i class="fa-solid fa-location-dot"></i> 2 locations in Atrani</li>
            <li><i class="fa-solid fa-image"></i> 25+ retouched photos</li>
            <li><i class="fa-solid fa-sun"></i> Morning or golden hour</li>
            <li><i class="fa-solid fa-mobile-screen-button"></i> Social-ready formats (IG, LinkedIn)</li>
            <li><i class="fa-solid fa-cloud-arrow-down"></i> Online gallery, 7 business days</li>
          </ul>
          <div class="pricing-card__ideal">
            <strong>Ideal for:</strong> Solo travelers, content creators, professional portraits abroad
          </div>
          <a class="pricing-card__btn" href="/contact">Book this session</a>
        </div>

        <div class="pricing-card pricing-card--featured" id={photographyPackages.coastal.id}>
