            <span class="platform-card__badge">Meet Gregory</span>
            <span class="platform-card__name">Localgrapher</span>
          </div>
          <i class="ph ph-arrow-square-out platform-card__arrow" aria-hidden="true"></i>
        </a>

        <a class="platform-card" href={photography.getYourGuideUrl} target="_blank" rel="noopener noreferrer">
          <div class="platform-card__logo">
            <img src="/brand/getyourguide.png" alt="GetYourGuide" loading="lazy" width="285" height="100" />
          </div>
          <div class="platform-card__body">
            <span class="platform-card__badge">Sunrise photo walk &amp; reviews</span>
            <span class="platform-card__name">GetYourGuide</span>
          </div>
          <i class="ph ph-arrow-square-out platform-card__arrow" aria-hidden="true"></i>
        </a>

        <a class="platform-card platform-card--airbnb" href={photography.airbnbUrl} target="_blank" rel="noopener noreferrer">
          <div class="platform-card__logo">
            <img src="/brand/airbnb.avif" alt="Airbnb" loading="lazy" width="480" height="480" />
          </div>
          <div class="platform-card__body">
            <span class="platform-card__badge">Photography by Greg</span>
            <span class="platform-card__name">Airbnb</span>
          </div>
          <i class="ph ph-arrow-square-out platform-card__arrow" aria-hidden="true"></i>
        </a>

      </div>
    </div>
  </section>

  <section class="section posing-guide" id="posing-guide" aria-labelledby="posing-title">
    <div class="container posing-guide__grid">
      <div class="posing-guide__copy">
        <span class="pricing__eyebrow">A little inspiration before we meet</span>
        <h2 id="posing-title">Never posed before?<br /><span class="accent-italic">I'll help you.</span></h2>
        <p>During your session, I'll guide you through simple poses and movements. You can relax, ask questions and take your time.</p>
        <p>Use my free PhotoPoses guide at <a href={photography.poseGuideUrl} target="_blank" rel="noopener noreferrer">poses.amalfi.day</a> to browse ideas before your shoot. Bookmark a few favorites on your phone and we'll adapt them to you and the location.</p>
        <a class="button" href={photography.poseGuideUrl} target="_blank" rel="noopener noreferrer">Explore the free posing guide <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        <p class="posing-guide__note">Bring your favorite ideas, or let me guide you from the first frame.</p>
      </div>
      <PoseGuidePhone href={photography.poseGuideUrl} />
    </div>
  </section>

  <!-- ═══════ 1. INDIVIDUAL GALLERY ═══════ -->
  <section class="section section--individual" id="individual">
    <div class="container">
      <div class="cat-header">
        <h2>Individual <span class="accent-italic">Sessions</span></h2>
        <p class="cat-header__desc">
