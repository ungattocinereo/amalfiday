  .photography-faq summary {
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
  }

  .photography-faq p {
    margin: 1rem 0 0;
  }

  .photography-faq a,
  .posing-guide__copy p a,
  .included-card__desc a,
  .testimonials .cat-header__desc a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .photography-faq summary:focus-visible,
  .photography-link:focus-visible,
  .posing-guide a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  :is(section, .pricing-card)[id] {
    scroll-margin-top: 6rem;
  }

  @media (max-width: 768px) {
    .photographer-intro__grid,
    .posing-guide__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .photographer-intro__portrait {
      max-width: 280px;
    }
  }

  /* ===== PLATFORM PRESENCE ===== */

  .platforms {
    padding: 4rem 0 0;
  }

  .platforms__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .platform-card {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1.8rem 1.5rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  }

  .platform-card:hover {
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .platform-card__logo {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .platform-card__logo img {
    max-height: 64px;
    max-width: 240px;
    width: auto;
    object-fit: contain;
  }

  .platform-card--airbnb .platform-card__logo img {
    max-height: 74px;
  }

  .platform-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
    gap: 0.3rem;
  }

  .platform-card__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .platform-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .platform-card__arrow {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .platform-card:hover .platform-card__arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .platforms__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .platform-card {
      flex-direction: row;
      text-align: left;
      padding: 1.2rem 1rem;
      gap: 0.75rem;
    }

    .platform-card__logo {
      width: 64px;
      height: 48px;
      flex-shrink: 0;
    }

    .platform-card .platform-card__logo img {
      max-width: 64px;
      max-height: 48px;
    }

    .platform-card__arrow {
      opacity: 0.4;
      position: static;
      margin-left: auto;
      flex-shrink: 0;
    }
  }

  /* ===== HERO — Full-viewport cinematic ===== */

  .xp-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #0a0a0a;
    color: #ffffff;
  }

  .xp-hero__slides {
    position: absolute;
    inset: -2px;
    z-index: 0;
    overflow: hidden;
  }

  .xp-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    backface-visibility: hidden;
  }

  .xp-hero__slide.is-active {
    opacity: 1;
  }

  .xp-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    backface-visibility: hidden;
  }

  .xp-hero__slide.is-active img {
    animation: xp-ken-burns 6.5s cubic-bezier(0.25, 0, 0.4, 1) forwards;
  }

  @keyframes xp-ken-burns {
    from { transform: scale(1.01); }
    to { transform: scale(1.06); }
  }

  .xp-hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, transparent 65%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 0%, transparent 50%, rgba(0, 0, 0, 0.18) 100%);
    pointer-events: none;
  }

  .xp-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(2.5rem, 5vh, 4.5rem);
  }

  .xp-hero__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
  }

  .xp-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
    opacity: 0;
    animation: xp-fade-up 0.7s 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__title {
    font-size: clamp(2.8rem, 6.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__title-accent {
    font-style: italic;
    color: #ffc300;
    display: inline-block;
  }

  .xp-hero__lead {
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin-top: 1.2rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    border: none;
  }

  .xp-hero__btn--primary {
    background: #ff5900;
    color: #ffffff;
  }

  .xp-hero__btn--primary:hover {
    background: #ff7a33;
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(255, 89, 0, 0.35);
    text-decoration: none;
    color: #ffffff;
  }

  .xp-hero__btn--ghost {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .xp-hero__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    color: #ffffff;
  }

  .xp-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2rem;
    opacity: 0;
    animation: xp-fade-up 0.8s 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    max-width: 260px;
  }

  .xp-hero__tag {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    opacity: 0;
    animation: xp-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__progress {
    display: flex;
    gap: 0.6rem;
  }

  .xp-hero__dot {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .xp-hero__dot-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0.4;
    transition: opacity 0.4s ease;
  }

  .xp-hero__dot.is-active .xp-hero__dot-label {
    opacity: 1;
  }

  .xp-hero__dot-bar {
    width: 36px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .xp-hero__dot-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: #ff5900;
    border-radius: 2px;
    transform-origin: left center;
    transform: scaleX(0);
  }

  .xp-hero__dot.is-active .xp-hero__dot-fill {
    animation: xp-fill-bar 6s linear forwards;
  }

  @keyframes xp-fill-bar {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .xp-hero__scroll-hint {
    position: absolute;
    bottom: clamp(1rem, 2.5vh, 2rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    opacity: 0;
    animation: xp-fade-up 0.6s 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .xp-hero__scroll-hint span {
    display: block;
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
    animation: xp-scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes xp-scroll-pulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.3); }
  }

  @keyframes xp-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .xp-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .xp-hero__aside {
      align-items: flex-start;
    }

    .xp-hero__tags {
      justify-content: flex-start;
      max-width: none;
    }

    .xp-hero__title {
      font-size: clamp(2.4rem, 10vw, 3.8rem);
    }

    .xp-hero__progress {
      align-self: flex-start;
    }
  }

  /* ── Category header ── */
  .cat-header {
    margin-bottom: 3rem;
  }

  .cat-header h2 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    margin-bottom: 0.8rem;
  }

  .cat-header__desc {
    max-width: 640px;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* ── Shoot card grid ── */
  .shoot-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .shoot-grid--couple {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shoot-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    height: 440px;
    display: block;
    text-decoration: none;
    color: #ffffff;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s ease;
  }

  .shoot-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    text-decoration: none;
  }

  .shoot-card--wide {
    height: 480px;
  }

  /* --- Media: dual image with hover swap --- */
  .shoot-card__media {
    position: absolute;
    inset: 0;
    background-color: #111;
  }

  .shoot-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 6s cubic-bezier(0.25, 0, 0.4, 1);
  }

  .shoot-card__img--main {
    opacity: 1;
    z-index: 1;
  }

  .shoot-card__img--hover {
    opacity: 0;
    z-index: 2;
    transform: scale(1.04);
  }

  .shoot-card:hover .shoot-card__img--main {
    opacity: 0;
  }

  .shoot-card:hover .shoot-card__img--hover {
    opacity: 1;
    transform: scale(1.08);
  }

  /* --- Tag badge --- */
  .shoot-card__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 4;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.9);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .shoot-card:hover .shoot-card__tag {
    background: rgba(255, 89, 0, 0.75);
    border-color: rgba(255, 89, 0, 0.3);
  }

  /* --- Overlay with gradient + content --- */
  .shoot-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.6rem;
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.25) 40%,
      rgba(0, 0, 0, 0.03) 70%,
      transparent 100%
    );
    color: #ffffff;
  }

  .shoot-card__location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.4rem;
  }

  .shoot-card__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.25;
    margin: 0;
    color: #ffffff;
    transition: color 0.3s ease;
  }

  .shoot-card--wide .shoot-card__title {
    font-size: 1.35rem;
  }

  .shoot-card__desc {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease, margin 0.35s ease;
  }

  .shoot-card:hover .shoot-card__desc {
    max-height: 4rem;
    opacity: 1;
    margin-top: 0.5rem;
  }

  .shoot-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.8rem;
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-accent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease 0.05s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s, gap 0.3s ease;
  }

  .shoot-card:hover .shoot-card__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .shoot-card:hover .shoot-card__cta:hover {
    gap: 0.6rem;
  }

  @media (max-width: 1024px) {
    .shoot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shoot-grid--couple {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .shoot-grid,
    .shoot-grid--couple {
      grid-template-columns: 1fr;
    }
    .shoot-card {
      height: 380px;
    }
    .shoot-card--wide {
      height: 400px;
    }

    /* Show desc on mobile since no hover */
    .shoot-card__desc {
      max-height: 4rem;
      opacity: 1;
      margin-top: 0.4rem;
    }

    .shoot-card__cta {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Centered variant for cat-header ── */
  .cat-header--center {
    text-align: center;
  }

  .cat-header--center .cat-header__desc {
    margin-inline: auto;
  }

  /* ── Testimonials ── */
  .testimonials {
    background: var(--color-surface);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .testimonial {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .testimonial__quote {
    margin: 0;
    padding: 0;
    border: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    font-style: italic;
    flex: 1;
  }

  .testimonial__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .testimonial__rating {
    color: var(--color-text);
    white-space: nowrap;
  }

  .testimonial__rating span {
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  .testimonial__source a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .testimonial__translation {
    margin: 0.8rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .testimonial__footer {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .testimonial__footer strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.15rem;
  }

  .testimonial__footer span {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .testimonial__footer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ═══════════════════════════════════════════
     PRICING SECTION
     ═══════════════════════════════════════════ */

  .pricing {
    background: var(--color-bg);
  }

  .pricing__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.65rem;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .pricing--alt {
    background: var(--color-surface);
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* ── Pricing card ── */
  .pricing-card {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .pricing-card--featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent), var(--shadow-soft);
  }

  .pricing-card__ribbon {
    position: absolute;
    top: -1px;
    right: 1.5rem;
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.35rem 0.8rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }

  .pricing-card__head {
    margin-bottom: 1.5rem;
  }

  .pricing-card__tag {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
  }

  .pricing-card__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }

  .pricing-card__tagline {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .pricing-card__price {
    font-family: var(--font-display);
    font-size: 2.6rem;
