---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site, business } from '../data/site'
import ContactHero from '../components/contact/ContactHero.astro'
import PlanRequest from '../components/contact/PlanRequest.astro'
import DirectStay from '../components/contact/DirectStay.astro'
import ContactHelp from '../components/contact/ContactHelp.astro'

const pageTitle = 'Contact Amalfi.Day: Photoshoots, Tours & Apartments'
const pageDescription =
  'Contact Amalfi.Day by WhatsApp, email or form to plan an Amalfi Coast photoshoot, a private tour, transfers or a stay in Atrani. We reply within 24 hours.'
const shareImage = '/photoshootings/hero/couple/02-slideshow-regan-walk-ravello-love-1024x682.webp'

const whatsappHref = 'https://wa.me/393270972329'
const phoneLabel = '+39 327 097 2329'

const contactJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#webpage`,
    url: `${site.url}/contact/`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'en',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#business` },
    mainEntity: {
      '@id': `${site.url}/#business`,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: business.email,
        url: whatsappHref,
        availableLanguage: ['English', 'Italian'],
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
]
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={shareImage}
  jsonLd={contactJsonLd}
  themeColor="#FF5900"
  themeColorDark="#031E4D"
  bodyClass="contact-page"
  browserChromeColor="var(--contact-hero-bg)"
  hidePrefooter
>
  <ContactHero whatsappHref={whatsappHref} email={business.email} phone={phoneLabel} />
  <PlanRequest whatsappHref={whatsappHref} email={business.email} />
  <DirectStay />
  <ContactHelp />

  <script>
    import { photographyPackages } from '../data/photographer'
    import { initPlan } from '../scripts/contact-plan.mjs'

    const root = document.querySelector<HTMLElement>('[data-plan]')
    if (root) initPlan(root, { packages: Object.values(photographyPackages) })
  </script>
</BaseLayout>

<style>
  /* Overscroll above the hero shows the hero colour, as on the home page. */
  :global(body.contact-page) {
    --contact-hero-bg: #ff5900;
    background-color: var(--contact-hero-bg);
  }

  :global(html[data-theme='night'] body.contact-page) {
    --contact-hero-bg: #031e4d;
  }

  :global(body.contact-page main) {
    background: var(--color-bg);
  }
</style>
