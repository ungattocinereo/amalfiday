---
import { navigation, socialLinks, site } from '../data/site'
import MorphingLogo from './MorphingLogo.astro'
const headerSocials = socialLinks.filter((item) => ['Instagram', 'Facebook'].includes(item.label))
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (href?: string) => href === currentPath
const isWithin = (href?: string) => href && !href.includes('#') && (isCurrent(href) || currentPath.startsWith(`${href}/`))
const isActive = (item: (typeof navigation)[number]) =>
  isWithin(item.href) || item.dropdownSections?.some((section) => section.items.some((link) => isWithin(link.href)))
---

<header class="header" id="header" data-home={currentPath === '/' ? '' : undefined}>
  <div class="glass-bar">
    <span class="glass-bar__edge" aria-hidden="true"></span>
    <a class="brand brand--morph" href="/" aria-label={`${site.name} home`}>
      <MorphingLogo />
    </a>

    <div class="header__center">
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map((item) => item.dropdownSections?.length ? (
          <details class="nav-disclosure" data-desktop-disclosure>
            <summary class:list={['nav-link', 'nav-link--compact', 'nav-link--disclosure', { 'is-active': isActive(item) }]} aria-label={item.label}>
              <span class="nav-link__label" aria-hidden="true">{item.label}</span>
              <i class={`${item.iconWeight === 'fill' ? 'ph-fill' : 'ph'} ${item.icon} nav-link__symbol`} aria-hidden="true"></i>
              <i class="ph ph-caret-down chevron" aria-hidden="true"></i>
              <span class="nav-link__hint" aria-hidden="true">{item.label}</span>
            </summary>
            <div class="nav-reveal">
              <span class="nav-reveal__line" aria-hidden="true"></span>
              <div class="nav-reveal__clip">
                <div class="nav-sheet">
                  <div class="nav-sheet__intro">
                    <span class="eyebrow">Explore the coast</span>
                    <span class="nav-sheet__title">{item.label}</span>
                    {item.href && <a class="overview" href={item.href}>Discover all <i class="ph ph-arrow-right" aria-hidden="true"></i></a>}
                  </div>
                  <div class="nav-sheet__sections">
                    {item.dropdownSections.map((section) => (
                      <div class="nav-section">
                        <span class="eyebrow">{section.heading}</span>
                        {section.items.map((link) => (
                          <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                            <i class={`ph ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span>
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </details>
        ) : (
          <a class:list={['nav-link', 'nav-link--compact', { 'is-active': isActive(item) }]} href={item.href} aria-label={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="nav-link__label" aria-hidden="true">{item.label}</span>
            <i class={`${item.iconWeight === 'fill' ? 'ph-fill' : 'ph'} ${item.icon} nav-link__symbol`} aria-hidden="true"></i>
            <span class="nav-link__hint" aria-hidden="true">{item.label}</span>
          </a>
        ))}
        <a class:list={['nav-link', 'nav-link--compact', 'nav-link--contact', { 'is-active': isCurrent('/contact') }]} href="/contact" aria-label="Contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>
          <span class="nav-link__label" aria-hidden="true">Contact</span>
          <span class="nav-link__symbol nav-link__contact-label" aria-hidden="true">CONTACT</span>
          <span class="nav-link__hint" aria-hidden="true">Contact</span>
        </a>
      </nav>
      <div class="header__connect" aria-label="Social media">
        {headerSocials.map((item) => (
          <a class="icon-link" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.label} (opens in a new tab)`} title={item.label}>
            <i class={`ph-light ph-${item.label.toLowerCase()}-logo`} aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </div>

    <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
      <span class="menu-toggle__label" aria-hidden="true">MENU</span>
    </button>
    <button class="theme-switch" type="button" role="switch" data-theme-toggle aria-label="Dark mode" aria-checked="false" title="Switch to dark theme">
      <span class="theme-switch__track" aria-hidden="true">
        <span class="theme-switch__thumb"></span>
        <i class="ph ph-sun theme-switch__sun" aria-hidden="true"></i>
        <i class="ph ph-moon theme-switch__moon" aria-hidden="true"></i>
      </span>
    </button>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation">
    <div class="mobile-menu__bar">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <img class="brand__day" src="/brand/logo-dark.svg" alt={site.name} width="267" height="63" />
        <img class="brand__night" src="/brand/logo-light.svg" alt="" aria-hidden="true" width="267" height="63" />
      </a>
      <button class="menu-close" type="button" aria-label="Close menu" autofocus>CLOSE</button>
      <button class="theme-switch" type="button" role="switch" data-theme-toggle aria-label="Dark mode" aria-checked="false" title="Switch to dark theme">
        <span class="theme-switch__track" aria-hidden="true">
          <span class="theme-switch__thumb"></span>
          <i class="ph ph-sun theme-switch__sun" aria-hidden="true"></i>
          <i class="ph ph-moon theme-switch__moon" aria-hidden="true"></i>
        </span>
      </button>
    </div>
    <div class="mobile-menu__body">
      <div class="mobile-menu__intro"><span class="eyebrow">Amalfi coast, your way</span><span class="mobile-menu__title">A little closer to paradise.</span></div>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a class="mobile-nav__link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="nav-number" aria-hidden="true">01</span><span>Home</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        {navigation.map((item, index) => item.dropdownSections?.length ? (
          <details class="mobile-disclosure">
            <summary class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="ph ph-plus" aria-hidden="true"></i></summary>
            <div class="mobile-subnav">
              {item.href && <a class="overview" href={item.href}>Discover all {item.label.toLowerCase()} <i class="ph ph-arrow-right" aria-hidden="true"></i></a>}
              {item.dropdownSections.map((section) => (
                <div class="nav-section">
                  <span class="eyebrow">{section.heading}</span>
                  {section.items.map((link) => <a class="sub-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><i class={`ph ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span></a>)}
                </div>
              ))}
            </div>
          </details>
        ) : (
          <a class="mobile-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span class="nav-number" aria-hidden="true">0{index + 2}</span><span>{item.label}</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        ))}
      </nav>
      <div class="mobile-connect">
        <a class="mobile-contact" href="/contact"><span>Let’s plan your day</span><span>Get in touch <i class="ph ph-arrow-square-out" aria-hidden="true"></i></span></a>
        <div class="mobile-socials">
          {headerSocials.map((item) => <a href={item.href} target="_blank" rel="noreferrer"><i class={`ph-light ph-${item.label.toLowerCase()}-logo`} aria-hidden="true"></i>{item.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
        </div>
      </div>
    </div>
  </dialog>
</header>

<script is:inline>
  ;(() => {
    const root = document.documentElement
    const header = document.getElementById('header')
    const themeButtons = header.querySelectorAll('[data-theme-toggle]')
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
    let storedTheme
    try { storedTheme = localStorage.getItem('theme') } catch {}
    let followSystem = storedTheme !== 'day' && storedTheme !== 'night'
    const setTheme = (theme) => {
      root.dataset.theme = theme
      window.__setBrowserThemeColor?.(theme)
      themeButtons.forEach((button) => {
        const label = `Switch to ${theme === 'night' ? 'light' : 'dark'} theme`
        button.setAttribute('aria-checked', String(theme === 'night'))
        button.title = label
      })
    }
    setTheme(root.dataset.theme || (systemTheme.matches ? 'night' : 'day'))
    themeButtons.forEach((button) => button.addEventListener('click', () => {
      followSystem = false
      const theme = root.dataset.theme === 'night' ? 'day' : 'night'
      setTheme(theme)
      try { localStorage.setItem('theme', theme) } catch {}
    }))
    systemTheme.addEventListener('change', (event) => {
      if (followSystem) setTheme(event.matches ? 'night' : 'day')
    })

    const desktop = window.matchMedia('(min-width: 1100px)')
    const hoverNavigation = window.matchMedia('(min-width: 1100px) and (hover: hover) and (pointer: fine)')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const disclosures = [...header.querySelectorAll('[data-desktop-disclosure]')]
    const disclosureTimers = new Map()
    const clearDisclosureTimer = (details) => {
      clearTimeout(disclosureTimers.get(details))
      disclosureTimers.delete(details)
    }
    const closeDisclosure = (details, immediately = false) => {
      clearDisclosureTimer(details)
      details.classList.remove('is-visible')
      if (!details.open) return
      if (immediately || reducedMotion.matches) { details.open = false; return }
      disclosureTimers.set(details, setTimeout(() => {
        details.open = false
        disclosureTimers.delete(details)
      }, 360))
    }
    const closeDisclosures = (except) => disclosures.forEach((details) => {
      if (details !== except) closeDisclosure(details, true)
    })
    const positionDisclosure = (details) => {
      const summaryBounds = details.querySelector('summary').getBoundingClientRect()
      const barBounds = bar.getBoundingClientRect()
      const revealBounds = details.querySelector('.nav-reveal').getBoundingClientRect()
      // The expanded line stays at the trigger's underline and becomes the panel's top edge.
      details.style.setProperty('--nav-reveal-top', `${summaryBounds.bottom - barBounds.top - 3}px`)
      const origin = (summaryBounds.left + summaryBounds.width / 2 - revealBounds.left) / revealBounds.width
      details.style.setProperty('--nav-reveal-origin', `${Math.max(0, Math.min(1, origin)) * 100}%`)
    }
    const openDisclosure = (details) => {
      clearDisclosureTimer(details)
      closeDisclosures(details)
      if (details.open && details.classList.contains('is-visible')) return
      details.open = true
      positionDisclosure(details)
      // Commit the retracted panel before expanding the line, then sliding the panel down.
      details.querySelector('.nav-sheet').getBoundingClientRect()
      details.classList.add('is-visible')
    }
    disclosures.forEach((details) => {
      const summary = details.querySelector('summary')
      const sheet = details.querySelector('.nav-sheet')
      details.classList.add('is-enhanced')
      details.addEventListener('pointerenter', (event) => {
        if (hoverNavigation.matches && event.pointerType !== 'touch') openDisclosure(details)
      })
      details.addEventListener('pointerleave', () => {
        if (!hoverNavigation.matches || sheet.contains(document.activeElement)) return
        clearDisclosureTimer(details)
        // Allow the pointer to cross the gap between the bar and the panel.
        disclosureTimers.set(details, setTimeout(() => closeDisclosure(details), 180))
      })
      summary.addEventListener('click', (event) => {
        event.preventDefault()
        if (hoverNavigation.matches && event.detail > 0 && event.pointerType !== 'touch') {
          openDisclosure(details)
          return
        }
        if (details.classList.contains('is-visible')) closeDisclosure(details)
        else openDisclosure(details)
      })
      summary.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return
        event.preventDefault()
        openDisclosure(details)
        sheet.querySelector('a')?.focus({ preventScroll: true })
      })
      details.addEventListener('focusout', (event) => {
        if (!details.contains(event.relatedTarget) && !details.matches(':hover')) closeDisclosure(details)
      })
    })
    document.addEventListener('click', (event) => {
      if (!disclosures.some((details) => details.contains(event.target))) closeDisclosures()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      const opened = disclosures.find((details) => details.open)
      if (opened) {
        opened.querySelector('summary').focus()
        closeDisclosures()
      }
    })

    const menu = header.querySelector('#mobile-menu')
    const menuToggle = header.querySelector('.menu-toggle')
    let previousOverflow = ''
    let menuState = 'closed'
    let menuFrame = 0
    let closeTimer
    const finishClose = () => {
      cancelAnimationFrame(menuFrame)
      clearTimeout(closeTimer)
      if (menu.open) menu.close()
    }
    const closeMenu = (immediately = false) => {
      if (!menu.open) return
      if (immediately || reducedMotion.matches) { finishClose(); return }
      if (menuState === 'closing') return
      cancelAnimationFrame(menuFrame)
      const wasVisible = menu.classList.contains('is-visible')
      menuState = 'closing'
      menu.classList.add('is-closing')
      menu.classList.remove('is-visible')
      if (!wasVisible) { finishClose(); return }
      // Keep the native focus trap until the panel has faded out.
      closeTimer = setTimeout(finishClose, 300)
    }
    menuToggle.addEventListener('click', () => {
      if (menu.open || menuState !== 'closed') return
      cancelAnimationFrame(menuFrame)
      clearTimeout(closeTimer)
      closeDisclosures()
      previousOverflow = document.body.style.overflow
      menuState = 'opening'
      menu.classList.remove('is-visible', 'is-closing')
      menu.showModal()
      menu.querySelector('.mobile-menu__body').scrollTop = 0
      document.body.style.overflow = 'hidden'
      menuToggle.setAttribute('aria-expanded', 'true')
      // Commit the starting pose before transitioning into the open state.
      menu.getBoundingClientRect()
      if (reducedMotion.matches) { menu.classList.add('is-visible'); menuState = 'open' }
      else menuFrame = requestAnimationFrame(() => {
        if (menu.open && menuState === 'opening') menu.classList.add('is-visible')
      })
    })
    menu.querySelector('.menu-close').addEventListener('click', () => closeMenu())
    menu.addEventListener('cancel', (event) => {
      event.preventDefault()
      closeMenu()
    })
    menu.addEventListener('transitionend', (event) => {
      if (event.target !== menu || event.propertyName !== 'opacity') return
      if (menuState === 'closing') finishClose()
      else if (menuState === 'opening') menuState = 'open'
    })
    menu.addEventListener('click', (event) => {
      if (event.target.closest('a')) { closeMenu(true); return }
      if (event.target !== menu) return
      const bounds = menu.getBoundingClientRect()
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closeMenu()
    })
    menu.addEventListener('close', () => {
      cancelAnimationFrame(menuFrame)
      clearTimeout(closeTimer)
      menuState = 'closed'
      menu.classList.remove('is-visible', 'is-closing')
      document.body.style.overflow = previousOverflow
      menuToggle.setAttribute('aria-expanded', 'false')
      menu.querySelectorAll('details').forEach((details) => { details.open = false })
      if (desktop.matches) header.querySelector('.brand').focus({ preventScroll: true })
      else menuToggle.focus({ preventScroll: true })
    })
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches || !menu.open) return
      if (menuState === 'closing') finishClose()
      else { menu.classList.add('is-visible'); menuState = 'open' }
    })
    desktop.addEventListener('change', () => {
      closeDisclosures()
      if (menu.open) closeMenu(true)
    })
    hoverNavigation.addEventListener('change', () => closeDisclosures())
    // Read the sections behind the fixed bar, ignoring the navigation itself.
    // Photo heroes declare their dark treatment. All other sections use their
    // computed background to choose light or dark navigation lettering.
    const bar = header.querySelector('.glass-bar')
    // Use the final control sizes so the capsule does not chase animated widths.
    const measureCompactWidth = () => {
      if (!desktop.matches) return
      const style = getComputedStyle(header)
      const size = (property) => parseFloat(style.getPropertyValue(property))
      const linkSize = size('--compact-link-size')
      const disclosureSize = size('--compact-disclosure-size')
      const contactSize = size('--compact-contact-size')
      const links = [...bar.querySelector('.desktop-nav').children]
      const socials = [...bar.querySelector('.header__connect').children]
      const linksWidth = links.reduce((width, item) => {
        if (item.matches('.nav-disclosure')) return width + disclosureSize
        if (item.matches('.nav-link--contact')) return width + contactSize
        return width + linkSize
      }, 0)
      const centerWidth = linksWidth + Math.max(0, links.length - 1) * size('--compact-nav-gap')
        + size('--compact-group-gap') + socials.length * linkSize + Math.max(0, socials.length - 1) * size('--compact-nav-gap')
      header.style.setProperty('--compact-center-width', `${centerWidth}px`)
    }
    measureCompactWidth()
    desktop.addEventListener('change', measureCompactWidth)
    const parseColor = (value) => {
      const channels = value.match(/[\d.]+/g)?.map(Number)
      return value.startsWith('rgb') && channels?.length >= 3
        ? [...channels.slice(0, 3), channels[3] ?? 1]
        : [0, 0, 0, 0]
    }
    const over = (front, back) => [
      ...front.slice(0, 3).map((channel, index) => channel * front[3] + back[index] * (1 - front[3])),
      1,
    ]
    const luminance = (color) => color.slice(0, 3).reduce((total, channel, index) => {
      const value = channel / 255
      const linear = value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4
      return total + linear * [0.2126, 0.7152, 0.0722][index]
    }, 0)
    const sectionTone = (section) => {
      const declared = section.closest('[data-nav-surface]')?.dataset.navSurface
      if (declared === 'dark' || declared === 'light') return declared
      if (section.closest('.hero--dark')) return 'dark'
      const layers = []
      for (let element = section; element; element = element.parentElement) {
        const style = getComputedStyle(element)
        let color = parseColor(style.backgroundColor)
        // Gradients in the site's sections use sRGB colors. Their average gives
        // a stable section tone instead of flickering as small details pass by.
        if (style.backgroundImage.includes('gradient(') && !style.backgroundImage.includes('url(')) {
          const stops = [...style.backgroundImage.matchAll(/rgba?\([^)]+\)/g)].map((match) => parseColor(match[0]))
          if (stops.length) {
            const average = [0, 1, 2, 3].map((index) => stops.reduce((sum, stop) => sum + stop[index], 0) / stops.length)
            // Preserve transparency so the ancestors still contribute.
            const alpha = average[3] + color[3] * (1 - average[3])
            if (alpha) color = [...average.slice(0, 3).map((v, i) => (v * average[3] + color[i] * color[3] * (1 - average[3])) / alpha), alpha]
          }
        }
        layers.push(color)
        if (color[3] >= 1) break
      }
      const fallback = root.dataset.theme === 'night' ? [15, 17, 21, 1] : [255, 255, 255, 1]
      const background = layers.reverse().reduce((back, front) => over(front, back), fallback)
      return luminance(background) < 0.18 ? 'dark' : 'light'
    }
    let scheduled = false
    const updateSurface = () => {
      scheduled = false
      if (menu.open) return
      // Separate enter/exit thresholds keep the morph steady near the top.
      const scrolled = window.scrollY > (header.classList.contains('is-scrolled') ? 16 : 48)
      header.classList.toggle('is-scrolled', scrolled)
      const bounds = bar.getBoundingClientRect()
      disclosures.filter((details) => details.open).forEach(positionDisclosure)
      const y = Math.min(bounds.top + bounds.height / 2, window.innerHeight - 1)
      const tones = [0.12, 0.5, 0.88].map((position) => {
        const underneath = document.elementsFromPoint(bounds.left + bounds.width * position, y)
          .find((element) => !header.contains(element) && element.closest('main, footer, .prefooter'))
        const section = underneath?.closest('section, footer, article, main') || document.body
        return sectionTone(section)
      })
      const surface = (!scrolled && header.hasAttribute('data-home')) || tones.filter((tone) => tone === 'dark').length >= 2 ? 'dark' : 'light'
      if (bar.dataset.surface !== surface) {
        bar.dataset.surface = surface
        header.dataset.surface = surface
      }
    }
    const scheduleSurface = () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(updateSurface)
    }
    window.addEventListener('scroll', scheduleSurface, { passive: true })
    window.addEventListener('resize', () => { measureCompactWidth(); scheduleSurface() }, { passive: true })
    bar.addEventListener('transitionend', (event) => {
      if (event.target === bar && event.propertyName === 'width') scheduleSurface()
    })
    window.addEventListener('pageshow', scheduleSurface)
    window.addEventListener('load', scheduleSurface, { once: true })
    menu.addEventListener('close', scheduleSurface)
    let themeSettleTimer
    new MutationObserver(() => {
      scheduleSurface()
      clearTimeout(themeSettleTimer)
      themeSettleTimer = setTimeout(scheduleSurface, 350)
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] })
    const initSurface = () => {
      measureCompactWidth()
      updateSurface()
      requestAnimationFrame(() => { header.dataset.surfaceReady = '' })
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSurface, { once: true })
    else initSurface()
  })()
</script>

<style>
  /* Panels follow the chosen theme. The bar independently follows the page below. */
  .header, .nav-sheet, .mobile-menu {
    --glass-solid: #ffffff;
    --glass-line: rgba(20, 20, 20, 0.12);
    --glass-ink: #141414;
    --glass-muted: #626262;
    --glass-hover: rgba(255, 89, 0, 0.09);
    --glass-accent: #FF5900;
    --day-logo: block;
    --night-logo: none;
  }
  :global([data-theme='night']) :is(.header, .nav-sheet, .mobile-menu) {
    --glass-solid: #111417;
    --glass-line: rgba(255, 255, 255, 0.15);
    --glass-ink: #ffffff;
    --glass-muted: #b8b8b8;
    --glass-hover: rgba(255, 89, 0, 0.13);
    --day-logo: none;
    --night-logo: block;
  }
  .header {
    --nav-background: rgba(255, 255, 255, 0.23);
    --nav-sheen: rgba(255, 255, 255, 0.28);
    --nav-glint: rgba(255, 255, 255, 0.85);
    --morph-duration: 440ms;
    --morph-ease: cubic-bezier(0.33, 1, 0.68, 1);
    --compact-link-size: 44px;
    --compact-disclosure-size: 64px;
    --compact-contact-size: 76px;
    --compact-nav-gap: 4px;
    --compact-group-gap: 25px;
    --compact-center-width: 377px;
    position: fixed;
    z-index: 30;
    top: 0;
    inset-inline: 0;
    padding: 0 max(var(--page-gutter), env(safe-area-inset-right)) 0 max(var(--page-gutter), env(safe-area-inset-left));
    color: var(--glass-ink);
    transition: padding-top var(--morph-duration) var(--morph-ease);
  }
  .header[data-surface='dark'] {
    --nav-background: rgba(13, 16, 19, 0.26);
    --nav-sheen: rgba(255, 255, 255, 0.1);
    --nav-glint: rgba(255, 255, 255, 0.62);
  }
  .header.is-scrolled { padding-top: max(12px, env(safe-area-inset-top)); }
  .glass-bar {
    width: 100%;
    max-width: min(100%, var(--content-max));
    margin-inline: auto;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    min-height: 88px;
    padding: 16px 0;
    padding-top: max(16px, env(safe-area-inset-top));
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: blur(0) saturate(100%);
    backdrop-filter: blur(0) saturate(100%);
    color: var(--glass-ink);
    isolation: isolate;
